<!-- Planification, maintenance et pannes: shown in the main window of SPIGA
     Suivi Production (Maintenance > Planification) and, in kiosk mode, in
     PlanningWindow. It was PlanningWindow's content until v1.5.26. -->
<UserControl x:Class="SpigaDashboards.App.PlanningView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:planning="clr-namespace:SpigaDashboards.App.Views.Planning"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Main screen only (not the TV). PlanningViewModel; each tab is its own
         view (Views/Planning). -->
    <UserControl.Resources>
        <Style x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="18,9" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Grid.RowSpan="2" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="0,0,0,1" Padding="22,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,28,0">
                                    <!-- Hidden in the main window: its menu already shows the logo. -->
                                    <Image Source="/Assets/spiga-logo.png" Height="34" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"
                                           Visibility="{Binding ShowLogo, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="Planification" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource BarButton}" Click="CloseButton_Click"/>
                                <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                                    <TabPanel IsItemsHost="True"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <!-- The name lets UI Automation (screen readers, test drivers) reach the tab's content. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="24,18,24,16"/>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="Pannes à qualifier" Style="{StaticResource TabHeader}">
                <planning:PannesView DataContext="{Binding Pannes}"/>
            </TabItem>
            <TabItem Header="Statistiques" Style="{StaticResource TabHeader}">
                <planning:StatsView DataContext="{Binding Stats}"/>
            </TabItem>
            <TabItem Header="Planification" Style="{StaticResource TabHeader}">
                <planning:BoardView DataContext="{Binding Board}"/>
            </TabItem>
        </TabControl>

        <!-- Could not open (tables, connection) -->
        <Border Grid.Row="1" Background="{DynamicResource DisconnectedOverlayBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoadError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LoadError}" FontSize="16" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
        </Border>
    </Grid>
</UserControl>
