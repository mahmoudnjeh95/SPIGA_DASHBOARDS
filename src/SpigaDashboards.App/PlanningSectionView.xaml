<!-- One page of the stop follow-up, shown beside the menu of SPIGA Suivi
     Production: Qualification des arrêts (PannesView), Statistiques des
     arrêts (StatsView) or Planification des arrêts (BoardView). Each has its
     own entry in the menu (Maintenance); the three share one
     PlanningViewModel, so "Qualifier →" and "Planifier un préventif" go from
     one page to another. Until v2.0 they were three tabs of PlanningView. -->
<UserControl x:Class="SpigaDashboards.App.PlanningSectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="22,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource BarButton}" Click="CloseButton_Click"/>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </DockPanel>
        </Border>

        <!-- The name lets UI Automation (screen readers, test drivers) reach the page's content. -->
        <ContentPresenter x:Name="SectionHost" Grid.Row="1" Margin="24,18,24,16"/>

        <!-- Could not open (tables, connection) -->
        <Border Grid.Row="1" Background="{DynamicResource DisconnectedOverlayBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoadError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LoadError}" FontSize="16" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
        </Border>
    </Grid>
</UserControl>
