<UserControl x:Class="SpigaDashboards.App.Views.Planning.PannesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views"
             xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels.Planning">

    <!-- Pannes tab (PannesViewModel): the stops the counter detected, newest
         first; pick one, give it a cause, save; the next one comes up. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PlanningStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title, filters, declare -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,24,0">
                <TextBlock Text="PANNES &amp; ARRÊTS" Style="{StaticResource Eyebrow}" Foreground="#E66767"/>
                <TextBlock Text="Qualifier les arrêts" Style="{StaticResource H1}" Margin="0,2,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Les arrêts sont détectés par le compteur de chaque ligne : la durée est déjà exacte, il ne reste qu'à donner la cause."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Style="{StaticResource SegTrack}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="PannesPeriod" Content="Aujourd'hui" Style="{StaticResource Seg}"
                                     IsChecked="{Binding PeriodKey, Converter={StaticResource ValueToBool}, ConverterParameter=0}"/>
                        <RadioButton GroupName="PannesPeriod" Content="7 jours" Style="{StaticResource Seg}"
                                     IsChecked="{Binding PeriodKey, Converter={StaticResource ValueToBool}, ConverterParameter=1}"/>
                        <RadioButton GroupName="PannesPeriod" Content="30 jours" Style="{StaticResource Seg}"
                                     IsChecked="{Binding PeriodKey, Converter={StaticResource ValueToBool}, ConverterParameter=2}"/>
                    </StackPanel>
                </Border>
                <ComboBox Style="{StaticResource DarkComboBox}" Width="190" Margin="10,0,0,0" FontSize="14" VerticalContentAlignment="Center"
                          ItemsSource="{Binding MachineOptions}" SelectedItem="{Binding SelectedMachine}"/>
                <CheckBox Content="Seulement sans cause" IsChecked="{Binding OnlyUnqualified}" Margin="14,0,0,0" VerticalAlignment="Center"
                          FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Actualiser" Style="{StaticResource BarButton}" Margin="14,0,0,0" Command="{Binding RefreshCommand}"/>
                <Button Content="+ Déclarer une panne" Style="{StaticResource AccentBarButton}" Margin="8,0,0,0" Command="{Binding StartManualCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Banner: what is left to qualify -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="#29D03B3B" VerticalAlignment="Center">
                    <Path Width="22" Height="22" Stretch="Uniform" Stroke="#E66767" StrokeThickness="2"
                          Data="M12,2 A10,10 0 1 1 11.99,2 Z M12,6 L12,12 L16,14"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BannerTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding BannerDetail}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding QualificationRate, StringFormat={}{0:0} %}"/>
                        <TextBlock Text="Arrêts qualifiés sur la période" Style="{StaticResource Small}"/>
                    </DockPanel>
                    <Grid Height="8" Margin="0,8,0,0">
                        <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="4"/>
                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding QualificationRatio}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Detected stops -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="18,14,18,10">
                            <TextBlock DockPanel.Dock="Right" Text="plus récent en premier" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                            <TextBlock Text="Arrêts détectés" Style="{StaticResource H2}"/>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardBorderBrush}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StopRow}">
                                        <Button Style="{StaticResource Bare}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                            <Border x:Name="Row" Padding="15,12" BorderThickness="3,0,0,0" BorderBrush="Transparent" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Pill}" CornerRadius="8" Padding="8,5" MinWidth="58">
                                                        <TextBlock Text="{Binding MachineId}" Style="{StaticResource Mono}" FontSize="13" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}">
                                                            <Run Text="{Binding DayText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FromText, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding ToText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding CauseBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CauseLabel}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                            <TextBlock Text="  ·  " Style="{StaticResource Small}"/>
                                                            <TextBlock Text="{Binding PosteText}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding DurationText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                                                            <Ellipse Style="{StaticResource LiveDot}" Width="7" Height="7" Fill="#E66767" Margin="0,0,5,0"/>
                                                            <TextBlock Text="EN COURS" FontSize="11" FontWeight="Bold" Foreground="#E66767"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Recently qualified -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" MaxHeight="230">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Qualifiés récemment" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StopRow}">
                                        <Button Style="{StaticResource Bare}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MachineId}" Style="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding CauseBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding CauseLabel}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Qualification form -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Text="Choisissez un arrêt dans la liste, ou déclarez une panne." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="22,20">
                            <!-- Header -->
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#1F2ECC71" CornerRadius="12" Padding="10,5" VerticalAlignment="Top"
                                        Visibility="{Binding IsManualMode, Converter={StaticResource InverseBoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M0,5 L4,9 L12,0" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" Width="12" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Durée mesurée par le compteur" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding FormSubtitle}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Where the stop sits in its poste -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsManualMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <Grid Height="26">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"/>
                                    <views:TimelinePanel ClipToBounds="True">
                                        <Border views:TimelinePanel.Start="{Binding PosteStartFrac}" views:TimelinePanel.End="{Binding PosteEndFrac}"
                                                Background="{StaticResource PanneBrush}" CornerRadius="3" MinWidth="4"/>
                                    </views:TimelinePanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PosteTicks}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Cascadia Mono, Consolas"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Le poste en entier, et cet arrêt en rouge" Style="{StaticResource Small}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Manual declaration -->
                            <Grid Margin="0,16,0,0" Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ligne" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource DarkComboBox}" Height="40" FontSize="14" ItemsSource="{Binding MachineOptions}" SelectedItem="{Binding ManualMachine}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding ManualDate}" Height="40" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="De (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding ManualFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Heure de début"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="À (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding ManualTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Heure de fin"/>
                                </StackPanel>
                            </Grid>

                            <!-- Causes -->
                            <TextBlock Text="Cause de l'arrêt" Style="{StaticResource H2}" FontSize="14" Margin="0,20,0,10"/>
                            <ItemsControl ItemsSource="{Binding CauseGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CauseOptionGroup}">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="116"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Top" Margin="0,11,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Color}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Small}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" FontSize="11" Margin="17,2,0,0"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Causes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CauseOption}">
                                                        <Button Style="{StaticResource CauseChip}" Content="{Binding Label}" Command="{Binding Pick}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Component / technician -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Composant" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding Component, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Composant"/>
                                    <ItemsControl ItemsSource="{Binding ComponentSuggestions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SuggestChip}" Content="{Binding}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.PickComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Intervenant" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding Technician, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Intervenant"/>
                                    <ItemsControl ItemsSource="{Binding TechnicianSuggestions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SuggestChip}" Content="{Binding}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.PickTechnicianCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Description et action réalisée" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" MinHeight="74"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8"/>

                            <!-- Repeat failure -->
                            <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="12" Background="#1AFAB219" BorderBrush="#66FAB219" BorderThickness="1"
                                    Visibility="{Binding HasRepeatWarning, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Planifier un préventif" Style="{StaticResource BarButton}" Background="#FAB219"
                                            Foreground="#1A1406" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding PlanPreventiveCommand}"/>
                                    <TextBlock Text="{Binding RepeatWarning}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </DockPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,18,0,14"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentBarButton}" Padding="22,11" FontSize="14"
                                        Content="{Binding SaveText}" Command="{Binding SaveCommand}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Retirer la cause" Style="{StaticResource BarButton}" Command="{Binding DeleteCommand}"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="Annuler" Style="{StaticResource BarButton}" Command="{Binding CancelFormCommand}"
                                            Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="2,10,0,0"/>
    </Grid>
</UserControl>
