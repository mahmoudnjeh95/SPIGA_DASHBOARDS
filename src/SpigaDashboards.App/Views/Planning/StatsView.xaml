<UserControl x:Class="SpigaDashboards.App.Views.Planning.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views"
             xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels.Planning">

    <!-- Statistiques tab (StatsViewModel). The charts are ChartCards (kind,
         parameters on / off, enlarged view with zoom); every mark has a
         tooltip with its figures. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PlanningStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ItemsPanelTemplate x:Key="OneRow">
                <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <!-- Header. The filters wrap onto a second line on a narrower
                 screen (beside the menu of SPIGA Suivi Production). -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,24,0" Width="290">
                    <TextBlock Text="STATISTIQUES" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Statistiques des arrêts" Style="{StaticResource H1}" Margin="0,2,0,0"/>
                    <TextBlock Text="Calculé sur les arrêts qualifiés (onglet Pannes)." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Border Style="{StaticResource SegTrack}" Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="StatsPeriod" Content="Aujourd'hui" Style="{StaticResource Seg}"
                                         IsChecked="{Binding PeriodKey, Converter={StaticResource ValueToBool}, ConverterParameter=1}"/>
                            <RadioButton GroupName="StatsPeriod" Content="7 jours" Style="{StaticResource Seg}"
                                         IsChecked="{Binding PeriodKey, Converter={StaticResource ValueToBool}, ConverterParameter=7}"/>
                            <RadioButton GroupName="StatsPeriod" Content="30 jours" Style="{StaticResource Seg}"
                                         IsChecked="{Binding PeriodKey, Converter={StaticResource ValueToBool}, ConverterParameter=30}"/>
                            <RadioButton GroupName="StatsPeriod" Content="90 jours" Style="{StaticResource Seg}"
                                         IsChecked="{Binding PeriodKey, Converter={StaticResource ValueToBool}, ConverterParameter=90}"/>
                        </StackPanel>
                    </Border>
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="170" Margin="10,4,0,4" FontSize="14" VerticalContentAlignment="Center"
                              ItemsSource="{Binding MachineOptions}" SelectedItem="{Binding SelectedMachine}" AutomationProperties.Name="Ligne"/>
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="170" Margin="8,4,0,4" FontSize="14" VerticalContentAlignment="Center"
                              ItemsSource="{Binding TeamOptions}" SelectedItem="{Binding SelectedTeam}" AutomationProperties.Name="Équipe"/>
                    <CheckBox Content="Pannes seulement" IsChecked="{Binding PannesOnly}" Margin="14,4,0,4" VerticalAlignment="Center"
                              FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                              ToolTip="Coché : seulement les pannes (mécanique, électrique, pneumatique). Décoché : tous les arrêts qualifiés."/>
                    <Button Content="Actualiser" Style="{StaticResource BarButton}" Margin="14,4,0,4" Command="{Binding RefreshCommand}"/>
                </WrapPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>

            <!-- Stops still without a cause: not counted here -->
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12" Background="#14FAB219" BorderBrush="#66FAB219"
                    Visibility="{Binding HasUnqualified, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Qualifier →" Style="{StaticResource BarButton}" Background="#FAB219" Foreground="#1A1406"
                            Margin="12,0,0,0" Command="{Binding GoQualifyCommand}"/>
                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="#FAB219" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UnqualifiedText}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </DockPanel>
            </Border>

            <!-- KPI tiles -->
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="-7,0,-7,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StatTile}">
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource BigValue}" Margin="0,6,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Delta}" FontSize="12" FontWeight="Bold" Foreground="{Binding DeltaBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pareto: component / cause -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pareto par composant" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding ParetoCaption}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                        <views:ChartCard Plain="True" Title="Pareto par composant" Chart="{Binding ComponentChart}" Height="320"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Par cause" Style="{StaticResource H2}"/>
                        <TextBlock Text="Temps d'arrêt par type de cause" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                        <views:ChartCard Plain="True" Title="Arrêts par cause" Chart="{Binding CauseChart}" Height="320"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- By line / by poste and team -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Temps d'arrêt par ligne" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding MachineCaption}" Style="{StaticResource Caption}" Margin="0,2,0,12"/>
                        </StackPanel>
                        <views:ChartCard Plain="True" Title="Temps d'arrêt par ligne" Chart="{Binding MachineChart}" Height="280"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Par poste et par équipe" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding GroupCaption}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                        <TextBlock Text="POSTE" Style="{StaticResource Small}" FontSize="11" FontWeight="Bold" Margin="0,4,0,2"/>
                        <views:ChartCard Plain="True" Title="Arrêts par poste" Chart="{Binding PosteChart}" Height="190"/>
                        <TextBlock Text="ÉQUIPE" Style="{StaticResource Small}" FontSize="11" FontWeight="Bold" Margin="0,12,0,2"/>
                        <views:ChartCard Plain="True" Title="Arrêts par équipe" Chart="{Binding TeamChart}" Height="190"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Heatmap -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="moins" Style="{StaticResource Small}" Margin="0,0,6,0"/>
                            <ItemsControl ItemsSource="{Binding HeatScale}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="12" CornerRadius="3" Background="{Binding}" Margin="0,0,3,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="plus" Style="{StaticResource Small}" Margin="3,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Quand les arrêts commencent" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding HeatCaption}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding HeatHours}" ItemsPanel="{StaticResource OneRow}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Heat}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HeatRow}">
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Day}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource OneRow}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HeatCell}">
                                                <Border Height="28" Margin="1.5,0" CornerRadius="4" Background="{Binding Fill}" ToolTip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold" Foreground="{Binding Ink}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="56,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="8*"/>
                            <ColumnDefinition Width="8*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,0" Margin="2,0">
                            <TextBlock Text="Nuit (fin)" Style="{StaticResource Small}" FontSize="11" Margin="0,3,0,0"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,0" Margin="2,0">
                            <TextBlock Text="Matin 06–14" Style="{StaticResource Small}" FontSize="11" Margin="0,3,0,0"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,0" Margin="2,0">
                            <TextBlock Text="Après-midi 14–22" Style="{StaticResource Small}" FontSize="11" Margin="0,3,0,0"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,0" Margin="2,0">
                            <TextBlock Text="Nuit" Style="{StaticResource Small}" FontSize="11" Margin="0,3,0,0"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Trend / repeat failures -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Tendance sur 12 semaines" Style="{StaticResource H2}"/>
                            <TextBlock Text="Temps d'arrêt par semaine (la dernière est en cours)" Style="{StaticResource Caption}" Margin="0,2,0,12"/>
                        </StackPanel>
                        <views:ChartCard Plain="True" Title="Tendance des arrêts sur 12 semaines" Chart="{Binding WeekChart}" Height="240"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pannes répétitives" Style="{StaticResource H2}"/>
                        <TextBlock Text="Même composant, même ligne, au moins 3 fois sur la période" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                        <TextBlock Text="Aucune panne ne se répète sur la période." Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Visibility="{Binding HasRepeats, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding Repeats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RepeatRow}">
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}">
                                                    <Run Text="{Binding MachineName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Component, Mode=OneWay}"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ItemsControl ItemsSource="{Binding Dots}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Ellipse Width="9" Height="9" Fill="#E66767" Margin="0,0,3,0"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Style="{StaticResource Small}" Margin="6,0,0,0">
                                                        <Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" fois · "/><Run Text="{Binding Lost, Mode=OneWay}"/><Run Text=" perdues · une tous les "/><Run Text="{Binding Mtbf, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding PlanBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding PlanText}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Planifier un préventif" Style="{StaticResource BarButton}" Command="{Binding Plan}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    <!-- Loading motion while the statistics are computed -->
    <views:PastaLoader IsActive="{Binding IsBusy}" Text="Calcul des statistiques…"/>
    </Grid>
</UserControl>
