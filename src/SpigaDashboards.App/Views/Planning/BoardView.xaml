<UserControl x:Class="SpigaDashboards.App.Views.Planning.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views"
             xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels.Planning"
             x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown"
             PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown" PreviewMouseMove="Root_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp" LostMouseCapture="Root_LostMouseCapture">

    <!-- Planification tab (BoardViewModel): the day, week or month of every
         line, with orders (and their real progress), maintenance and pannes;
         a click or drag on an empty part of a line picks a slot to plan in.
         The side panel shows what is selected, or the form being filled. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PlanningStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ItemsPanelTemplate x:Key="OneRow">
                <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>

            <!-- Columns behind a line: column separators, tick lines (hours or postes), today tinted. -->
            <DataTemplate x:Key="DayColumn" DataType="{x:Type vm:ColumnHeader}">
                <Border x:Name="Day" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
                    <ItemsControl ItemsSource="{Binding Ticks}" ItemsPanel="{StaticResource OneRow}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColumnTick}">
                                <Border x:Name="Tick" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                        <Setter TargetName="Tick" Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                        <Setter TargetName="Day" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- One block on the board -->
            <DataTemplate x:Key="Block" DataType="{x:Type vm:BoardBlock}">
                <!-- Planned slots can be dragged (BoardView.xaml.cs): the middle moves it, an edge moves its start / end. -->
                <Button x:Name="Btn" Style="{StaticResource Bare}" Command="{Binding Select}" ToolTip="{Binding Tooltip}" Margin="1,5"
                        VerticalContentAlignment="Stretch"
                        AutomationProperties.Name="{Binding Tooltip}">
                    <Grid>
                        <Rectangle x:Name="Shape" RadiusX="7" RadiusY="7" Fill="{Binding Fill}" Stroke="{Binding Stroke}" StrokeThickness="1"/>
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource StopInk}" Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Margin="8,0" VerticalAlignment="Center" Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="L1" Text="{Binding Label}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="L2" Text="{Binding Sub}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.85"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <!-- Real progress from the counter -->
                        <Grid VerticalAlignment="Bottom" Height="4" Margin="1,0,1,1" ClipToBounds="True"
                              Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="{Binding Stroke}" RenderTransformOrigin="0,0.5" CornerRadius="0,0,6,6">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <Rectangle x:Name="Ring" RadiusX="9" RadiusY="9" Margin="-3" StrokeThickness="2" Visibility="Collapsed"
                                   Stroke="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:BlockKind.Maintenance}">
                        <Setter TargetName="Shape" Property="Fill" Value="{StaticResource MaintStripes}"/>
                        <Setter TargetName="Shape" Property="Stroke" Value="#FAB219"/>
                        <Setter TargetName="L1" Property="Foreground" Value="{StaticResource MaintInk}"/>
                        <Setter TargetName="L2" Property="Foreground" Value="{StaticResource MaintInk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:BlockKind.MaintenanceDone}">
                        <Setter TargetName="Shape" Property="Fill" Value="{StaticResource MaintDoneStripes}"/>
                        <Setter TargetName="Shape" Property="Stroke" Value="#80FAB219"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:BlockKind.MaintenanceLate}">
                        <Setter TargetName="Shape" Property="Fill" Value="{StaticResource LateFill}"/>
                        <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource LateStroke}"/>
                        <Setter TargetName="Shape" Property="StrokeThickness" Value="2"/>
                        <Setter TargetName="Shape" Property="StrokeDashArray" Value="3 2"/>
                        <Setter TargetName="L1" Property="Foreground" Value="{StaticResource LateStroke}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:BlockKind.PlannedStop}">
                        <Setter TargetName="Shape" Property="Fill" Value="{StaticResource StopStripes}"/>
                        <Setter TargetName="Shape" Property="Stroke" Value="#5F6B6D"/>
                        <Setter TargetName="L1" Property="Foreground" Value="{StaticResource StopInk}"/>
                        <Setter TargetName="L2" Property="Foreground" Value="{StaticResource StopInk}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:BlockKind.Panne}">
                        <Setter TargetName="Shape" Property="Fill" Value="{StaticResource PanneBrush}"/>
                        <Setter TargetName="Shape" Property="Stroke" Value="#FF9A90"/>
                        <Setter TargetName="Shape" Property="RadiusX" Value="2"/>
                        <Setter TargetName="Shape" Property="RadiusY" Value="2"/>
                        <Setter TargetName="Btn" Property="Margin" Value="0,3"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Under the hour of a form: one click for the start of a poste. -->
            <ControlTemplate x:Key="PosteChips" TargetType="ContentControl">
                <WrapPanel>
                    <Button Content="Matin · 06:00" Style="{StaticResource SuggestChip}" Command="{Binding PickPosteCommand}" CommandParameter="0"/>
                    <Button Content="Après-midi · 14:00" Style="{StaticResource SuggestChip}" Command="{Binding PickPosteCommand}" CommandParameter="1"/>
                    <Button Content="Nuit · 22:00" Style="{StaticResource SuggestChip}" Command="{Binding PickPosteCommand}" CommandParameter="2"/>
                </WrapPanel>
            </ControlTemplate>
            <!-- Under the end hour: one click for the end of the poste after the start. -->
            <ControlTemplate x:Key="PosteEndChips" TargetType="ContentControl">
                <WrapPanel>
                    <Button Content="Fin Matin · 14:00" Style="{StaticResource SuggestChip}" Command="{Binding PickPosteEndCommand}" CommandParameter="0"/>
                    <Button Content="Fin Après-midi · 22:00" Style="{StaticResource SuggestChip}" Command="{Binding PickPosteEndCommand}" CommandParameter="1"/>
                    <Button Content="Fin Nuit · 06:00" Style="{StaticResource SuggestChip}" Command="{Binding PickPosteEndCommand}" CommandParameter="2"/>
                </WrapPanel>
            </ControlTemplate>

            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,16,0">
                <TextBlock Text="PLANIFICATION" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource H1}" FontSize="22" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RangeLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Style="{StaticResource SegTrack}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="BoardRange" Content="Jour" Style="{StaticResource Seg}"
                                     IsChecked="{Binding RangeKey, Converter={StaticResource ValueToBool}, ConverterParameter=0}"/>
                        <RadioButton GroupName="BoardRange" Content="Semaine" Style="{StaticResource Seg}"
                                     IsChecked="{Binding RangeKey, Converter={StaticResource ValueToBool}, ConverterParameter=1}"/>
                        <RadioButton GroupName="BoardRange" Content="Mois" Style="{StaticResource Seg}"
                                     IsChecked="{Binding RangeKey, Converter={StaticResource ValueToBool}, ConverterParameter=2}"/>
                    </StackPanel>
                </Border>
                <Button Content="‹" Style="{StaticResource BarButton}" FontSize="16" Padding="14,5" Command="{Binding PreviousCommand}" ToolTip="Précédent"/>
                <Button Content="Aujourd'hui" Style="{StaticResource BarButton}" Margin="4,0" Command="{Binding TodayCommand}"/>
                <Button Content="›" Style="{StaticResource BarButton}" FontSize="16" Padding="14,5" Command="{Binding NextCommand}" ToolTip="Suivant"/>
                <Button Content="+ Règle préventive" Style="{StaticResource BarButton}" Margin="12,0,0,0" Command="{Binding NewPlanCommand}"/>
                <Button Content="+ Arrêt planifié" Style="{StaticResource BarButton}" Margin="6,0,0,0" Background="#7F8C8D" Foreground="White"
                        ToolTip="Planifier un arrêt (pas de commande, jour férié…)" Command="{Binding NewStopCommand}"/>
                <Button Content="+ Maintenance" Style="{StaticResource BarButton}" Margin="6,0,0,0" Background="#FAB219" Foreground="#1A1406"
                        ToolTip="Planifier une maintenance" Command="{Binding NewEventCommand}"/>
                <!-- Not in this version: greyed, a click says so. -->
                <Button Content="+ Ordre de fab." Style="{StaticResource BarButton}" Margin="6,0,0,0" Opacity="0.5"
                        ToolTip="Ordres de fabrication : non disponible dans cette version" Command="{Binding NewOrderCommand}"/>
            </StackPanel>
        </Grid>

        <!-- KPI strip -->
        <!-- KPI strip: one line per tile, so all the lines of the board fit under it. -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="-5,0,-5,10">
            <UniformGrid.Resources>
                <Style x:Key="KpiTile" TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Margin" Value="5,0"/>
                    <Setter Property="Padding" Value="16,8"/>
                </Style>
            </UniformGrid.Resources>
            <Border Style="{StaticResource KpiTile}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StopsText}" Style="{StaticResource BigValue}" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodSuffix, StringFormat='Arrêts planifiés {0}'}" Style="{StaticResource Small}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StopsSub}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource KpiTile}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding MaintText}" Style="{StaticResource BigValue}" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodSuffix, StringFormat='Maintenances {0}'}" Style="{StaticResource Small}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MaintSub}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource KpiTile}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PannesText}" Style="{StaticResource BigValue}" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodSuffix, StringFormat='Pannes {0}'}" Style="{StaticResource Small}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PannesSub}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- Week board -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <!-- Day header -->
                    <Grid DockPanel.Dock="Top" Background="{DynamicResource HoverBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIGNE" Style="{StaticResource Small}" FontSize="11" FontWeight="Bold" Margin="18,0,0,8" VerticalAlignment="Bottom"/>
                        <Grid Grid.Column="1" Margin="0,0,10,0">
                            <ItemsControl ItemsSource="{Binding Columns}" ItemsPanel="{StaticResource OneRow}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ColumnHeader}">
                                        <Border x:Name="Day" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="13" FontWeight="Bold" Margin="6,0,0,3"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <ItemsControl ItemsSource="{Binding Ticks}" ItemsPanel="{StaticResource OneRow}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ColumnTick}">
                                                            <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,3"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="Day" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <views:TimelinePanel IsHitTestVisible="False" Visibility="{Binding IsNowVisible, Converter={StaticResource BoolToVisibility}}">
                                <Border Width="2" Background="{DynamicResource PrimaryTextBrush}" views:TimelinePanel.Start="{Binding NowFrac}"
                                        views:TimelinePanel.End="{Binding NowFrac}"/>
                            </views:TimelinePanel>
                        </Grid>
                    </Grid>

                    <!-- Legend -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="18,6" Orientation="Horizontal">
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Setter Property="Margin" Value="6,0,16,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </WrapPanel.Resources>
                        <Rectangle Width="18" Height="12" RadiusX="3" RadiusY="3" Fill="#403987E5" Stroke="#3987E5"/><TextBlock Text="Couscous"/>
                        <Rectangle Width="18" Height="12" RadiusX="3" RadiusY="3" Fill="#40199E70" Stroke="#199E70"/><TextBlock Text="Pâte courte"/>
                        <Rectangle Width="18" Height="12" RadiusX="3" RadiusY="3" Fill="#409085E9" Stroke="#9085E9"/><TextBlock Text="Pâte longue"/>
                        <Rectangle Width="18" Height="12" RadiusX="3" RadiusY="3" Fill="{StaticResource MaintStripes}"/><TextBlock Text="Maintenance"/>
                        <Rectangle Width="18" Height="12" RadiusX="3" RadiusY="3" Fill="{StaticResource LateFill}" Stroke="{StaticResource LateStroke}" StrokeDashArray="3 2"/><TextBlock Text="Non validée"/>
                        <Rectangle Width="18" Height="12" RadiusX="3" RadiusY="3" Fill="{StaticResource StopStripes}"/><TextBlock Text="Arrêt planifié"/>
                        <Rectangle Width="8" Height="14" RadiusX="2" RadiusY="2" Fill="{StaticResource PanneBrush}"/><TextBlock Text="Panne"/>
                        <Rectangle Width="18" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="Avancement réel (compteur)"/>
                        <Rectangle Width="2" Height="14" Fill="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="Maintenant"/>
                    </WrapPanel>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource CardBorderBrush}"/>

                    <!-- Lines, by sector -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sectors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SectorGroup}">
                                    <StackPanel>
                                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,1" Padding="18,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Color}" Margin="0,0,9,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Small}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MachineRow}">
                                                    <Grid Height="40">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Margin="18,0,6,0" VerticalAlignment="Center" ToolTip="{Binding MachineName}">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding MachineName}" Style="{StaticResource Mono}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Small}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Grid Grid.Column="1" Margin="0,0,10,0">
                                                            <ItemsControl ItemsSource="{Binding DataContext.Columns, ElementName=Root}" ItemsPanel="{StaticResource OneRow}"
                                                                          ItemTemplate="{StaticResource DayColumn}" IsHitTestVisible="False"/>
                                                            <!-- Empty part of the line: click or drag to pick a slot -->
                                                            <Border Background="Transparent"
                                                                    MouseLeftButtonDown="Slot_MouseDown" MouseMove="Slot_MouseMove" MouseLeftButtonUp="Slot_MouseUp"/>
                                                            <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource Block}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <views:TimelinePanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="views:TimelinePanel.Start" Value="{Binding StartFrac}"/>
                                                                        <Setter Property="views:TimelinePanel.End" Value="{Binding EndFrac}"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>
                                                            <!-- Slot picked, or where the open form puts its block -->
                                                            <views:TimelinePanel IsHitTestVisible="False" Visibility="{Binding HasSlot, Converter={StaticResource BoolToVisibility}}">
                                                                <Border Margin="1,3" CornerRadius="7" BorderThickness="2" Background="{DynamicResource AccentSoftBrush}"
                                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                                        views:TimelinePanel.Start="{Binding SlotStartFrac}" views:TimelinePanel.End="{Binding SlotEndFrac}">
                                                                    <TextBlock Text="{Binding SlotText}" FontSize="11" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}"/>
                                                                </Border>
                                                            </views:TimelinePanel>
                                                            <views:TimelinePanel IsHitTestVisible="False"
                                                                                 Visibility="{Binding DataContext.IsNowVisible, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                                                                <Border Width="2" Opacity="0.85" Background="{DynamicResource PrimaryTextBrush}"
                                                                        views:TimelinePanel.Start="{Binding DataContext.NowFrac, ElementName=Root}"
                                                                        views:TimelinePanel.End="{Binding DataContext.NowFrac, ElementName=Root}"/>
                                                            </views:TimelinePanel>
                                                        </Grid>
                                                        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource CardBorderBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Loading motion over the board while it is read -->
            <views:PastaLoader IsActive="{Binding IsBusy}" Text="Chargement du planning…"/>

            <!-- What to plan in the slot just picked, at the mouse -->
            <Popup IsOpen="{Binding IsSlotMenuOpen, Mode=TwoWay}" StaysOpen="False" Placement="MousePoint" HorizontalOffset="6" VerticalOffset="6"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource Card}" Width="300" Padding="16,14" Margin="0,0,14,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="NOUVEAU CRÉNEAU" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding SlotTitle}" Style="{StaticResource H2}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SlotWhen}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding HasSlotWarning, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="#EC835A" Margin="0,5,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding SlotWarning}" Style="{StaticResource Caption}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </DockPanel>
                        <Button Content="Planifier un arrêt" Style="{StaticResource BarButton}" Margin="0,14,0,0" Background="#7F8C8D" Foreground="White"
                                Command="{Binding StopInSlotCommand}"/>
                        <Button Content="Planifier une maintenance" Style="{StaticResource BarButton}" Margin="0,8,0,0" Background="#FAB219" Foreground="#1A1406"
                                Command="{Binding EventInSlotCommand}"/>
                        <Button Content="+ Ordre de fabrication" Style="{StaticResource BarButton}" Margin="0,8,0,0" Opacity="0.5"
                                ToolTip="Non disponible dans cette version" Command="{Binding OrderInSlotCommand}"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Side panel: what is selected, or the open form, whose buttons stay
                 in view at the bottom whatever its length. -->
            <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Enregistrer" Style="{StaticResource AccentBarButton}" Padding="22,8" Command="{Binding SaveOrderCommand}"
                            Visibility="{Binding IsEditingOrder, Converter={StaticResource BoolToVisibility}}"/>
                    <Button DockPanel.Dock="Right" Content="Enregistrer" Style="{StaticResource AccentBarButton}" Padding="22,8" Command="{Binding SaveEventCommand}"
                            Visibility="{Binding IsEditingEvent, Converter={StaticResource BoolToVisibility}}"/>
                    <Button DockPanel.Dock="Right" Content="Enregistrer" Style="{StaticResource AccentBarButton}" Padding="22,8" Command="{Binding SavePlanCommand}"
                            Visibility="{Binding IsEditingPlan, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Annuler" Style="{StaticResource BarButton}" Command="{Binding CancelEditorCommand}" ToolTip="Fermer le formulaire sans enregistrer"/>
                        <Button Content="Supprimer la règle" Style="{StaticResource BarButton}" Margin="6,0,0,0" Command="{Binding DeletePlanCommand}"
                                Visibility="{Binding CanDeletePlan, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="SidePanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Nothing selected -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding ShowEmptyDetail, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4"
                                   Text="Cliquez un bloc pour voir son détail. Glissez un bloc pour le déplacer, ou son bord pour changer son début / sa fin. Cliquez ou glissez sur une partie vide d'une ligne pour y planifier une maintenance ou un arrêt."/>
                    </Border>

                    <!-- Selected block -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding DetailStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetailStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding DetailKind}" FontSize="11" FontWeight="Bold" Foreground="{Binding DetailKindBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailSub}" Style="{StaticResource Caption}" FontSize="14" Margin="0,2,0,0"/>

                            <StackPanel Margin="0,16,0,0" Visibility="{Binding DetailHasProgress, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding DetailProgress, StringFormat={}{0:P0}}"/>
                                    <TextBlock Text="Avancement réel" Style="{StaticResource Small}" FontSize="13" VerticalAlignment="Bottom"/>
                                </DockPanel>
                                <Grid Height="10" Margin="0,8,0,6">
                                    <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="5"/>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding DetailProgress}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <views:TimelinePanel Margin="0,-4">
                                        <Border Width="2" Background="{DynamicResource PrimaryTextBrush}" ToolTip="Avancement attendu maintenant"
                                                views:TimelinePanel.Start="{Binding DetailExpected}" views:TimelinePanel.End="{Binding DetailExpected}"/>
                                    </views:TimelinePanel>
                                </Grid>
                                <TextBlock Text="{Binding DetailProgressText}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding DetailRows}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DetailRow}">
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Small}" FontSize="13" Width="120"/>
                                            <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="10" BorderThickness="1" BorderBrush="{Binding DetailNoteBrush}"
                                    Visibility="{Binding HasDetailNote, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Ellipse Width="9" Height="9" Fill="{Binding DetailNoteBrush}" Margin="0,4,10,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding DetailNote}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </DockPanel>
                            </Border>

                            <UniformGrid Rows="1" Margin="-4,16,-4,0">
                                <Button Content="Modifier" Style="{StaticResource BarButton}" Margin="4,0" Command="{Binding EditSelectedCommand}"
                                        Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Supprimer" Style="{StaticResource BarButton}" Margin="4,0" Command="{Binding DeleteSelectedCommand}"
                                        Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="{Binding CloseSelectedText}" Style="{StaticResource AccentBarButton}" Margin="4,0" Command="{Binding CloseSelectedCommand}"
                                        Visibility="{Binding CanCloseSelected, Converter={StaticResource BoolToVisibility}}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Order form -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding IsEditingOrder, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H2}" FontSize="18" Margin="0,0,0,12"/>
                            <TextBlock Text="N° d'ordre" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="N° d'ordre"/>
                            <TextBlock Text="Ligne" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="40" FontSize="14" ItemsSource="{Binding MachineNames}" SelectedItem="{Binding OrderMachine}"/>
                            <TextBlock Text="Produit" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding OrderProduct, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Produit"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Poids du sac (g)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding OrderWeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Poids du sac"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Quantité (sacs)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding OrderQuantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quantité"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Début : jour" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding OrderDate}" Height="40" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Début : heure" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding OrderTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Heure de début"/>
                                </StackPanel>
                            </Grid>
                            <ContentControl Template="{StaticResource PosteChips}" Focusable="False"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Fin : jour" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding OrderEndDate}" Height="40" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fin : heure" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding OrderEndTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Heure de fin"/>
                                </StackPanel>
                            </Grid>
                            <ContentControl Template="{StaticResource PosteEndChips}" Focusable="False"/>
                            <Button Content="Fin à la cadence nominale" Style="{StaticResource SuggestChip}" HorizontalAlignment="Left"
                                    Command="{Binding OrderEndFromRateCommand}" ToolTip="Fin = quantité à la cadence nominale (Paramètres)"
                                    Visibility="{Binding CanOrderEndFromRate, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding OrderEstimate}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Maintenance / planned stop slot form -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding IsEditingEvent, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H2}" FontSize="18" Margin="0,0,0,12"/>
                            <TextBlock Text="Ligne" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="40" FontSize="14" ItemsSource="{Binding MachineNames}" SelectedItem="{Binding EventMachine}"/>
                            <TextBlock Text="{Binding EventTaskLabel}" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding EventTask, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding EventTaskLabel}"/>
                            <ItemsControl ItemsSource="{Binding StopReasons}" Focusable="False"
                                          Visibility="{Binding IsStopForm, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource SuggestChip}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.PickStopReasonCommand, ElementName=Root}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Début : jour" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding EventDate}" Height="40" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Début : heure" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding EventTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Heure de début"/>
                                </StackPanel>
                            </Grid>
                            <ContentControl Template="{StaticResource PosteChips}" Focusable="False"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Fin : jour" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding EventEndDate}" Height="40" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fin : heure" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding EventEndTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Heure de fin"/>
                                </StackPanel>
                            </Grid>
                            <ContentControl Template="{StaticResource PosteEndChips}" Focusable="False"/>
                            <TextBlock Text="{Binding EventLength}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            <StackPanel Visibility="{Binding IsStopForm, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Intervenant" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                <TextBox Style="{StaticResource Input}" Text="{Binding EventTechnician, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Intervenant"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsStopForm, Converter={StaticResource BoolToVisibility}}"
                                       Text="Hors TRS : le temps d'arrêt planifié n'est pas compté dans le temps requis de la ligne."/>
                        </StackPanel>
                    </Border>

                    <!-- Preventive rule form -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding IsEditingPlan, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H2}" FontSize="18" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="Ligne" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="40" FontSize="14" ItemsSource="{Binding MachineNames}" SelectedItem="{Binding PlanMachine}"/>
                            <TextBlock Text="Tâche" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding PlanTask, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tâche préventive"/>
                            <TextBlock Text="Déclenchement" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="40" FontSize="14" ItemsSource="{Binding PlanKindOptions}" SelectedIndex="{Binding PlanKindIndex}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding PlanIntervalLabel}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding PlanInterval, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Intervalle"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Durée (min)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding PlanDuration, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Durée de la tâche"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Dernière réalisation" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <DatePicker SelectedDate="{Binding PlanLastDone}" Height="40" VerticalContentAlignment="Center"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       Text="Usage : l'échéance avance avec les sacs comptés sur la ligne depuis la dernière réalisation."/>
                        </StackPanel>
                    </Border>

                    <!-- Alerts -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Alertes de planification" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <TextBlock Text="Rien à signaler sur la période affichée." Style="{StaticResource Caption}"
                                       Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AlertRow}">
                                        <DockPanel Margin="0,5">
                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Brush}" Margin="0,5,10,0" VerticalAlignment="Top"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}">
                                                <Run Text="{Binding Machine, Mode=OneWay}" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas"/><Run Text=" — "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Preventive rules -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="calendrier + usage" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                                <TextBlock Text="Maintenance préventive" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <TextBlock Text="Aucune règle : « + Règle préventive » pour en créer une." Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Visibility="{Binding HasPreventives, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Preventives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PreventiveRow}">
                                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" CornerRadius="6" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding MachineName}" Style="{StaticResource Mono}" FontSize="12"/>
                                                    </Border>
                                                    <StackPanel>
                                                        <Button Style="{StaticResource Bare}" Command="{Binding Edit}" ToolTip="Modifier la règle">
                                                            <TextBlock Text="{Binding Task}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </Button>
                                                        <TextBlock Text="{Binding Rule}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <Grid Height="4" Margin="0,6,0,0" Visibility="{Binding HasGauge, Converter={StaticResource BoolToVisibility}}">
                                                            <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="2"/>
                                                            <Border Background="{Binding StatusBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding Gauge}"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </DockPanel>
                                                <DockPanel Margin="0,8,0,0">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Planifier" Style="{StaticResource SmallButton}" Command="{Binding Plan}"/>
                                                        <Button Content="Fait" Style="{StaticResource SmallButton}" Command="{Binding Done}" ToolTip="Réalisée maintenant : l'échéance repart"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource Caption}" FontSize="13" FontWeight="SemiBold" Margin="2,8,0,0"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <!-- Asked before what can't be undone (Supprimer, Réalisée) -->
        <Border Grid.RowSpan="4" Background="#99000000" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="480" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CONFIRMATION" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Non, garder" Style="{StaticResource BarButton}" Padding="18,6" Command="{Binding ConfirmNoCommand}" IsCancel="True"/>
                        <Button Content="{Binding ConfirmYesText}" Style="{StaticResource AccentBarButton}" Padding="22,6" Margin="8,0,0,0"
                                Command="{Binding ConfirmYesCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Production orders clicked: not in this version -->
        <Border Grid.RowSpan="4" Background="#99000000" MouseLeftButtonDown="Unavailable_MouseDown"
                Visibility="{Binding IsUnavailableOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="460" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ORDRES DE FABRICATION" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Fonctionnalité non disponible" Style="{StaticResource H2}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock Text="{x:Static vm:BoardViewModel.OrdersUnavailableText}" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Content="OK" Style="{StaticResource AccentBarButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="28,6"
                            Command="{Binding CloseUnavailableCommand}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
