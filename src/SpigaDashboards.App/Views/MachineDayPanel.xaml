<UserControl x:Class="SpigaDashboards.App.Views.MachineDayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views"
             mc:Ignorable="d"
             d:DesignWidth="1570" d:DesignHeight="700" Background="Transparent">

    <!-- Poste view of ONE machine (MachineDaySlideViewModel): the main poste in
         full (every figure, TRS included, computed from that poste's hours
         only), its production per weight, and under it a compact card per
         earlier poste of the same shift day. -->
    <UserControl.Resources>
        <!-- Small label + value pair of a previous-poste card. -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <DataTemplate x:Key="PreviousShiftTemplate">
            <Border Style="{StaticResource KpiTile}" Padding="16,8">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4">
                        <Run Text="{Binding TeamName, Mode=OneWay}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Run Text=" - Poste "/><Run Text="{Binding ShiftName, Mode=OneWay}"/>
                        <Run Text=" ("/><Run Text="{Binding TimeRange, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                    <UniformGrid Rows="1" Columns="7">
                        <StackPanel>
                            <TextBlock Text="TRS" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding Kpis.TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;}" Style="{StaticResource CardValue}"
                                       Foreground="{Binding TrsSeverity, Converter={StaticResource SeverityBrush}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Poids moyen" Style="{StaticResource CardLabel}"/>
                            <views:WeightAverages Weights="{Binding Kpis.Weights}" LargeFontSize="26" SmallFontSize="16" ShowTargetWhenSingle="False"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Production" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding ProductionText}" Style="{StaticResource CardValue}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Conformite" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding Kpis.QualityPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;}" Style="{StaticResource CardValue}"
                                       Foreground="{Binding Kpis.QualityPercent, Converter={StaticResource PercentBandBrush}, ConverterParameter=Quality}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Vit. moy / max" Style="{StaticResource CardLabel}"/>
                            <TextBlock Style="{StaticResource CardValue}">
                                <Run Text="{Binding Kpis.SpeedBagsPerMinute, StringFormat={}{0:0.0}, Mode=OneWay, ConverterCulture=fr-FR, TargetNullValue=&#x2014;}"/>
                                <Run Text="{Binding Kpis.MaxSpeedBagsPerMinute, StringFormat=/ {0:0.0}, TargetNullValue='/ —', Mode=OneWay, ConverterCulture=fr-FR}" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Disponibilite" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding Kpis.AvailabilityPercent, StringFormat={}{0:0}%}" Style="{StaticResource CardValue}"
                                       Foreground="{Binding Kpis.AvailabilityPercent, Converter={StaticResource PercentBandBrush}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ecart de poids" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding Kpis.WeightDeviationGrams, StringFormat={}{0:+0.0;-0.0;0.0} g, TargetNullValue=&#x2014;}" Style="{StaticResource CardValue}"
                                       Foreground="{Binding WeightDeviationSeverity, Converter={StaticResource SeverityBrush}}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:MachineHeader Grid.Row="0"/>
        <!-- Main poste / team, on the header's second line -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,10,6" DataContext="{Binding Main}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Border CornerRadius="10" Padding="12,2" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StateLabel}" FontSize="15" FontWeight="Bold" Foreground="White"/>
            </Border>
            <TextBlock Margin="12,0,0,0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}">
                <Run Text="{Binding TeamName, Mode=OneWay}"/>
                <Run Text=" - Poste " Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/><Run Text="{Binding ShiftName, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                <Run Text=" (" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="Normal"/><Run Text="{Binding TimeRange, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="Normal"/><Run Text=")" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="Normal"/>
            </TextBlock>
        </StackPanel>


        <!-- Main poste / team -->
        <Grid Grid.Row="1" DataContext="{Binding Main}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="1" Rows="1" Columns="5">
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiLabel}">
                            <Run Text="TRS"/>
                            <Run Text="{Binding TrsTarget, StringFormat=(cible {0:0} %), Mode=OneWay, ConverterCulture=fr-FR}" FontSize="15" Foreground="{DynamicResource SubtleTextBrush}"/>
                        </TextBlock>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Kpis.TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;}" Style="{StaticResource KpiValue}"
                                       Foreground="{Binding TrsSeverity, Converter={StaticResource SeverityBrush}}"/>
                        </Viewbox>
                        <TextBlock Style="{StaticResource KpiSubtext}">
                            <Run Text="D"/> <Run Text="{Binding Kpis.AvailabilityPercent, StringFormat={}{0:0}%, Mode=OneWay, ConverterCulture=fr-FR}"/>
                            <Run Text=" · P"/> <Run Text="{Binding Kpis.PerformancePercent, StringFormat={}{0:0}%, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"/>
                            <Run Text=" · Q"/> <Run Text="{Binding Kpis.QualityPercent, StringFormat={}{0:0.0}%, Mode=OneWay, ConverterCulture=fr-FR, TargetNullValue=&#x2014;}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="Vitesse moy. (sacs/min)" Style="{StaticResource KpiLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Kpis.SpeedBagsPerMinute, StringFormat={}{0:0.0}, TargetNullValue=&#x2014;}" Style="{StaticResource KpiValue}"/>
                        </Viewbox>
                        <TextBlock Text="{Binding Kpis.MaxSpeedBagsPerMinute, StringFormat=Max atteinte : {0:0.0} sacs/min, TargetNullValue='Max atteinte : —'}" Style="{StaticResource KpiSubtext}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="Poids moyen (net)" Style="{StaticResource KpiLabel}"/>
                        <views:WeightAverages Weights="{Binding Kpis.Weights}" LargeFontSize="44" SmallFontSize="26"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="Taux conformite" Style="{StaticResource KpiLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Kpis.QualityPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;}" Style="{StaticResource KpiValue}"
                                       Foreground="{Binding Kpis.QualityPercent, Converter={StaticResource PercentBandBrush}, ConverterParameter=Quality}"/>
                        </Viewbox>
                        <TextBlock Style="{StaticResource KpiSubtext}">
                            <Run Text="Sous tol."/> <Run Text="{Binding Kpis.BagsUnderTolerance, StringFormat={}{0:N0}, Mode=OneWay, ConverterCulture=fr-FR}"/>
                            <Run Text=" · Sur tol."/> <Run Text="{Binding Kpis.BagsOverTolerance, StringFormat={}{0:N0}, Mode=OneWay, ConverterCulture=fr-FR}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiTile}">
                    <StackPanel>
                        <TextBlock Text="Ecart de poids" Style="{StaticResource KpiLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <!-- No weight data = "—" in grey, never a green 0.0 g. -->
                            <TextBlock Text="{Binding Kpis.WeightDeviationGrams, StringFormat={}{0:+0.0;-0.0;0.0} g, TargetNullValue=&#x2014;}" Style="{StaticResource KpiValue}"
                                       Foreground="{Binding WeightDeviationSeverity, Converter={StaticResource SeverityBrush}}"/>
                        </Viewbox>
                        <TextBlock Style="{StaticResource KpiSubtext}">
                            <Run Text="{Binding Kpis.WeightDeviationPercent, StringFormat={}{0:+0.00;-0.00;0.00} %, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"/>
                            <Run Text=" · surpoids"/> <Run Text="{Binding Kpis.GiveawayKg, StringFormat={}{0:+#,##0.0;-#,##0.0;0.0} kg, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <views:ChartCard Grid.Column="0" Title="Marche / arret par heure" Chart="{Binding OnOffChart}"/>
                <views:ChartCard Grid.Column="1" Title="Vitesse moy. / max par heure (sacs/min)" Chart="{Binding SpeedChart}" ShowLegend="True"/>
                <views:ChartCard Grid.Column="2" Title="Poids moyen net vs cible" Chart="{Binding WeightChart}"/>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource ChartTile}" Padding="14,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Production par poids" Style="{StaticResource ChartTitle}"/>
                    <views:WeightTable Weights="{Binding Kpis.Weights}" ValueFontSize="20"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Earlier postes of the same shift day (nothing before the first poste of the day) -->
        <StackPanel Grid.Row="2" Margin="0,4,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPreviousShifts}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Postes precedents (meme journee)" Margin="10,0,10,0" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}"/>
            <ItemsControl ItemsSource="{Binding PreviousShifts}" ItemTemplate="{StaticResource PreviousShiftTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
