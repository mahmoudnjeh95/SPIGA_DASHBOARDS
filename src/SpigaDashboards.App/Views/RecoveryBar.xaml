<UserControl x:Class="SpigaDashboards.App.Views.RecoveryBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48">

    <!-- "REPRISE" bar (StopRecovery): in the stop bar's place under the machine
         photo for a few minutes once a stop is over. Drops in, the check mark
         pops, a light sweeps across twice, then it stays still. -->
    <Border x:Name="Bar" CornerRadius="8" Background="#1E8E4E" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8,0,0,8" Background="#33000000" Padding="14,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Check" Text="&#x2714;" FontSize="24" FontWeight="Bold" Foreground="White"
                               Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="CheckScale"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="REPRISE" FontSize="22" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="22" FontWeight="Bold" Foreground="White" Margin="16,0,12,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <!-- Light sweep -->
            <Rectangle x:Name="Sweep" Grid.ColumnSpan="2" Width="160" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#55FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="SweepShift" X="-180"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Border>
</UserControl>
