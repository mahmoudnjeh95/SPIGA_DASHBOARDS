<UserControl x:Class="SpigaDashboards.App.Views.StopAlertPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,26,0"
             Visibility="{Binding IsStopAlertShown, Converter={StaticResource BoolToVisibility}}">

    <!-- Lines in a stop nobody has given a cause yet (MainViewModel.StopAlerts):
         comes up for a new stop and as a reminder, goes away on its own after
         a few seconds or with its cross. Dragged anywhere on the slide area
         with the mouse; the window saves where it was left (Moved). Same card
         on the main window and the TV. -->
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="Offset"/>
    </UserControl.RenderTransform>

    <Border x:Name="Card" Background="{DynamicResource DangerBrush}" CornerRadius="16" Padding="22,14,14,14" MinWidth="460" MaxWidth="640"
            Cursor="SizeAll" ToolTip="Glisser pour déplacer"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseLeftButtonUp"
            LostMouseCapture="Card_LostMouseCapture">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StopAlertTitle}" FontSize="22" FontWeight="Black" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Command="{Binding DismissStopAlertCommand}" Cursor="Hand"
                        ToolTip="Fermer" AutomationProperties.Name="Fermer l'alerte" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Width="34" Height="34" CornerRadius="17" Background="#33FFFFFF">
                                <TextBlock Text="&#x2715;" FontSize="17" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding StopAlerts}" Margin="0,10,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#55FFFFFF" BorderThickness="0,1,0,0" Padding="0,7,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding MachineName}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock FontSize="16" Foreground="#F2FFFFFF">
                                        <Run Text="À l'arrêt "/><Run Text="{Binding SinceText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="28" FontWeight="Black"
                                           Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StopAlertMore}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="À qualifier dans Planification › Pannes (panne, arrêt planifié…)" FontSize="14"
                       Foreground="#E6FFFFFF" Margin="0,6,8,0"/>
        </StackPanel>
    </Border>
</UserControl>
