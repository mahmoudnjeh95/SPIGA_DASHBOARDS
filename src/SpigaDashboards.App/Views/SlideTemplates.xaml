<!-- Slide DataTemplates shared by the operator window (MainWindow) and the
     TV window (TvWindow): both show exactly the same slides. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:slides="clr-namespace:SpigaDashboards.App.ViewModels.Slides"
                    xmlns:views="clr-namespace:SpigaDashboards.App.Views">

    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- "Aujourd'hui" / "Poste precedent": one machine, one poste in full + earlier postes of the day. -->
    <DataTemplate DataType="{x:Type slides:MachineDaySlideViewModel}">
        <views:MachineDayPanel/>
    </DataTemplate>

    <!-- Hier / semaine / mois / 3 mois / dates choisies: one machine, period totals. -->
    <DataTemplate DataType="{x:Type slides:MachinePeriodSlideViewModel}">
        <views:MachinePeriodPanel/>
    </DataTemplate>

    <!-- Slide 8: admin-selected external PDF (consignes, instructions, documents qualite). -->
    <DataTemplate DataType="{x:Type slides:PdfSlideViewModel}">
        <Grid>
            <Image Source="{Binding PageImage}" Stretch="Uniform"
                   Visibility="{Binding PageImage, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="700"
                       Visibility="{Binding PageImage, Converter={StaticResource InverseNullToVisibility}}"/>
        </Grid>
    </DataTemplate>

    <!-- Synthesis per sector: lines and their weights over month / 3 months / year. -->
    <DataTemplate DataType="{x:Type slides:SynthesisSlideViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <!-- Highlights the button of the period shown. -->
                <Style x:Key="PeriodButton" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                    <Setter Property="Command" Value="{Binding DataContext.SetSynthesisPeriodCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                </Style>
            </Grid.Resources>

            <Grid Grid.Row="0" Margin="16,6,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="Synthèse - "/><Run Text="{Binding SectorLabel, Mode=OneWay}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                    <Run Text=" · "/><Run Text="{Binding PeriodLabel, Mode=OneWay}"/>
                    <Run Text="  ·  TRS secteur " FontSize="18"/><Run Text="{Binding SectorKpis.TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Run Text="  ·  Production " FontSize="18"/><Run Text="{Binding SectorProductionText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Ce mois" Tag="Month">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Period}" Value="Month">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="3 derniers mois" Tag="ThreeMonths">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Period}" Value="ThreeMonths">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Année" Tag="Year">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Period}" Value="Year">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <views:SynthesisPanel Grid.Row="1"/>
        </Grid>
    </DataTemplate>

    <!-- Conditionnement 1 (CC03 + CC04) / 2 (other lines): production and TRS per machine and team over the top-bar period,
         then the same group's TRS slide (IsTrs). -->
    <DataTemplate DataType="{x:Type slides:PackagingSlideViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="16,6,16,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/><Run
                     Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold">
                    <Run.Style>
                        <Style TargetType="Run">
                            <Setter Property="Text" Value=""/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrs}" Value="True">
                                    <Setter Property="Text" Value=" - TRS"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Run.Style>
                </Run>
                <Run Text=" · "/><Run Text="{Binding MachinesLabel, Mode=OneWay}"/>
                <Run Text=" · "/><Run Text="{Binding PeriodLabel, Mode=OneWay}"/>
                <Run Text="  ·  TRS " FontSize="18"/><Run Text="{Binding Overall.Kpis.TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"
                                                     FontWeight="Bold" Foreground="{Binding Overall.TrsSeverity, Converter={StaticResource SeverityBrush}}"/>                <Run Text="  ·  Production " FontSize="18"/><Run Text="{Binding TotalProductionText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </TextBlock>
            <views:PackagingPanel Grid.Row="1"/>
        </Grid>
    </DataTemplate>

    <!-- First Cumul slide: only the run-state photo (RunStateImage) of every
         machine, as big as the screen allows (10 machines = 2 rows of 5),
         captioned with its name from Parametres. -->
    <DataTemplate DataType="{x:Type slides:RunStateSlideViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="16,6,16,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/><Run
                     Text=" · État des machines"/><Run Text="  ·  En marche " FontSize="18"/><Run
                     Text="{Binding RunningCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/><Run
                     Text="{Binding Tiles.Count, StringFormat={}/{0}, Mode=OneWay}"/>
            </TextBlock>
            <Border Grid.Row="1" Margin="6" Style="{StaticResource ChartTile}">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding TileColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type slides:MachineRunTile}">
                            <Viewbox Margin="10,6">
                                <StackPanel Width="204" Margin="0,8,0,0">
                                    <views:RunStateImage HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MachineName}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <!-- Cause of the stop in progress, once it has one (MachineRunTile.HasCause):
                                         a pill in the stop bar's colour that pops in, then how long and the
                                         expected return. The room is kept on every tile when any has a cause. -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Height" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.HasCauses, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Height" Value="46"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <StackPanel Visibility="{Binding HasCause, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                            <Border Background="{Binding CauseColor}" CornerRadius="11" Padding="9,2,11,3" HorizontalAlignment="Center"
                                                    MaxWidth="204" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform/>
                                                </Border.RenderTransform>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.45" Duration="0:0:0.3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.5" To="1" BeginTime="0:0:0.45" Duration="0:0:0.5">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.5" To="1" BeginTime="0:0:0.45" Duration="0:0:0.5">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,5,0"
                                                               VerticalAlignment="Center" Foreground="{Binding CauseTextColor}"/>
                                                    <TextBlock Text="{Binding CauseLabel}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"
                                                               Foreground="{Binding CauseTextColor}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,3,0,0">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                                <Run Text="{Binding CauseDuration, Mode=OneWay}"/><Run Text="{Binding CauseReturn, Mode=OneWay}" FontWeight="SemiBold">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                            </Viewbox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Viewbox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
