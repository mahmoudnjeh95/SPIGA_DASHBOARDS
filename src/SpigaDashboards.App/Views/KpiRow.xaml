<UserControl x:Class="SpigaDashboards.App.Views.KpiRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views">

    <!-- Headline tiles of the machine slides (poste view: ShiftSummaryViewModel,
         period view: MachinePeriodSlideViewModel; same property names).
         Figures through TileFx: count-up, change flash + pill, red outline
         while in the red. TRS also as a ring (TrsRing) with its target. -->
    <UniformGrid Rows="1" Columns="5">
        <Border Style="{StaticResource KpiTileCompact}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource KpiLabelCompact}">
                    <Run Text="TRS"/>
                    <Run Text="{Binding TrsTarget, StringFormat=(cible {0:0} %), Mode=OneWay, ConverterCulture=fr-FR}" FontSize="15" Foreground="{DynamicResource SubtleTextBrush}"/>
                </TextBlock>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource KpiValueCompact}"
                                   Foreground="{Binding TrsSeverity, Converter={StaticResource SeverityBrush}}"
                                   views:TileFx.Value="{Binding Kpis.TrsPercent}" views:TileFx.Format="{}{0:0.0}%"
                                   views:TileFx.Metric="trs" views:TileFx.Better="Up" views:TileFx.MinDelta="0.5"
                                   views:TileFx.DeltaFormat="{}{0:+0.0;-0.0} pt"/>
                    </Viewbox>
                    <!-- Rising / falling over the last hour (poste in progress only). -->
                    <views:TrendBadge Grid.Column="1" HorizontalAlignment="Left" Trend="{Binding TrsTrend}"/>
                </Grid>
                <TextBlock Grid.Row="2" Style="{StaticResource KpiSubtextCompact}">
                    <Run Text="D"/> <Run Text="{Binding Kpis.AvailabilityPercent, StringFormat={}{0:0}%, Mode=OneWay, ConverterCulture=fr-FR}" Foreground="{Binding Kpis.AvailabilityPercent, Converter={StaticResource PercentBandBrush}}"/>
                    <Run Text=" · P"/> <Run Text="{Binding Kpis.PerformancePercent, StringFormat={}{0:0}%, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}" Foreground="{Binding Kpis.PerformancePercent, Converter={StaticResource PercentBandBrush}, ConverterParameter=Performance}"/>
                    <Run Text=" · Q"/> <Run Text="{Binding Kpis.QualityPercent, StringFormat={}{0:0.0}%, Mode=OneWay, ConverterCulture=fr-FR, TargetNullValue=&#x2014;}" Foreground="{Binding Kpis.QualityPercent, Converter={StaticResource PercentBandBrush}, ConverterParameter=Quality}"/>
                </TextBlock>
                <views:TrsRing Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="58" Height="58" Margin="8,0,0,0"
                               VerticalAlignment="Center" Thickness="7"
                               Value="{Binding Kpis.TrsPercent}" Target="{Binding TrsTarget}"
                               Brush="{Binding TrsSeverity, Converter={StaticResource SeverityBrush}}"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource KpiTileCompact}">
            <StackPanel>
                <TextBlock Text="Vitesse moy. (sacs/min)" Style="{StaticResource KpiLabelCompact}"/>
                <StackPanel Orientation="Horizontal">
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource KpiValueCompact}"
                                   views:TileFx.Value="{Binding Kpis.SpeedBagsPerMinute}" views:TileFx.Format="{}{0:0.0}"
                                   views:TileFx.Metric="speed" views:TileFx.Better="Up" views:TileFx.MinDelta="0.5"
                                   views:TileFx.DeltaFormat="{}{0:+0.0;-0.0}"/>
                    </Viewbox>
                    <views:TrendBadge Trend="{Binding SpeedTrend}"/>
                </StackPanel>
                <TextBlock Text="{Binding Kpis.MaxSpeedBagsPerMinute, StringFormat=Max atteinte : {0:0.0} sacs/min, TargetNullValue='Max atteinte : —'}" Style="{StaticResource KpiSubtextCompact}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource KpiTileCompact}">
            <StackPanel>
                <TextBlock Text="Poids moyen (net)" Style="{StaticResource KpiLabelCompact}"/>
                <views:WeightAverages Weights="{Binding Kpis.Weights}" LargeFontSize="34" SmallFontSize="20"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource KpiTileCompact}">
            <StackPanel>
                <TextBlock Text="Taux de conformité" Style="{StaticResource KpiLabelCompact}"/>
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource KpiValueCompact}"
                               Foreground="{Binding Kpis.QualityPercent, Converter={StaticResource PercentBandBrush}, ConverterParameter=Quality}"
                               views:TileFx.Value="{Binding Kpis.QualityPercent}" views:TileFx.Format="{}{0:0.0}%"
                               views:TileFx.Metric="quality" views:TileFx.Better="Up" views:TileFx.MinDelta="0.2"
                               views:TileFx.DeltaFormat="{}{0:+0.0;-0.0} pt"/>
                </Viewbox>
                <TextBlock Style="{StaticResource KpiSubtextCompact}">
                    <Run Text="Sous tol."/> <Run Text="{Binding Kpis.BagsUnderTolerance, StringFormat={}{0:N0}, Mode=OneWay, ConverterCulture=fr-FR}"/>
                    <Run Text=" · Sur tol."/> <Run Text="{Binding Kpis.BagsOverTolerance, StringFormat={}{0:N0}, Mode=OneWay, ConverterCulture=fr-FR}"/>
                </TextBlock>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource KpiTileCompact}">
            <StackPanel>
                <TextBlock Text="Écart de poids" Style="{StaticResource KpiLabelCompact}"/>
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <!-- No weight data = "—" in grey, never a green 0.0 g. -->
                    <TextBlock Style="{StaticResource KpiValueCompact}"
                               Foreground="{Binding WeightDeviationSeverity, Converter={StaticResource SeverityBrush}}"
                               views:TileFx.Value="{Binding Kpis.WeightDeviationGrams}" views:TileFx.Format="{}{0:+0.0;-0.0;0.0} g"
                               views:TileFx.Metric="deviation" views:TileFx.Better="Zero" views:TileFx.MinDelta="0.3"
                               views:TileFx.DeltaFormat="{}{0:+0.0;-0.0} g"/>
                </Viewbox>
                <TextBlock Style="{StaticResource KpiSubtextCompact}">
                    <Run Text="{Binding Kpis.WeightDeviationPercent, StringFormat={}{0:+0.00;-0.00;0.00} %, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"/>
                    <Run Text=" · surpoids"/> <Run Text="{Binding Kpis.GiveawayKg, StringFormat={}{0:+#,##0.0;-#,##0.0;0.0} kg, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>
