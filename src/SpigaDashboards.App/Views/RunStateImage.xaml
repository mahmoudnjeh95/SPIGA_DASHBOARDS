<UserControl x:Class="SpigaDashboards.App.Views.RunStateImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Run state of one machine (DataContext: BeltRunning, IsMaintenance,
         IsPlannedStop, PlannedLabel, RunStateLabel): the machine photo in a
         bold red (stopped) / green (running) frame, over a "conveyor" track
         whose dots flow in green while running and stand still in red while
         stopped. A running machine's halo also pulses, so the state reads from
         across the hall. In a slot of the Planification board the frame and
         dots turn yellow (maintenance) or grey with a grey photo (planned
         stop), under a banner saying so. Fixed 144 px wide (the dots run
         across that): wrap it in a Viewbox to draw it smaller. Shared by the
         machine header and the Cumul run-state slide. -->
    <UserControl.Resources>
        <!-- Same on both themes: the board's maintenance yellow, and a mid grey. -->
        <SolidColorBrush x:Key="MaintenanceStateBrush" Color="#FAB219"/>
        <SolidColorBrush x:Key="PlannedStopStateBrush" Color="#8E979F"/>
        <FormatConvertedBitmap x:Key="GreyPhoto" DestinationFormat="Gray8">
            <FormatConvertedBitmap.Source>
                <BitmapImage UriSource="pack://application:,,,/Assets/machine-stopped.png"/>
            </FormatConvertedBitmap.Source>
        </FormatConvertedBitmap>
        <!-- Keeps the transparent corners of the photo (Gray8 has no alpha). -->
        <ImageBrush x:Key="PhotoMask" ImageSource="pack://application:,,,/Assets/machine-stopped.png"/>
    </UserControl.Resources>

    <StackPanel Width="144"
                ToolTip="{Binding RunStateLabel}" AutomationProperties.Name="{Binding RunStateLabel}">
        <Grid>
            <!-- Soft halo behind the photo, in the state colour. -->
            <Rectangle x:Name="Halo" RadiusX="16" RadiusY="16" Margin="-3">
                <Rectangle.Effect>
                    <BlurEffect Radius="14"/>
                </Rectangle.Effect>
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                        <Setter Property="Opacity" Value="0.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="RunningPulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.9" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RunningPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource MaintenanceStateBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlannedStop}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource PlannedStopStateBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <Border BorderThickness="4" CornerRadius="16" Background="White">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource MaintenanceStateBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlannedStop}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PlannedStopStateBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="/Assets/machine-stopped.png"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                    <Setter Property="Source" Value="/Assets/machine-running.png"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlannedStop}" Value="True">
                                    <Setter Property="Source" Value="{StaticResource GreyPhoto}"/>
                                    <Setter Property="OpacityMask" Value="{StaticResource PhotoMask}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>
            <!-- Planned stop / maintenance banner across the photo -->
            <Border VerticalAlignment="Center" Margin="-6,0" Padding="4,5" CornerRadius="6"
                    Visibility="{Binding PlannedLabel, Converter={StaticResource NullToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource MaintenanceStateBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlannedStop}" Value="True">
                                <Setter Property="Background" Value="#5F6B6D"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                </Border.Effect>
                <TextBlock Text="{Binding PlannedLabel}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1A1406"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlannedStop}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <Grid Height="12" Margin="0,5,0,0" ClipToBounds="True">
            <Rectangle RadiusX="6" RadiusY="6" Opacity="0.22">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource MaintenanceStateBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlannedStop}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource PlannedStopStateBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
                <Canvas>
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PlannedLabel, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RunDot0" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:0" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="RunDot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:0.4" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="RunDot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:0.8" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="RunDot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:1.2" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                    <Ellipse x:Name="RunDot0" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                        <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RunDot1" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                        <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RunDot2" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                        <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RunDot3" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                        <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            <!-- Stopped (or in a planned slot): the same dots, frozen on the track. -->
            <Canvas>
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BeltRunning}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PlannedLabel, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <Canvas.Resources>
                    <Style TargetType="Ellipse">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="Canvas.Top" Value="2"/>
                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMaintenance}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource MaintenanceStateBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlannedStop}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource PlannedStopStateBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Resources>
                <Ellipse Canvas.Left="12"/>
                <Ellipse Canvas.Left="50"/>
                <Ellipse Canvas.Left="89"/>
                <Ellipse Canvas.Left="127"/>
            </Canvas>
        </Grid>
    </StackPanel>
</UserControl>
