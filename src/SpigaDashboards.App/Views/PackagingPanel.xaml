<UserControl x:Class="SpigaDashboards.App.Views.PackagingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views"
             xmlns:slides="clr-namespace:SpigaDashboards.App.ViewModels.Slides"
             mc:Ignorable="d"
             d:DesignWidth="1560" d:DesignHeight="760" Background="Transparent">

    <!-- Conditionnement 1 / 2 (PackagingSlideViewModel): on top, the production
         of each machine per team with row and column totals; below, the team
         totals and the machine totals as bars. -->
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Production in bold, bags beside it. -->
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type slides:PackagingCell}">
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding ProductionText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Run FontSize="14" Foreground="{DynamicResource SubtleTextBrush}">
                    <Run.Style>
                        <Style TargetType="Run">
                            <Setter Property="Text" Value="{Binding TotalBags, StringFormat='{}· {0:N0} sacs', Mode=OneWay, ConverterCulture=fr-FR}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalBags}" Value="0">
                                    <Setter Property="Text" Value=""/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Run.Style>
                </Run>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ChartTile}" Padding="14,8">
            <DockPanel>
                <!-- Column headers: Machine | teams | Total -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="260" Text="Machine" Style="{StaticResource Head}"/>
                    <TextBlock DockPanel.Dock="Right" Width="230" Text="Total" Style="{StaticResource Head}"/>
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Head}" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- One row per machine, then the Total row; rows share the height. -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type slides:PackagingRow}">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AlternatingRowBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="260" Text="{Binding Label}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ContentPresenter DockPanel.Dock="Right" Width="230" Content="{Binding Total}" ContentTemplate="{StaticResource CellTemplate}"/>
                                    <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource CellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <views:ChartCard Grid.Column="0" Chart="{Binding TeamChart}" Title="Production par equipe"/>
            <views:ChartCard Grid.Column="1" Chart="{Binding MachineChart}" Title="Production par machine"/>
        </Grid>
    </Grid>
</UserControl>
