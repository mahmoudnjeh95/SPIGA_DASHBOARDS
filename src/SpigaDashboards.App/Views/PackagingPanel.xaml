<UserControl x:Class="SpigaDashboards.App.Views.PackagingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views"
             xmlns:slides="clr-namespace:SpigaDashboards.App.ViewModels.Slides"
             mc:Ignorable="d"
             d:DesignWidth="1560" d:DesignHeight="760" Background="Transparent">

    <!-- Conditionnement 1 / 2 / Cumul (PackagingSlideViewModel): on top, the
         production and TRS of each machine per team with row and column
         totals; below, the team totals and the machine totals as bars (on the
         Cumul production slide, the run state of every machine instead of the
         machine bars). On the TRS slide (IsTrs) the cells lead with the TRS
         and its D / P / Q, and the bars are the TRS. -->
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Production slide: production in bold, TRS, then bags (not on Cumul). TRS slide:
             TRS in bold, then D / P / Q. Nothing but "—" when nothing was made. -->
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type slides:PackagingCell}">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="ProductionLayout" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ProductionText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Run x:Name="TrsLabel" Text=" TRS " FontSize="14" Foreground="{DynamicResource SubtleTextBrush}"/><Run
                         x:Name="TrsValue" Text="{Binding Kpis.TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"
                         FontSize="18" FontWeight="Bold" Foreground="{Binding TrsSeverity, Converter={StaticResource SeverityBrush}}"/>
                    <Run x:Name="Bags" Text="{Binding TotalBags, StringFormat='{}· {0:N0} sacs', Mode=OneWay, ConverterCulture=fr-FR}"
                         FontSize="14" Foreground="{DynamicResource SubtleTextBrush}"/>
                </TextBlock>
                <TextBlock x:Name="TrsLayout" TextTrimming="CharacterEllipsis" Visibility="Collapsed">
                    <Run Text="{Binding Kpis.TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}"
                         FontSize="22" FontWeight="Bold" Foreground="{Binding TrsSeverity, Converter={StaticResource SeverityBrush}}"/>
                    <Run x:Name="Dpq" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}"
                         Text="{Binding Kpis.AvailabilityPercent, StringFormat='{} D {0:0}%', Mode=OneWay, ConverterCulture=fr-FR}"/><Run
                         x:Name="Perf" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}"
                         Text="{Binding Kpis.PerformancePercent, StringFormat='{} · P {0:0}%', TargetNullValue=' · P —', Mode=OneWay, ConverterCulture=fr-FR}"/><Run
                         x:Name="Quality" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}"
                         Text="{Binding Kpis.QualityPercent, StringFormat='{} · Q {0:0.0}%', TargetNullValue=' · Q —', Mode=OneWay, ConverterCulture=fr-FR}"/>
                </TextBlock>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsTrs, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="ProductionLayout" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TrsLayout" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Cumul: tonnage and TRS only, no bag count. -->
                <DataTrigger Binding="{Binding DataContext.IsCumul, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="Bags" Property="Text" Value=""/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasProduction}" Value="False">
                    <Setter TargetName="TrsLabel" Property="Text" Value=""/>
                    <Setter TargetName="TrsValue" Property="Text" Value=""/>
                    <Setter TargetName="Bags" Property="Text" Value=""/>
                    <Setter TargetName="Dpq" Property="Text" Value=""/>
                    <Setter TargetName="Perf" Property="Text" Value=""/>
                    <Setter TargetName="Quality" Property="Text" Value=""/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ChartTile}" Padding="14,8">
            <DockPanel>
                <!-- Column headers: Machine | teams | Total -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="260" Text="Machine" Style="{StaticResource Head}"/>
                    <TextBlock DockPanel.Dock="Right" Width="230" Text="Total" Style="{StaticResource Head}"/>
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Head}" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- One row per machine, then the Total row; rows share the height. -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type slides:PackagingRow}">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AlternatingRowBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="260" Text="{Binding Label}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ContentPresenter DockPanel.Dock="Right" Width="230" Content="{Binding Total}" ContentTemplate="{StaticResource CellTemplate}"/>
                                    <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource CellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- The legend names the target line of the TRS bars. -->
            <views:ChartCard Grid.Column="0" Chart="{Binding TeamChart}" Title="{Binding TeamChartTitle}" ShowLegend="{Binding IsTrs}"
                             Visibility="{Binding ShowRunTiles, Converter={StaticResource InverseBoolToVisibility}}"/>
            <views:ChartCard Grid.Column="1" Chart="{Binding MachineChart}" Title="{Binding MachineChartTitle}" ShowLegend="{Binding IsTrs}"
                             Visibility="{Binding ShowRunTiles, Converter={StaticResource InverseBoolToVisibility}}"/>

            <!-- Cumul production slide, in place of the bars (the table's totals
                 have them): every machine's run-state photo (RunStateImage) in one
                 row, as big as the width allows, captioned with its id only. -->
            <Border Grid.ColumnSpan="2" Style="{StaticResource ChartTile}"
                    Visibility="{Binding ShowRunTiles, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding RunTiles}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type slides:MachineRunTile}">
                            <Viewbox Margin="6,0">
                                <StackPanel Width="150" Margin="0,8,0,0">
                                    <views:RunStateImage HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MachineId}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Viewbox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
