<UserControl x:Class="SpigaDashboards.App.Views.WeightAverages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SpigaDashboards.App.Models"
             x:Name="Root">

    <!-- Net average weight per target weight, one line each ("503,6 g / 500 g"):
         big when the line ran one weight, smaller lines when it ran several,
         so two weights stay readable instead of one shrunken string. -->
    <Grid>
        <ItemsControl x:Name="Items" ItemsSource="{Binding Weights, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:WeightKpi}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AvgWeight, StringFormat={}{0:N1} g, TargetNullValue=&#x2014;, ConverterCulture=fr-FR}"
                                   FontSize="{Binding EffectiveFontSize, ElementName=Root}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding TargetWeight, StringFormat=/ {0:0} g, ConverterCulture=fr-FR}" Margin="6,0,0,0"
                                   FontSize="{Binding TargetFontSize, ElementName=Root}" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Visibility="{Binding TargetVisibility, ElementName=Root}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Empty" Text="&#x2014;" FontSize="{Binding LargeFontSize, ElementName=Root}" FontWeight="Bold"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
    </Grid>
</UserControl>
