<UserControl x:Class="SpigaDashboards.App.Views.MachineHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Machine identity + live status, shared by the poste and period slides
         (MachineDaySlideViewModel / MachinePeriodSlideViewModel). -->
    <Grid Margin="10,2,10,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Run state: the machine photo in a bold red (stopped) / green
             (running) frame, spanning both header lines, over a "conveyor" track
             whose dots flow in green while running and stand still in red while
             stopped. A running machine's halo also pulses, so the state reads
             from across the hall. -->
        <StackPanel Grid.Column="0" Grid.RowSpan="2" Width="144" Margin="0,2,18,0" VerticalAlignment="Center"
                    ToolTip="{Binding RunStateLabel}" AutomationProperties.Name="{Binding RunStateLabel}">
            <Grid>
                <!-- Soft halo behind the photo, in the state colour. -->
                <Rectangle RadiusX="16" RadiusY="16" Margin="-3">
                    <Rectangle.Effect>
                        <BlurEffect Radius="14"/>
                    </Rectangle.Effect>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="RunningPulse">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.9" Duration="0:0:1.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="RunningPulse"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <Border BorderThickness="4" CornerRadius="16" Background="White">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="/Assets/machine-stopped.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                        <Setter Property="Source" Value="/Assets/machine-running.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Border>
            </Grid>

            <Grid Height="12" Margin="0,5,0,0" ClipToBounds="True">
                <Rectangle RadiusX="6" RadiusY="6" Opacity="0.22">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                    <Canvas>
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BeltRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Canvas.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="RunDot0" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:0" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="RunDot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:0.4" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="RunDot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:0.8" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="RunDot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-10" To="144" Duration="0:0:1.6" BeginTime="0:0:1.2" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Canvas.Triggers>
                        <Ellipse x:Name="RunDot0" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                            <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RunDot1" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                            <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RunDot2" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                            <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="RunDot3" Width="8" Height="8" Canvas.Top="2" Fill="{DynamicResource SuccessBrush}">
                            <Ellipse.RenderTransform><TranslateTransform X="-10"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                <!-- Stopped: the same dots, frozen on the track. -->
                <Canvas>
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BeltRunning}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                    <Ellipse Width="8" Height="8" Canvas.Left="12" Canvas.Top="2" Fill="{DynamicResource DangerBrush}"/>
                    <Ellipse Width="8" Height="8" Canvas.Left="50" Canvas.Top="2" Fill="{DynamicResource DangerBrush}"/>
                    <Ellipse Width="8" Height="8" Canvas.Left="89" Canvas.Top="2" Fill="{DynamicResource DangerBrush}"/>
                    <Ellipse Width="8" Height="8" Canvas.Left="127" Canvas.Top="2" Fill="{DynamicResource DangerBrush}"/>
                </Canvas>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding SectorLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,0,12,0"
                       Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding MachineName}"
                       FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PeriodLabel}" FontSize="22" FontWeight="SemiBold" Margin="16,0,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource DangerBrush}" CornerRadius="12" Padding="14,3" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip="Aucune donnee recue de StatsViewer pour cette ligne">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="PAS DE DONNEES" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrush}}"/>
            <TextBlock Text="Connecte" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Text="{Binding CurrentProductionLabel}" FontSize="16"
                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                   ToolTip="{Binding CurrentProduction.ProductionId}"/>
    </Grid>
</UserControl>
