<UserControl x:Class="SpigaDashboards.App.Views.MachineHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SpigaDashboards.App.Views">

    <!-- Machine identity + live status, shared by the poste and period slides
         (MachineDaySlideViewModel / MachinePeriodSlideViewModel). -->
    <Grid Margin="10,2,10,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Run state photo (RunStateImage), spanning both header lines. -->
        <views:RunStateImage Grid.Column="0" Grid.RowSpan="2" Margin="0,2,18,0" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding SectorLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,0,12,0"
                       Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding MachineName}"
                       FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PeriodLabel}" FontSize="22" FontWeight="SemiBold" Margin="16,0,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource DangerBrush}" CornerRadius="12" Padding="14,3" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip="Aucune donnée reçue de StatsViewer pour cette ligne">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="PAS DE DONNÉES" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrush}}"/>
            <TextBlock Text="Connecté" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Text="{Binding CurrentProductionLabel}" FontSize="16"
                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                   ToolTip="{Binding CurrentProduction.ProductionId}"/>

        <!-- Stop in progress (OngoingStopService) that doesn't take the whole
             view (TickerStop): scrolling bar under the machine photo, the
             full width of the slide; the figures stay visible under it. -->
        <views:StopTicker Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" DataContext="{Binding TickerStop}"
                          Visibility="{Binding Converter={StaticResource NullToVisibility}}"
                          BadgeText="{Binding Title}" Text="{Binding TickerText}"
                          BarColor="{Binding TickerColor}" TextColor="{Binding TickerTextColor}" Speed="{Binding TickerSpeed}"/>
    </Grid>
</UserControl>
