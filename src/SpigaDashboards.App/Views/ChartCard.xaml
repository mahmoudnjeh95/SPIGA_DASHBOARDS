<UserControl x:Class="SpigaDashboards.App.Views.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             x:Name="Root">

    <!-- One chart tile: title, chart (ChartParts), optional legend, and a
         "Pas de donnees" placeholder instead of an empty chart. -->
    <Border Style="{StaticResource ChartTile}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title, ElementName=Root}" Style="{StaticResource ChartTitle}"/>
            <Grid>
                <lvc:CartesianChart x:Name="ChartView" LegendPosition="Hidden" Background="{DynamicResource TileBackgroundBrush}"
                                    Series="{Binding Chart.Series, ElementName=Root}"
                                    XAxes="{Binding Chart.XAxes, ElementName=Root}"
                                    YAxes="{Binding Chart.YAxes, ElementName=Root}"
                                    LegendTextPaint="{Binding Chart.LegendTextPaint, ElementName=Root}"
                                    LegendTextSize="14">
                    <lvc:CartesianChart.Style>
                        <Style TargetType="lvc:CartesianChart">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Chart.HasData, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </lvc:CartesianChart.Style>
                </lvc:CartesianChart>
                <TextBlock Text="Pas de donnees" FontSize="20" Foreground="{DynamicResource SubtleTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Chart.HasData, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
