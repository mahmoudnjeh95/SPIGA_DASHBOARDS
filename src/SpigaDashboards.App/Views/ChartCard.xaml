<UserControl x:Class="SpigaDashboards.App.Views.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             x:Name="Root">

    <!-- One chart tile: title, chart (ChartParts), optional legend, and a
         "Pas de donnees" placeholder instead of an empty chart. -->
    <Border Style="{StaticResource ChartTile}">
        <DockPanel>
            <!-- Title, and the legend on the same row (ChartCard.Apply fills it):
                 LiveCharts' own legend took a row of the short tiles' height
                 and covered the values printed above the tallest bars. -->
            <DockPanel DockPanel.Dock="Top">
                <ItemsControl x:Name="Legend" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <Ellipse Width="11" Height="11" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource ChartTitle}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <Grid>
                <!-- Series and axes are set by ChartCard.Apply (moved in place on a refresh). -->
                <lvc:CartesianChart x:Name="ChartView" LegendPosition="Hidden" Background="{DynamicResource TileBackgroundBrush}"
                                    LegendTextPaint="{Binding Chart.LegendTextPaint, ElementName=Root}"
                                    LegendTextSize="14">
                    <lvc:CartesianChart.Style>
                        <Style TargetType="lvc:CartesianChart">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Chart.HasData, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </lvc:CartesianChart.Style>
                </lvc:CartesianChart>
                <TextBlock Text="Pas de données" FontSize="20" Foreground="{DynamicResource SubtleTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Chart.HasData, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
