<UserControl x:Class="SpigaDashboards.App.Views.WeightTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SpigaDashboards.App.Models;assembly=SpigaDashboards.Production"
             x:Name="Root">

    <!-- "Production par poids": one row per target weight the line ran
         (WeightKpi): bags, net weight produced, net average weight, deviation,
         weight given away, TRS. Two-line cells (value + detail) so nothing is
         cut off in the narrow layouts. Text size follows ValueFontSize. -->
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="{Binding HeaderFontSize, ElementName=Root}"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="{Binding ValueFontSize, ElementName=Root}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Compact (synthesis cards): one line per weight, details hidden. -->
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="Visibility" Value="{Binding DetailVisibility, ElementName=Root}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="{Binding HeaderFontSize, ElementName=Root}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Poids / produit" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="1" Text="Sacs" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="2" Text="Production" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="3" Text="Poids moyen" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="4" Text="Écart" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="5" Text="Sur / sous-poids" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="6" Text="TRS" Style="{StaticResource Head}"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Weights, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:WeightKpi}">
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" ToolTip="{Binding ProductName}">
                                <TextBlock Text="{Binding TargetWeight, StringFormat={}{0:0} g}" Style="{StaticResource Cell}"/>
                                <TextBlock Text="{Binding ProductName}" Style="{StaticResource Detail}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalBags, StringFormat={}{0:N0}}" Style="{StaticResource Cell}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ProductionText}" Style="{StaticResource Cell}"/>
                            <TextBlock Grid.Column="3" Text="{Binding AvgWeight, StringFormat={}{0:N1} g, TargetNullValue=&#x2014;}" Style="{StaticResource Cell}"/>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding DeviationGrams, StringFormat={}{0:+0.0;-0.0;0.0} g, TargetNullValue=&#x2014;}" Style="{StaticResource Cell}"
                                           Foreground="{Binding DeviationSeverity, Converter={StaticResource SeverityBrush}}"/>
                                <TextBlock Text="{Binding DeviationPercent, StringFormat={}{0:+0.00;-0.00;0.00} %, TargetNullValue=''}" Style="{StaticResource Detail}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="{Binding GiveawayText}" Style="{StaticResource Cell}"
                                       Foreground="{Binding DeviationSeverity, Converter={StaticResource SeverityBrush}}"/>
                            <TextBlock Grid.Column="6" Text="{Binding TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;}" Style="{StaticResource Cell}"
                                       Foreground="{Binding TrsSeverity, Converter={StaticResource SeverityBrush}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Pas de production sur la période" Foreground="{DynamicResource SubtleTextBrush}"
                   FontSize="{Binding HeaderFontSize, ElementName=Root}" Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Weights.Count, ElementName=Root}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
