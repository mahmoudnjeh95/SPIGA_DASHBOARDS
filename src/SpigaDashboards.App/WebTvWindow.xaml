<Window x:Class="SpigaDashboards.App.WebTvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:Spiga.UI;assembly=Spiga.UI"
        Title="SPIGA Suivi Production - Écran TV" Icon="/Assets/spiga-logo.png"
        Width="960" Height="540" MinWidth="480" MinHeight="270"
        WindowStartupLocation="Manual" Background="{DynamicResource WindowBackgroundBrush}">
    <!-- The hall TV: the web Écran TV (Razor, Routes with Screen = "tv"), the
         slides of the whole plant without sign-in. Dragged onto the TV by its
         title bar; "Plein écran" (or F11) on the page fills that screen. -->
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
