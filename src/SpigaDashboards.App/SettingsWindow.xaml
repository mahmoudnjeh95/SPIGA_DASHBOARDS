<Window x:Class="SpigaDashboards.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels"
        mc:Ignorable="d"
        Title="Parametres" Height="760" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- Explicit ItemTemplate rather than DisplayMemberPath: the custom
             DarkComboBox template's SelectionBoxItemTemplate doesn't pick up
             DisplayMemberPath's auto-generated template reliably. -->
        <DataTemplate x:Key="TeamOptionTemplate" DataType="{x:Type vm:TeamOption}">
            <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Base de donnees" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="SQL Server (production)" GroupName="Provider"
                                 IsChecked="{Binding Provider, Converter={StaticResource EnumToBool}, ConverterParameter=SqlServer}"/>
                    <RadioButton Content="SQLite (dev)" GroupName="Provider"
                                 IsChecked="{Binding Provider, Converter={StaticResource EnumToBool}, ConverterParameter=Sqlite}"/>
                </StackPanel>

                <TextBlock Text="Serveur (hote\instance ou hote,port)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Base de donnees" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Authentification" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Windows" GroupName="Auth"
                                 IsChecked="{Binding AuthMode, Converter={StaticResource EnumToBool}, ConverterParameter=Windows}"/>
                    <RadioButton Content="Login SQL" GroupName="Auth"
                                 IsChecked="{Binding AuthMode, Converter={StaticResource EnumToBool}, ConverterParameter=SqlLogin}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding AuthMode, Converter={StaticResource SqlLoginVisibility}}">
                    <TextBlock Text="Utilisateur" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Mot de passe (laisser vide pour conserver l'actuel)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Tester la connexion" Style="{StaticResource SecondaryButton}"
                            Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"/>
                    <TextBlock Text="{Binding TestResultMessage}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{Binding TestResultSuccess, Converter={StaticResource TestResultBrush}}"/>
                </StackPanel>

                <Button Content="Ouvrir la console de diagnostic" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenConsoleCommand}"
                        ToolTip="Ouvre une fenetre independante affichant le journal des tentatives de connexion. La fermer n'affecte pas l'application."/>

                <TextBlock Text="Machines : nom affiche et visibilite" Style="{StaticResource SectionTitle}"/>
                <Button Content="Actualiser la liste" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Command="{Binding RefreshMachinesCommand}"/>
                <TextBlock Text="{Binding MachinesStatusMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding Machines}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MachineVisibilityOption}">
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="Afficher cette machine dans la rotation du tableau de bord"/>
                                <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Rotation et affichage" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Duree d'affichage par diapositive (secondes)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SlideDurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Frequence d'actualisation des donnees (minutes)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding DataRefreshIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Equipes (rotation sur les 3 postes)" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Cycle par defaut (aucun planning client fourni) : chaque equipe travaille 3 jours de suite sur un poste different, puis se repose 1 jour. A ajuster une fois le vrai planning connu."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <TextBlock Text="Nom des 4 equipes" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Team1Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Team2Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Team3Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Team4Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Date de reference du cycle (jour 1 de la ligne ci-dessous)" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding RotationStartDate}"/>

                <TextBlock Text="Planning du cycle : equipe par jour et par poste" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Matin (06-14)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Soir (14-22)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="Nuit (22-06)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding RosterDays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TeamRosterDayViewModel}">
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                    <Run Text="Jour "/>
                                    <Run Text="{Binding CycleDay, Mode=OneWay}"/>
                                </TextBlock>
                                <ComboBox Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Index" ItemTemplate="{StaticResource TeamOptionTemplate}"
                                          SelectedValue="{Binding MatinTeamIndex}"/>
                                <ComboBox Grid.Column="2" Margin="0,0,4,0" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Index" ItemTemplate="{StaticResource TeamOptionTemplate}"
                                          SelectedValue="{Binding SoirTeamIndex}"/>
                                <ComboBox Grid.Column="3" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Index" ItemTemplate="{StaticResource TeamOptionTemplate}"
                                          SelectedValue="{Binding NuitTeamIndex}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Jour" Style="{StaticResource SecondaryButton}" Command="{Binding AddRosterDayCommand}"/>
                    <Button Content="- Jour" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveRosterDayCommand}"/>
                </StackPanel>

                <TextBlock Text="Document externe (diapositive PDF)" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Consignes, instructions ou document qualite affiche en diapositive 8. Laisser vide pour ne pas afficher cette diapositive."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding PdfDocumentPath, UpdateSourceTrigger=PropertyChanged}" Width="360" IsReadOnly="True"/>
                    <Button Content="Parcourir..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding BrowsePdfDocumentCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding PdfDocumentStatus}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
