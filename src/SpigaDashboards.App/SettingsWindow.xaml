<Window x:Class="SpigaDashboards.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels"
        mc:Ignorable="d"
        Title="Paramètres" Icon="/Assets/spiga-logo.png" Height="800" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- Explicit ItemTemplate rather than DisplayMemberPath: the custom
             DarkComboBox template's SelectionBoxItemTemplate doesn't pick up
             DisplayMemberPath's auto-generated template reliably. -->
        <DataTemplate x:Key="TeamOptionTemplate" DataType="{x:Type vm:TeamOption}">
            <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
        <DataTemplate x:Key="MachineChoiceTemplate" DataType="{x:Type vm:MachineChoice}">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Les cadences, pauses, seuil d'arrêt, équipes, TRS cibles et la rotation des diapositives (ordre, affichage, durées) sont communs à tous les postes (enregistrés dans la base de données). Le reste ne concerne que ce poste."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="Base de données" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="SQL Server (production)" GroupName="Provider"
                                 IsChecked="{Binding Provider, Converter={StaticResource EnumToBool}, ConverterParameter=SqlServer}"/>
                    <RadioButton Content="SQLite (dev)" GroupName="Provider"
                                 IsChecked="{Binding Provider, Converter={StaticResource EnumToBool}, ConverterParameter=Sqlite}"/>
                </StackPanel>

                <TextBlock Text="Serveur (ex. NOM-DU-PC\SQLEXPRESS, ou adresse IP,port)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Nom de la base (Stiavelli : stats)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Authentification" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Windows" GroupName="Auth"
                                 IsChecked="{Binding AuthMode, Converter={StaticResource EnumToBool}, ConverterParameter=Windows}"/>
                    <RadioButton Content="Login SQL" GroupName="Auth"
                                 IsChecked="{Binding AuthMode, Converter={StaticResource EnumToBool}, ConverterParameter=SqlLogin}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding AuthMode, Converter={StaticResource SqlLoginVisibility}}">
                    <TextBlock Text="Utilisateur" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Mot de passe (laisser vide pour conserver l'actuel)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                </StackPanel>

                <Button Content="Tester la connexion" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"/>
                <TextBlock Text="{Binding TestResultMessage}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="{Binding TestResultSuccess, Converter={StaticResource TestResultBrush}}"/>

                <Button Content="Ouvrir la console de diagnostic" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenConsoleCommand}"
                        ToolTip="Ouvre une fenêtre indépendante affichant le journal des tentatives de connexion. La fermer n'affecte pas l'application."/>

                <TextBlock Text="Machines : nom affiché, visibilité et TRS cible" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="TRS cible (%) : objectif affiché à côté du TRS de chaque machine (vert si atteint, orange au-dessus de 75 % de la cible, rouge en dessous). Vide = 85 %."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button Content="Actualiser la liste" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Command="{Binding RefreshMachinesCommand}"/>
                <TextBlock Text="{Binding MachinesStatusMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                    <TextBlock Text="Nom affiché" Style="{StaticResource FieldLabel}" Width="250" Margin="0"/>
                    <TextBlock Text="TRS cible (%)" Style="{StaticResource FieldLabel}" Margin="0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MachineVisibilityOption}">
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="Afficher cette machine dans la rotation du tableau de bord"/>
                                <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                                <TextBox Text="{Binding TrsTargetText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="10,0,0,0"
                                         ToolTip="TRS cible de cette machine, en % (vide = 85 %)"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Affichage : rotation des diapositives" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Durée d'affichage par défaut d'une diapositive (secondes)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SlideDurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Fréquence d'actualisation des données (minutes)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding DataRefreshIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Alerte des arrêts" Style="{StaticResource FieldLabel}" Margin="0,12,0,2"/>
                <CheckBox IsChecked="{Binding ShowStopAlerts}" Content="Afficher l'alerte des arrêts non qualifiés (fenêtre rouge) sur ce PC"/>
                <CheckBox IsChecked="{Binding ResetStopAlertPosition}" Content="Remettre l'alerte à sa place (en haut à droite)" Margin="0,4,0,0"
                          IsEnabled="{Binding ShowStopAlerts}"/>
                <TextBlock Text="Propre à ce PC (l'écran TV peut la garder, un bureau la couper). L'alerte se déplace à la souris et garde sa place ; elle se ferme seule après 20 s ou avec sa croix, et revient pour un nouvel arrêt ou toutes les 30 min tant qu'un arrêt reste sans cause."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="Diapositives : ordre, affichage et durée" Style="{StaticResource FieldLabel}" Margin="0,12,0,2"/>
                <TextBlock Text="Commun à tous les postes. Décocher une diapositive la retire de la rotation (tableau de bord et écran TV). Les flèches changent sa place. Durée vide = durée par défaut ci-dessus. Une machine décochée dans la liste des machines n'apparaît nulle part, quel que soit ce réglage ; une nouvelle machine prend sa place par défaut."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Diapositive" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Durée (s)" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Slides}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SlideRowViewModel}">
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Position}" Foreground="{DynamicResource SubtleTextBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                          ToolTip="Afficher cette diapositive dans la rotation">
                                    <TextBlock Text="{Binding Label}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </CheckBox>
                                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEnabled}" ToolTip="Durée de cette diapositive en secondes (vide = durée par défaut)"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="&#x25B2;" AutomationProperties.Name="Monter" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0"
                                            ToolTip="Monter (passe plus tôt dans la rotation)"
                                            Command="{Binding DataContext.MoveSlideUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="&#x25BC;" AutomationProperties.Name="Descendre" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0"
                                            ToolTip="Descendre (passe plus tard dans la rotation)"
                                            Command="{Binding DataContext.MoveSlideDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Ordre par défaut" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        ToolTip="Rétablit l'ordre d'origine : toutes les diapositives affichées, durée par défaut"
                        Command="{Binding ResetSlidesCommand}"/>
                <TextBlock Text="{Binding SlidesStatusMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <TextBlock Text="Cadence nominale et sachet vide, par machine et par poids" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Cadence : vitesse idéale (sacs/min) de la machine pour ce poids de sac, sert au calcul de la Performance et du TRS. Sachet vide : poids de l'emballage vide (g), déduit du poids mesuré pour obtenir le poids net (poids moyen, écart, surpoids). Une production est associée à la ligne de SA machine pour le poids le plus proche de son poids cible (à 5 % près), sinon à la ligne « Toutes ». Cadence vide = TRS non calculé pour ce poids."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Machine" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Text="Poids (g)" Style="{StaticResource FieldLabel}" Margin="8,8,0,2"/>
                    <TextBlock Grid.Column="2" Text="Cadence (sacs/min)" Style="{StaticResource FieldLabel}" Margin="8,8,0,2"/>
                    <TextBlock Grid.Column="3" Text="Sachet vide (g)" Style="{StaticResource FieldLabel}" Margin="8,8,0,2"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding NominalRates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NominalRateRowViewModel}">
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding DataContext.MachineChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Id" ItemTemplate="{StaticResource MachineChoiceTemplate}"
                                          SelectedValue="{Binding MachineId}"/>
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="3" Margin="8,0,0,0" Text="{Binding TareText, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Dupliquer" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                            ToolTip="Copier cette ligne (par exemple pour une autre machine)"
                                            Command="{Binding DataContext.DuplicateNominalRateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                            Command="{Binding DataContext.RemoveNominalRateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Ligne" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Command="{Binding AddNominalRateCommand}"/>
                <TextBlock Text="{Binding NominalRatesStatusMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <TextBlock Text="Pauses planifiées et arrêts" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Pauses quotidiennes, communes à toutes les machines. Le temps où la ligne est à l'arrêt pendant une pause n'est pas compté dans la Disponibilité (ni le TRS), ni dans la liste des arrêts ; une ligne qui tourne pendant la pause garde ce temps de marche. Même règle pour les créneaux de maintenance et les arrêts de cause « Planifié » saisis dans Planification."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Début (hh:mm)" Style="{StaticResource FieldLabel}" Width="110"/>
                    <TextBlock Text="Durée (min)" Style="{StaticResource FieldLabel}" Margin="8,8,0,2"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding PlannedBreaks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PlannedBreakRowViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="8,0,0,0"/>
                                <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0"
                                        Command="{Binding DataContext.RemovePlannedBreakCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Pause" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Command="{Binding AddPlannedBreakCommand}"/>
                <TextBlock Text="Seuil d'arrêt (minutes) : tout arrêt du compteur au moins égal à cette durée, hors pauses, apparaît dans la fenêtre Arrêts et sur la fiche à imprimer"
                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                <TextBox Text="{Binding StopThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding BreaksStatusMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <TextBlock Text="Équipes (rotation sur les 3 postes)" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Cycle par défaut (aucun planning client fourni) : chaque équipe travaille 3 jours de suite sur un poste différent, puis se repose 1 jour. À ajuster une fois le vrai planning connu."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <TextBlock Text="Noms des 4 équipes" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Team1Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Team2Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Team3Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Team4Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Date de référence du cycle (jour 1 de la ligne ci-dessous)" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding RotationStartDate}"/>

                <TextBlock Text="Planning du cycle : équipe par jour et par poste" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Matin (06-14)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Après-midi (14-22)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="Nuit (22-06)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding RosterDays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TeamRosterDayViewModel}">
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                    <Run Text="Jour "/>
                                    <Run Text="{Binding CycleDay, Mode=OneWay}"/>
                                </TextBlock>
                                <ComboBox Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Index" ItemTemplate="{StaticResource TeamOptionTemplate}"
                                          SelectedValue="{Binding MatinTeamIndex}"/>
                                <ComboBox Grid.Column="2" Margin="0,0,4,0" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Index" ItemTemplate="{StaticResource TeamOptionTemplate}"
                                          SelectedValue="{Binding SoirTeamIndex}"/>
                                <ComboBox Grid.Column="3" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Index" ItemTemplate="{StaticResource TeamOptionTemplate}"
                                          SelectedValue="{Binding NuitTeamIndex}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Jour" Style="{StaticResource SecondaryButton}" Command="{Binding AddRosterDayCommand}"/>
                    <Button Content="- Jour" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveRosterDayCommand}"/>
                </StackPanel>

                <TextBlock Text="Document externe (diapositive PDF)" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Consignes, instructions ou document qualité affiché en diapositive (sa place se règle dans Affichage ci-dessus). Laisser vide pour ne pas afficher cette diapositive."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding PdfDocumentPath, UpdateSourceTrigger=PropertyChanged}" Width="360" IsReadOnly="True"/>
                    <Button Content="Parcourir…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding BrowsePdfDocumentCommand}"/>
                    <Button Content="Effacer" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            ToolTip="Ne plus afficher de document" Command="{Binding ClearPdfDocumentCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding PdfDocumentStatus}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
                <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
            <TextBlock Text="{Binding SharedSettingsMessage}" Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </DockPanel>
    </Grid>
</Window>
