<Window x:Class="SpigaDashboards.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Historique" Height="760" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Du" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding FromDate}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Au" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding ToDate}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Poste" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedShift}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="Equipe" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding TeamOptions}" SelectedItem="{Binding SelectedTeam}"/>
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                <TextBlock Text="Machine" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding MachineOptions}" SelectedItem="{Binding SelectedMachine}"/>
            </StackPanel>
            <Button Grid.Column="5" Content="Rechercher" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Bottom" Command="{Binding SearchCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0"/>

        <!-- Summary strip -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="0,14,0,10">
            <StackPanel>
                <TextBlock Text="Total sacs" Style="{StaticResource SummaryLabel}"/>
                <TextBlock Text="{Binding Summary.TotalBags}" Style="{StaticResource SummaryValue}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Conformes" Style="{StaticResource SummaryLabel}"/>
                <TextBlock Text="{Binding Summary.BagsInTolerance}" Style="{StaticResource SummaryValue}" Foreground="{DynamicResource SuccessBrush}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Eleves" Style="{StaticResource SummaryLabel}"/>
                <TextBlock Text="{Binding Summary.BagsOverTolerance}" Style="{StaticResource SummaryValue}" Foreground="{DynamicResource DangerBrush}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Faibles" Style="{StaticResource SummaryLabel}"/>
                <TextBlock Text="{Binding Summary.BagsUnderTolerance}" Style="{StaticResource SummaryValue}" Foreground="{DynamicResource WarningBrush}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Taux conformite" Style="{StaticResource SummaryLabel}"/>
                <TextBlock Text="{Binding Summary.QualityPercent, StringFormat={}{0}%}" Style="{StaticResource SummaryValue}"/>
            </StackPanel>
        </UniformGrid>

        <!-- Results -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="{DynamicResource TileBackgroundBrush}" RowBackground="{DynamicResource TileBackgroundBrush}" AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date/Heure" Binding="{Binding StartTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="Machine" Binding="{Binding MachineId}" Width="80"/>
                <DataGridTextColumn Header="Poste" Binding="{Binding ShiftName}" Width="70"/>
                <DataGridTextColumn Header="Equipe" Binding="{Binding Team}" Width="90"/>
                <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="140"/>
                <DataGridTextColumn Header="Cible (g)" Binding="{Binding TargetNetWeight}" Width="70"/>
                <DataGridTextColumn Header="Moyen (g)" Binding="{Binding AvgWeight}" Width="80"/>
                <DataGridTextColumn Header="Sacs" Binding="{Binding TotalBags}" Width="60"/>
                <DataGridTextColumn Header="Conformes" Binding="{Binding BagsInTolerance}" Width="80"/>
                <DataGridTextColumn Header="Eleves" Binding="{Binding BagsOverTolerance}" Width="60"/>
                <DataGridTextColumn Header="Faibles" Binding="{Binding BagsUnderTolerance}" Width="60"/>
                <DataGridTextColumn Header="OK" Binding="{Binding IsConform}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Exporter Excel" Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelCommand}"/>
            <Button Content="Exporter PDF" Style="{StaticResource SecondaryButton}" Command="{Binding ExportPdfCommand}"/>
            <Button Content="Fermer" Style="{StaticResource PrimaryButton}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
