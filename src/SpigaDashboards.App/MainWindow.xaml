<Window x:Class="SpigaDashboards.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SpigaDashboards.App.Converters"
        xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels"
        xmlns:slides="clr-namespace:SpigaDashboards.App.ViewModels.Slides"
        xmlns:views="clr-namespace:SpigaDashboards.App.Views"
        mc:Ignorable="d"
        Title="SPIGA Dashboards" Icon="/Assets/spiga-logo.png" Height="800" Width="1280"
        WindowState="Maximized"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/SlideTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Filter bar: segmented buttons, captions, separators, drop-downs. -->
            <Style x:Key="Seg" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="8" Padding="9,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DropToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="6" Padding="11,5">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BarCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2,0,0,3"/>
            </Style>
            <Style x:Key="BarSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="8,4,8,0"/>
                <Setter Property="Fill" Value="{DynamicResource AppBorderBrush}"/>
            </Style>
            <Style x:Key="DropPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Fixed 1600x900 design canvas, scaled to fill whatever the kiosk screen's
         resolution actually is, so the whole dashboard is always visible with
         no scrolling, clipping, or hovering required. -->
    <Viewbox Stretch="Fill">
    <Grid Width="1600" Height="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: current team/poste, slide navigation, theme toggle, history, settings -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/spiga-logo.png" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SPIGA Dashboards" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <!-- Hidden over the consignes PDF slide. -->
                <!-- Team / poste: pops, glows and flips over at a poste change. -->
                <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="12" Padding="12,4" Margin="16,0,0,0"
                        views:SlideMotion.Announce="{Binding CurrentTeamLabel}"
                        Visibility="{Binding IsPdfSlideShown, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource LiveDot}" Margin="0,0,9,0"/>
                        <TextBlock Text="{Binding CurrentTeamLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- DB connection lost: always-reachable reconnect, even over a slide -->
                <Border Background="{DynamicResource DangerBrush}" CornerRadius="12" Padding="12,2,4,2" Margin="12,0,0,0"
                        Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Base déconnectée" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="TopBarReconnectButton" Content="Reconnecter" Padding="10,3" Margin="10,0,0,0"
                                Background="White" Foreground="#1B1F26" BorderThickness="0"
                                Command="{Binding ReconnectCommand}"
                                IsEnabled="{Binding IsReconnecting, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Opens the dashboard-only window to drag onto the production TV. -->
            <Button x:Name="TvScreenButton" Grid.Column="1" Content="Écran TV" Margin="12,0,0,0" Style="{StaticResource AccentBarButton}"
                    ToolTip="Ouvrir le tableau de bord seul, à glisser sur l'écran TV (double-clic : plein écran)"
                    Click="TvScreenButton_Click"/>

            <!-- Manual slide navigation + auto-rotation play/pause -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Précédent" Padding="12,6" Command="{Binding PreviousSlideCommand}"
                        Style="{StaticResource BarButton}"/>
                <Button Padding="12,6" Margin="6,0,0,0" Command="{Binding ToggleRotationCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                            <Setter Property="Content" Value="Pause"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRotationPaused}" Value="True">
                                    <Setter Property="Content" Value="Lecture"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Suivant" Padding="12,6" Margin="6,0,0,0" Command="{Binding NextSlideCommand}"
                        Style="{StaticResource BarButton}"/>
            </StackPanel>

            <Button x:Name="ThemeToggleButton" Grid.Column="3" Margin="12,0,0,0" Padding="12,6"
                    Style="{StaticResource BarButton}"
                    Click="ThemeToggleButton_Click"/>

            <Button Grid.Column="4" Content="Historique" Margin="12,0,0,0" Padding="12,6"
                    Style="{StaticResource BarButton}"
                    Click="HistoryButton_Click"/>

            <Button Grid.Column="5" Content="Arrêts" Margin="12,0,0,0" Padding="12,6"
                    ToolTip="Arrêts de production par poste et par équipe, fiche à imprimer"
                    Style="{StaticResource BarButton}"
                    Click="StopsButton_Click"/>

            <!-- Pannes (causes of the stops), statistics, week planning and preventive maintenance. -->
            <Button Grid.Column="6" Content="Planification" Margin="12,0,0,0"
                    ToolTip="Pannes à qualifier, statistiques des pannes, planning de la semaine et maintenance préventive"
                    Style="{StaticResource BarButton}"
                    Click="PlanningButton_Click"/>

            <Button x:Name="SettingsButton" Grid.Column="7" Content="Paramètres" Margin="12,0,0,0" Padding="12,6"
                    Style="{StaticResource BarButton}"
                    Click="SettingsButton_Click"/>

            <Button Grid.Column="8" Content="À propos" Margin="12,0,0,0" Padding="12,6"
                    ToolTip="Version de l'application et informations"
                    Style="{StaticResource BarButton}"
                    Click="AboutButton_Click"/>
        </Grid>

        <!-- Filter bar: always visible, so the screen says what it shows. Every
             click applies on its own; "Effacer" puts everything back. -->
        <Border Grid.Row="1" Margin="20,0,20,0" Padding="12,6" CornerRadius="12" Background="{DynamicResource TileBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#x2715; Effacer" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Bottom" BorderThickness="0"
                        ToolTip="Revenir à aujourd'hui, toutes les machines, sans filtre"
                        Background="{DynamicResource DangerBrush}" Foreground="White"
                        Command="{Binding ResetFiltersCommand}"
                        Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="PÉRIODE" Style="{StaticResource BarCaption}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Period" Content="Aujourd'hui" Style="{StaticResource Seg}"
                                         IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBool}, ConverterParameter=Day}"/>
                            <RadioButton GroupName="Period" Content="Poste préc." Style="{StaticResource Seg}" ToolTip="Poste précédent"
                                         IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBool}, ConverterParameter=PreviousShift}"/>
                            <RadioButton GroupName="Period" Content="Hier" Style="{StaticResource Seg}"
                                         IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBool}, ConverterParameter=Yesterday}"/>
                            <RadioButton GroupName="Period" Content="Semaine" Style="{StaticResource Seg}"
                                         IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBool}, ConverterParameter=Week}"/>
                            <RadioButton GroupName="Period" Content="Mois" Style="{StaticResource Seg}"
                                         IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBool}, ConverterParameter=Month}"/>
                            <RadioButton GroupName="Period" Content="3 mois" Style="{StaticResource Seg}"
                                         IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBool}, ConverterParameter=ThreeMonths}"/>
                            <RadioButton x:Name="CustomPeriodButton" GroupName="Period" Content="{Binding CustomRangeLabel}" Style="{StaticResource Seg}"
                                         Command="{Binding OpenDatePickerCommand}"
                                         IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBool}, ConverterParameter=Custom}"/>
                        </StackPanel>
                        <!-- StaysOpen: the DatePicker calendars are popups of their own. -->
                        <Popup IsOpen="{Binding IsDatePickerOpen}" PlacementTarget="{Binding ElementName=CustomPeriodButton}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Style="{StaticResource DropPanel}">
                                <StackPanel>
                                    <TextBlock Text="Choisir la période" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Du" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <DatePicker Width="150" SelectedDate="{Binding CustomFrom}"/>
                                        <TextBlock Text="au" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <DatePicker Width="150" SelectedDate="{Binding CustomTo}"/>
                                    </StackPanel>
                                    <Button Content="OK" HorizontalAlignment="Right" Padding="18,5" Margin="0,10,0,0" BorderThickness="0"
                                            Background="{DynamicResource AccentBrush}" Foreground="White" Command="{Binding CloseDatePickerCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Rectangle Style="{StaticResource BarSeparator}"/>
                    <StackPanel>
                        <TextBlock Text="SECTEUR" Style="{StaticResource BarCaption}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Sector" Content="Tous" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterSector, Converter={StaticResource ValueToBool}, ConverterParameter=Tous}"/>
                            <RadioButton GroupName="Sector" Content="Couscous" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterSector, Converter={StaticResource ValueToBool}, ConverterParameter=Couscous}"/>
                            <RadioButton GroupName="Sector" Content="Pâte courte" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterSector, Converter={StaticResource ValueToBool}, ConverterParameter='Pate courte'}"/>
                            <RadioButton GroupName="Sector" Content="Pâte longue" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterSector, Converter={StaticResource ValueToBool}, ConverterParameter='Pate longue'}"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource BarSeparator}"/>
                    <StackPanel>
                        <TextBlock Text="MACHINES" Style="{StaticResource BarCaption}"/>
                        <ToggleButton x:Name="MachinePickerToggle" Style="{StaticResource DropToggle}" MinWidth="120"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=MachinePickerPopup, Converter={StaticResource InverseBool}}">
                            <TextBlock>
                                <Run Text="{Binding MachineFilterLabel, Mode=OneWay}"/><Run Text="  &#x25BE;"/>
                            </TextBlock>
                        </ToggleButton>
                        <Popup x:Name="MachinePickerPopup" IsOpen="{Binding IsChecked, ElementName=MachinePickerToggle}"
                               PlacementTarget="{Binding ElementName=MachinePickerToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource DropPanel}" MinWidth="240">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding MachineOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MachineFilterOption}">
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}">
                                                    <TextBlock Text="{Binding MachineName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Toutes les machines" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0" BorderThickness="0"
                                            Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                            Command="{Binding SelectAllMachinesCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Rectangle Style="{StaticResource BarSeparator}"/>
                    <StackPanel>
                        <TextBlock Text="POSTE" Style="{StaticResource BarCaption}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Shift" Content="Tous" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterShift, Converter={StaticResource ValueToBool}, ConverterParameter=Tous}"/>
                            <RadioButton GroupName="Shift" Content="Matin" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterShift, Converter={StaticResource ValueToBool}, ConverterParameter=Matin}"/>
                            <RadioButton GroupName="Shift" Content="Après-midi" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterShift, Converter={StaticResource ValueToBool}, ConverterParameter=Après-midi}"/>
                            <RadioButton GroupName="Shift" Content="Nuit" Style="{StaticResource Seg}"
                                         IsChecked="{Binding FilterShift, Converter={StaticResource ValueToBool}, ConverterParameter=Nuit}"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource BarSeparator}"/>
                    <StackPanel>
                        <TextBlock Text="ÉQUIPE" Style="{StaticResource BarCaption}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" Width="110" Padding="8,4" FontSize="14"
                                  ItemsSource="{Binding TeamOptions}" SelectedItem="{Binding FilterTeam}"/>
                    </StackPanel>

                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="POIDS" Style="{StaticResource BarCaption}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" Width="95" Padding="8,4" FontSize="14"
                                  ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding FilterWeight}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Slide content: swaps DataTemplate based on the current slide's view-model type -->
        <ContentControl Grid.Row="2" Margin="14,8,14,10" Content="{Binding CurrentSlide}"
                        views:SlideMotion.Transition="{Binding SlideChangeCount}"
                        views:SlideMotion.Scope="{Binding SlideScope}"/>

        <!-- Time left on this slide: fills up to the next auto-advance, hidden while paused. -->
        <Border Grid.Row="2" Height="3" Margin="22,2,22,0" VerticalAlignment="Top" CornerRadius="1.5"
                Background="{DynamicResource AccentSoftBrush}" IsHitTestVisible="False"
                Visibility="{Binding IsRotationPaused, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="1.5"
                    views:SlideMotion.Seconds="{Binding SlideSeconds}"
                    views:SlideMotion.Paused="{Binding IsRotationPaused}"
                    views:SlideMotion.Timer="{Binding RotationCycle}"/>
        </Border>

        <!-- Stop pop-up: lines stopped with no cause yet (MainViewModel.StopAlerts). -->
        <views:StopAlertPopup x:Name="StopAlert" Grid.Row="2"/>

        <!-- Loading motion over the slide, when a load lasts -->
        <views:PastaLoader Grid.Row="2" IsActive="{Binding ShowLoading}" Background="{DynamicResource LoadingVeilBrush}"/>

        <!-- Persistent sticky note bar (never rotates away). Editable in place by whoever's at the kiosk.
             Deliberately a fixed yellow "sticky note" look in both themes, not a themed neutral surface. -->
        <Border Grid.Row="3" Background="#F1C40F" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NoteTextBox" Grid.Column="0"
                         Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" FontWeight="SemiBold" Foreground="#1B1F26" Background="Transparent"
                         BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Center"
                         GotKeyboardFocus="NoteTextBox_GotFocus" LostKeyboardFocus="NoteTextBox_LostFocus"/>

                <TextBlock Grid.Column="1" Text="{Binding NoteSaveStatus}" Foreground="#1B1F26"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="2" Content="Enregistrer" Padding="12,6"
                        Background="#1B1F26" Foreground="White" BorderThickness="0"
                        Command="{Binding SaveNoteCommand}"/>
            </Grid>
        </Border>

        <!-- Disconnected overlay: covers the content area (not the note bar) while the DB is unreachable -->
        <Border Grid.Row="2" Background="{DynamicResource DisconnectedOverlayBrush}"
                Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
                <TextBlock Text="Connexion à la base de données perdue" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ConnectionErrorMessage}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ReconnectStatus}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Reconnecter" Padding="18,10" Margin="0,0,10,0" Style="{StaticResource AccentBarButton}"
                            Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding IsReconnecting, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Paramètres" Padding="18,10"
                            Style="{StaticResource BarButton}"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
    </Viewbox>
</Window>
