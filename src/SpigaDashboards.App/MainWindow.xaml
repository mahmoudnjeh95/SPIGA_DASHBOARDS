<Window x:Class="SpigaDashboards.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SpigaDashboards.App.Converters"
        xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels"
        xmlns:slides="clr-namespace:SpigaDashboards.App.ViewModels.Slides"
        xmlns:views="clr-namespace:SpigaDashboards.App.Views"
        mc:Ignorable="d"
        Title="SPIGA Dashboards" Icon="/Assets/spiga-logo.png" Height="800" Width="1280"
        WindowState="Maximized"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <!-- "Aujourd'hui" / "Poste precedent": one machine, one poste in full + earlier postes of the day. -->
        <DataTemplate DataType="{x:Type slides:MachineDaySlideViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SectorLabel}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="16,4,16,0"/>

                <views:MachineDayPanel Grid.Row="1"/>
            </Grid>
        </DataTemplate>

        <!-- Hier / semaine / mois / 3 mois / dates choisies: one machine, period totals. -->
        <DataTemplate DataType="{x:Type slides:MachinePeriodSlideViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SectorLabel}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="16,4,16,0"/>

                <views:MachinePeriodPanel Grid.Row="1"/>
            </Grid>
        </DataTemplate>

        <!-- Slide 8: admin-selected external PDF (consignes, instructions, documents qualite). -->
        <DataTemplate DataType="{x:Type slides:PdfSlideViewModel}">
            <Grid>
                <Image Source="{Binding PageImage}" Stretch="Uniform"
                       Visibility="{Binding PageImage, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="700"
                           Visibility="{Binding PageImage, Converter={StaticResource InverseNullToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- Synthesis per sector: lines and their weights over month / 3 months / year. -->
        <DataTemplate DataType="{x:Type slides:SynthesisSlideViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <!-- Highlights the button of the period shown. -->
                    <Style x:Key="PeriodButton" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                        <Setter Property="Command" Value="{Binding DataContext.SetSynthesisPeriodCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                </Grid.Resources>

                <Grid Grid.Row="0" Margin="16,6,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="Synthese - "/><Run Text="{Binding SectorLabel, Mode=OneWay}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                        <Run Text=" · "/><Run Text="{Binding PeriodLabel, Mode=OneWay}"/>
                        <Run Text="  ·  TRS secteur " FontSize="18"/><Run Text="{Binding SectorKpis.TrsPercent, StringFormat={}{0:0.0}%, TargetNullValue=&#x2014;, Mode=OneWay, ConverterCulture=fr-FR}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Run Text="  ·  Production " FontSize="18"/><Run Text="{Binding SectorProductionText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Run Text="{Binding FilterSuffix, Mode=OneWay}" FontSize="16"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Ce mois" Tag="Month">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Period}" Value="Month">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="3 derniers mois" Tag="ThreeMonths">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Period}" Value="ThreeMonths">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Annee" Tag="Year">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Period}" Value="Year">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <views:SynthesisPanel Grid.Row="1"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Fixed 1600x900 design canvas, scaled to fill whatever the kiosk screen's
         resolution actually is, so the whole dashboard is always visible with
         no scrolling, clipping, or hovering required. -->
    <Viewbox Stretch="Fill">
    <Grid Width="1600" Height="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: current team/poste, period selector, theme toggle, history, settings -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/spiga-logo.png" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SPIGA Dashboards" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <!-- Hidden over the consignes PDF slide. -->
                <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="12" Padding="12,4" Margin="16,0,0,0"
                        Visibility="{Binding IsPdfSlideShown, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding CurrentTeamLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Border>

                <!-- DB connection lost: always-reachable reconnect, even over a slide -->
                <Border Background="{DynamicResource DangerBrush}" CornerRadius="12" Padding="12,2,4,2" Margin="12,0,0,0"
                        Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Base deconnectee" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="TopBarReconnectButton" Content="Reconnecter" Padding="10,3" Margin="10,0,0,0"
                                Background="White" Foreground="#1B1F26" BorderThickness="0"
                                Command="{Binding ReconnectCommand}"
                                IsEnabled="{Binding IsReconnecting, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="160" SelectedValue="{Binding SelectedPeriod}" SelectedValuePath="Tag" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Aujourd'hui" Tag="{x:Static vm:DashboardPeriod.Day}"/>
                    <ComboBoxItem Content="Poste precedent" Tag="{x:Static vm:DashboardPeriod.PreviousShift}"/>
                    <ComboBoxItem Content="Hier" Tag="{x:Static vm:DashboardPeriod.Yesterday}"/>
                    <ComboBoxItem Content="Cette semaine" Tag="{x:Static vm:DashboardPeriod.Week}"/>
                    <ComboBoxItem Content="Ce mois" Tag="{x:Static vm:DashboardPeriod.Month}"/>
                    <ComboBoxItem Content="3 derniers mois" Tag="{x:Static vm:DashboardPeriod.ThreeMonths}"/>
                    <ComboBoxItem Content="Dates choisies" Tag="{x:Static vm:DashboardPeriod.Custom}"/>
                </ComboBox>
                <!-- Filtres: accent colour while a filter is active -->
                <Button x:Name="FilterButton" Padding="12,6" Margin="8,0,0,0" BorderThickness="0" Command="{Binding ToggleFilterPanelCommand}"
                        ToolTip="{Binding ActiveFilterLabel}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Filtres"/>
                            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content" Value="Filtres (actifs)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Manual slide navigation + auto-rotation play/pause -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Precedent" Padding="12,6" Command="{Binding PreviousSlideCommand}"
                        Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"/>
                <Button Padding="12,6" Margin="6,0,0,0" Command="{Binding ToggleRotationCommand}"
                        Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Pause"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRotationPaused}" Value="True">
                                    <Setter Property="Content" Value="Lecture"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Suivant" Padding="12,6" Margin="6,0,0,0" Command="{Binding NextSlideCommand}"
                        Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"/>
            </StackPanel>

            <Button x:Name="ThemeToggleButton" Grid.Column="3" Margin="12,0,0,0" Padding="12,6"
                    Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                    Click="ThemeToggleButton_Click"/>

            <Button Grid.Column="4" Content="Historique" Margin="12,0,0,0" Padding="12,6"
                    Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                    Click="HistoryButton_Click"/>

            <Button Grid.Column="5" Content="Parametres" Margin="12,0,0,0" Padding="12,6"
                    Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                    Click="SettingsButton_Click"/>
        </Grid>

        <!-- Slide content: swaps DataTemplate based on the current slide's view-model type -->
        <ContentControl Grid.Row="1" Margin="14" Content="{Binding CurrentSlide}"/>

        <!-- Persistent sticky note bar (never rotates away). Editable in place by whoever's at the kiosk.
             Deliberately a fixed yellow "sticky note" look in both themes, not a themed neutral surface. -->
        <Border Grid.Row="2" Background="#F1C40F" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NoteTextBox" Grid.Column="0"
                         Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" FontWeight="SemiBold" Foreground="#1B1F26" Background="Transparent"
                         BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Center"
                         GotKeyboardFocus="NoteTextBox_GotFocus" LostKeyboardFocus="NoteTextBox_LostFocus"/>

                <TextBlock Grid.Column="1" Text="{Binding NoteSaveStatus}" Foreground="#1B1F26"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="2" Content="Enregistrer" Padding="12,6"
                        Background="#1B1F26" Foreground="White" BorderThickness="0"
                        Command="{Binding SaveNoteCommand}"/>
            </Grid>
        </Border>

        <!-- Disconnected overlay: covers the content area (not the note bar) while the DB is unreachable -->
        <Border Grid.Row="1" Background="{DynamicResource DisconnectedOverlayBrush}"
                Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
                <TextBlock Text="Connexion a la base de donnees perdue" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ConnectionErrorMessage}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ReconnectStatus}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Reconnecter" Padding="18,10" Margin="0,0,10,0"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding IsReconnecting, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Parametres" Padding="18,10"
                            Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filtres panel (top-bar button): applies to every slide and is taken over by Historique. -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="620" Margin="0,0,20,0"
                Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="18,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFilterPanelOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Filtres" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Dates (periode &quot;Dates choisies&quot;)" Style="{StaticResource FilterLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Du" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker Width="170" SelectedDate="{Binding CustomFrom}"/>
                    <TextBlock Text="au" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <DatePicker Width="170" SelectedDate="{Binding CustomTo}"/>
                </StackPanel>

                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Secteur" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding SectorOptions}" SelectedItem="{Binding FilterSector}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Poids / produit" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding FilterWeight}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Poste" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding FilterShift}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Equipe" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding TeamOptions}" SelectedItem="{Binding FilterTeam}"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Machines (decocher pour les retirer de la rotation)" Style="{StaticResource FilterLabel}"/>
                <ItemsControl ItemsSource="{Binding MachineOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MachineFilterOption}">
                            <CheckBox Content="{Binding MachineId}" IsChecked="{Binding IsSelected}" Width="96" Margin="0,3"
                                      Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Reinitialiser" Padding="14,6" Margin="0,0,8,0" BorderThickness="0"
                            Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                            Command="{Binding ResetFiltersCommand}"/>
                    <Button Content="Fermer" Padding="14,6" Margin="0,0,8,0" BorderThickness="0"
                            Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                            Command="{Binding ToggleFilterPanelCommand}"/>
                    <Button Content="Appliquer" Padding="14,6" BorderThickness="0"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            Command="{Binding ApplyFiltersCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Viewbox>
</Window>
