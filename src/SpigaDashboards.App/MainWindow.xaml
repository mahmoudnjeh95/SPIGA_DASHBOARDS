<Window x:Class="SpigaDashboards.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SpigaDashboards.App.Converters"
        xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels"
        xmlns:slides="clr-namespace:SpigaDashboards.App.ViewModels.Slides"
        xmlns:views="clr-namespace:SpigaDashboards.App.Views"
        mc:Ignorable="d"
        Title="SPIGA Dashboards" Icon="/Assets/spiga-logo.png" Height="800" Width="1280"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- One or two MachinePanel views side by side under the sector name. -->
        <DataTemplate DataType="{x:Type slides:MachinePairSlideViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SectorLabel}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="16,8,16,0"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <views:MachinePanel Grid.Column="0" DataContext="{Binding Primary}"/>

                    <!-- Divider between the two machines: only shown when there's
                         actually a second machine (odd-one-out sectors show just one). -->
                    <Border Grid.Column="1" Width="1" Margin="0,20" Background="{DynamicResource AppBorderBrush}"
                            Visibility="{Binding Secondary, Converter={StaticResource NullToVisibility}}"/>

                    <Border Grid.Column="2" Visibility="{Binding Secondary, Converter={StaticResource NullToVisibility}}">
                        <views:MachinePanel DataContext="{Binding Secondary}"/>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Slide 8: admin-selected external PDF (consignes, instructions, documents qualite). -->
        <DataTemplate DataType="{x:Type slides:PdfSlideViewModel}">
            <Grid>
                <Image Source="{Binding PageImage}" Stretch="Uniform"
                       Visibility="{Binding PageImage, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="700"
                           Visibility="{Binding PageImage, Converter={StaticResource InverseNullToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- Slides 9-13: annual synthesis (cumul mensuel + graphiques) per sector. -->
        <DataTemplate DataType="{x:Type slides:AnnualSummarySlideViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="16,8,16,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="Synthese annuelle - "/>
                    <Run Text="{Binding SectorLabel}"/>
                    <Run Text=" ("/>
                    <Run Text="{Binding Year}"/>
                    <Run Text=")"/>
                </TextBlock>

                <views:AnnualSummaryPanel Grid.Row="1"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Fixed 1600x900 design canvas, scaled to fill whatever the kiosk screen's
         resolution actually is, so the whole dashboard is always visible with
         no scrolling, clipping, or hovering required. -->
    <Viewbox Stretch="Fill">
    <Grid Width="1600" Height="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: current team/poste, period selector, theme toggle, history, settings -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/spiga-logo.png" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SPIGA Dashboards" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="12" Padding="12,4" Margin="16,0,0,0">
                    <TextBlock Text="{Binding CurrentTeamLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Border>

                <!-- DB connection lost: always-reachable reconnect, even over a slide -->
                <Border Background="{DynamicResource DangerBrush}" CornerRadius="12" Padding="12,2,4,2" Margin="12,0,0,0"
                        Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Base deconnectee" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="TopBarReconnectButton" Content="Reconnecter" Padding="10,3" Margin="10,0,0,0"
                                Background="White" Foreground="#1B1F26" BorderThickness="0"
                                Command="{Binding ReconnectCommand}"
                                IsEnabled="{Binding IsReconnecting, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ComboBox Grid.Column="1" Width="140" SelectedValue="{Binding SelectedPeriod}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="Aujourd'hui" Tag="{x:Static vm:DashboardPeriod.Day}"/>
                <ComboBoxItem Content="Cette semaine" Tag="{x:Static vm:DashboardPeriod.Week}"/>
                <ComboBoxItem Content="Ce mois" Tag="{x:Static vm:DashboardPeriod.Month}"/>
            </ComboBox>

            <!-- Manual slide navigation + auto-rotation play/pause -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Precedent" Padding="12,6" Command="{Binding PreviousSlideCommand}"
                        Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"/>
                <Button Padding="12,6" Margin="6,0,0,0" Command="{Binding ToggleRotationCommand}"
                        Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Pause"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRotationPaused}" Value="True">
                                    <Setter Property="Content" Value="Lecture"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Suivant" Padding="12,6" Margin="6,0,0,0" Command="{Binding NextSlideCommand}"
                        Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"/>
            </StackPanel>

            <Button x:Name="ThemeToggleButton" Grid.Column="3" Margin="12,0,0,0" Padding="12,6"
                    Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                    Click="ThemeToggleButton_Click"/>

            <Button Grid.Column="4" Content="Historique" Margin="12,0,0,0" Padding="12,6"
                    Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                    Click="HistoryButton_Click"/>

            <Button Grid.Column="5" Content="Parametres" Margin="12,0,0,0" Padding="12,6"
                    Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                    Click="SettingsButton_Click"/>
        </Grid>

        <!-- Slide content: swaps DataTemplate based on the current slide's view-model type -->
        <ContentControl Grid.Row="1" Margin="14" Content="{Binding CurrentSlide}"/>

        <!-- Persistent sticky note bar (never rotates away). Editable in place by whoever's at the kiosk.
             Deliberately a fixed yellow "sticky note" look in both themes, not a themed neutral surface. -->
        <Border Grid.Row="2" Background="#F1C40F" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NoteTextBox" Grid.Column="0"
                         Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" FontWeight="SemiBold" Foreground="#1B1F26" Background="Transparent"
                         BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Center"
                         GotKeyboardFocus="NoteTextBox_GotFocus" LostKeyboardFocus="NoteTextBox_LostFocus"/>

                <TextBlock Grid.Column="1" Text="{Binding NoteSaveStatus}" Foreground="#1B1F26"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="2" Content="Enregistrer" Padding="12,6"
                        Background="#1B1F26" Foreground="White" BorderThickness="0"
                        Command="{Binding SaveNoteCommand}"/>
            </Grid>
        </Border>

        <!-- Disconnected overlay: covers the content area (not the note bar) while the DB is unreachable -->
        <Border Grid.Row="1" Background="{DynamicResource DisconnectedOverlayBrush}"
                Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
                <TextBlock Text="Connexion a la base de donnees perdue" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ConnectionErrorMessage}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ReconnectStatus}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Reconnecter" Padding="18,10" Margin="0,0,10,0"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding IsReconnecting, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Parametres" Padding="18,10"
                            Background="{DynamicResource SecondaryButtonBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Viewbox>
</Window>
