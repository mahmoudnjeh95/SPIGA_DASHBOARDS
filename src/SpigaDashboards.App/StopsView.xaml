<!-- Arrêts de production: shown in the main window of SPIGA Suivi Production
     (Maintenance > Arrêts) and, in kiosk mode, in StopsWindow. It was
     StopsWindow's content until v1.5.26. -->
<UserControl x:Class="SpigaDashboards.App.StopsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpigaDashboards.App.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:SpigaDashboards.App.ViewModels"
        xmlns:svc="clr-namespace:SpigaDashboards.App.Services;assembly=SpigaDashboards.Production"
        mc:Ignorable="d"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Same top bar as the other pages beside the menu: the title. No
         "Fermer": the menu (or the window's ✕ in kiosk mode) does it. -->
    <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1" Padding="22,12">
        <DockPanel>
            <TextBlock Text="Arrêts de production" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
        </DockPanel>
    </Border>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Du" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding FromDate}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Au" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding ToDate}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Machine" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding MachineOptions}" SelectedItem="{Binding SelectedMachine}"
                          DisplayMemberPath="Label"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="Poste" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedShift}"/>
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                <TextBlock Text="Équipe" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding TeamOptions}" SelectedItem="{Binding SelectedTeam}"
                          IsEnabled="{Binding IsTeamFree}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="Votre compte est rattaché à cette équipe : seuls ses postes vous concernent"/>
            </StackPanel>
            <Button Grid.Column="5" Content="Rechercher" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                    Command="{Binding SearchCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource WarningBrush}"/>
            <TextBlock Text="{Binding SettingsText}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Totals per team -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding TeamTotals}" Margin="0,12,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:TeamStopTotal}">
                    <Border Background="{DynamicResource TileBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,10,0" MinWidth="170">
                        <StackPanel>
                            <TextBlock Text="{Binding Team}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold">
                                <Run Text="{Binding TotalText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}" FontSize="11">
                                <Run Text="{Binding Count, Mode=OneWay}"/>
                                <Run Text="arrêt(s), hors « Sans données » :"/>
                                <Run Text="{Binding StopText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- One row per stop and poste -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="{DynamicResource TileBackgroundBrush}" RowBackground="{DynamicResource TileBackgroundBrush}" AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding ShiftDate, StringFormat={}{0:ddd dd/MM/yyyy}}" Width="110"/>
                <DataGridTextColumn Header="Poste" Binding="{Binding ShiftName}" Width="75"/>
                <DataGridTextColumn Header="Équipe" Binding="{Binding Team}" Width="80"/>
                <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="125"/>
                <DataGridTextColumn Header="Début" Binding="{Binding Start, StringFormat={}{0:HH:mm}}" Width="55"/>
                <DataGridTextColumn Header="Fin" Binding="{Binding EndText}" Width="65"/>
                <DataGridTextColumn Header="Durée" Binding="{Binding DurationText}" Width="70"/>
                <DataGridTextColumn Header="Pause déduite" Binding="{Binding BreakText}" Width="95"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="120"/>
                <!-- Cause given in the Planification window, in its family's colour. -->
                <DataGridTemplateColumn Header="Cause" Width="175">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding CauseFamily, Converter={StaticResource CauseFamilyBrush}}"/>
                                <TextBlock Text="{Binding CauseLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Détail" Binding="{Binding DetailText}" Width="*" MinWidth="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading motion over the results while the search runs -->
        <views:PastaLoader Grid.Row="3" IsActive="{Binding IsBusy}" Text="Recherche en cours…" Background="{DynamicResource LoadingVeilBrush}"/>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Imprimer la fiche des arrêts (PDF)" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}"
                        Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Une page par poste et par équipe, avec les colonnes « Cause » et « Action » à remplir à la main"/>
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
    </DockPanel>
</UserControl>
