<Application x:Class="SpigaDashboards.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpigaDashboards.App"
             xmlns:conv="clr-namespace:SpigaDashboards.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <conv:ValueToBoolConverter x:Key="ValueToBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:TestResultBrushConverter x:Key="TestResultBrush"/>
        <conv:SqlLoginVisibilityConverter x:Key="SqlLoginVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility"/>
        <conv:CauseFamilyBrushConverter x:Key="CauseFamilyBrush"/>
        <conv:PercentBandBrushConverter x:Key="PercentBandBrush"/>
        <conv:SeverityBrushConverter x:Key="SeverityBrush"/>
        <conv:SectorLabelConverter x:Key="SectorLabel"/>

        <!-- Note: the active theme's brushes (Themes/DarkTheme.xaml or LightTheme.xaml)
             are merged in at startup by ThemeService.Apply, before any window is
             created, so every {DynamicResource ...} below resolves correctly and
             updates instantly across all open windows when the theme is toggled. -->

        <!-- Shared dashboard styles: used by MainWindow's chrome and every slide
             content control (MachinePanel today; PDF/annual-summary slides later). -->
        <!-- Tiles: rounded, with a hairline outline that lifts them off the
             window background (no drop shadow: costly in software rendering,
             which is what a remote desktop session uses). Views/SlideMotion
             fades them up one after the other when a slide comes in. -->
        <Style x:Key="KpiTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Toolbar / action button: flat, rounded, with a hover and press veil
             over whatever Background the button sets (accent or secondary). -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="Veil" Background="{DynamicResource HoverOverlayBrush}" CornerRadius="8" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Veil" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBarButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Small "live" dot that breathes, beside the current team / poste. -->
        <Style x:Key="LiveDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Smaller headline value for the detail (tolerance-breakdown) tile row,
             so the two rows read as a clear primary/secondary hierarchy. -->
        <Style x:Key="KpiValueSmall" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
            <Setter Property="FontSize" Value="34"/>
        </Style>
        <Style x:Key="KpiSubtext" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Compact headline row of the machine slides: the run-state photo made
             the header taller, so this row gives the height back to the charts. -->
        <Style x:Key="KpiTileCompact" TargetType="Border" BasedOn="{StaticResource KpiTile}">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,3"/>
        </Style>
        <Style x:Key="KpiLabelCompact" TargetType="TextBlock" BasedOn="{StaticResource KpiLabel}">
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="KpiValueCompact" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
            <Setter Property="FontSize" Value="34"/>
        </Style>
        <Style x:Key="KpiSubtextCompact" TargetType="TextBlock" BasedOn="{StaticResource KpiSubtext}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="4,0,10,0"/>
        </Style>
        <Style x:Key="ChartTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="ChartTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBackgroundBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DatePickerTextBox is only ever used inside a DatePicker, so this can
             safely be implicit (no x:Key): every DatePicker in the app (Settings,
             History) wants the themed input area instead of WPF's default white one.
             DatePicker's own chrome (border/button) is left default-templated:
             only property setters, not a full ControlTemplate, to avoid risking
             the calendar popup's PART_Button/PART_Popup wiring.

             DatePickerTextBox derives from TextBox, so its template must provide
             PART_ContentHost (the TextBoxBase contract), not a nested child
             TextBox, which is a different (and broken) control entirely: it
             crashed WPF's internals as soon as the calendar tried to write a
             selected date back into the text surface. -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>

        <!-- Keyed (not implicit) so this doesn't touch the period-selector ComboBox
             on the live kiosk dashboard: applied explicitly on admin-window
             ComboBoxes (Settings roster grid, History filters) only. -->
        <Style x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource SecondaryTextBrush}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource InputBackgroundBrush}" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <!-- Selected item sits on AccentBrush (a saturated blue in both themes),
                 so its text stays a fixed white rather than following PrimaryTextBrush
                 (which would go near-black in light mode: unreadable on blue). -->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ToggleButton Style="{StaticResource DarkComboBoxToggleButton}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
