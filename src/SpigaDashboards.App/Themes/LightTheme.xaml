<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#D8DCE3"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#E1E5EB"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1F26"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5B6472"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#8A93A0"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

    <!-- Card outline, button hover/press veils, soft accent fill (pills, timer track). -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E6EC"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#24000000"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F2563EB"/>

    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#0A1B1F26"/>
    <SolidColorBrush x:Key="DisconnectedOverlayBrush" Color="#CCF0F2F5"/>
    <!-- Over a slide being reloaded (PastaLoader): lighter, the old slide stays readable. -->
    <SolidColorBrush x:Key="LoadingVeilBrush" Color="#99F0F2F5"/>
</ResourceDictionary>
