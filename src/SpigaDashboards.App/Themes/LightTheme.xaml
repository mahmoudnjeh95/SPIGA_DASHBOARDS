    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#D8DCE3"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#E1E5EB"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1F26"/>
