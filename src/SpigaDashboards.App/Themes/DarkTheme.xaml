<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111418"/>
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#1B1F26"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1B1F26"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#2A2F38"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2A2F38"/>
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#2A2F38"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7480"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2ECC71"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F1C40F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>

    <!-- Card outline, button hover/press veils, soft accent fill (pills, timer track). -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#262B34"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E3B82F6"/>

    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="DisconnectedOverlayBrush" Color="#CC111418"/>
    <!-- Over a slide being reloaded (PastaLoader): lighter, the old slide stays readable. -->
    <SolidColorBrush x:Key="LoadingVeilBrush" Color="#8C111418"/>
</ResourceDictionary>
