<Window x:Class="SpigaDashboards.App.TvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpigaDashboards.App.Views"
        Title="SPIGA Dashboards - Écran TV" Icon="/Assets/cds-icon.png" Width="960" Height="540" MinWidth="480" MinHeight="270"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/SlideTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- No buttons, filters or settings here: whatever the operator does on
         the main window, the production TV only ever shows the dashboard. -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="FullScreenMenuItem" Header="Plein écran" Click="FullScreenMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Fermer l'écran TV" Click="CloseMenuItem_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Same fixed 1600x900 design canvas as MainWindow, scaled to the TV. -->
    <Viewbox Stretch="Fill">
    <Grid Width="1600" Height="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/cds-logo.png" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SPIGA Dashboards" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <!-- Team / poste: pops, glows and flips over at a poste change. -->
                <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="12" Padding="12,4" Margin="16,0,0,0"
                        views:SlideMotion.Announce="{Binding CurrentTeamLabel}"
                        Visibility="{Binding IsPdfSlideShown, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource LiveDot}" Margin="0,0,9,0"/>
                        <TextBlock Text="{Binding CurrentTeamLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource DangerBrush}" CornerRadius="12" Padding="12,4" Margin="12,0,0,0"
                        Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Base déconnectée" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="ClockText" Grid.Column="1" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
        </Grid>

        <ContentControl Grid.Row="1" Margin="14,8,14,10" Content="{Binding CurrentSlide}"
                        views:SlideMotion.Transition="{Binding SlideChangeCount}"
                        views:SlideMotion.Scope="{Binding SlideScope}"/>

        <!-- Time left on this slide (same bar as the main window). -->
        <Border Grid.Row="1" Height="3" Margin="22,2,22,0" VerticalAlignment="Top" CornerRadius="1.5"
                Background="{DynamicResource AccentSoftBrush}" IsHitTestVisible="False"
                Visibility="{Binding IsRotationPaused, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="1.5"
                    views:SlideMotion.Seconds="{Binding SlideSeconds}"
                    views:SlideMotion.Paused="{Binding IsRotationPaused}"
                    views:SlideMotion.Timer="{Binding RotationCycle}"/>
        </Border>

        <!-- Stop pop-up: lines stopped with no cause yet (MainViewModel.StopAlerts). -->
        <views:StopAlertPopup x:Name="StopAlert" Grid.Row="1"/>

        <!-- Loading motion over the slide, when a load lasts (same as the main window). -->
        <views:PastaLoader Grid.Row="1" IsActive="{Binding ShowLoading}" Background="{DynamicResource LoadingVeilBrush}"/>

        <!-- Sticky note, read-only: it is written from the main window. -->
        <Border Grid.Row="2" Background="#F1C40F" Padding="16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoteText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding NoteText}" FontSize="18" FontWeight="SemiBold" Foreground="#1B1F26" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource DisconnectedOverlayBrush}"
                Visibility="{Binding IsConnectionHealthy, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
                <TextBlock Text="Connexion à la base de données perdue" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Reconnexion automatique en cours…" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Only while windowed: how to put it on the TV. -->
        <Border x:Name="PlacementHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="22,12" IsHitTestVisible="False">
            <TextBlock FontSize="22" Foreground="White" TextAlignment="Center">
                <Run Text="Glissez cette fenêtre sur l'écran TV, puis double-cliquez pour passer en plein écran." FontWeight="SemiBold"/>
                <LineBreak/>
                <Run Text="Double-clic ou Échap : quitter le plein écran · Clic droit : fermer" FontSize="16"/>
            </TextBlock>
        </Border>
    </Grid>
    </Viewbox>
</Window>
