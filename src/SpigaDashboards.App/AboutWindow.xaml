<Window x:Class="SpigaDashboards.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos" Icon="/Assets/cds-icon.png" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Language="fr-FR"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/cds-logo.png" Height="64" Margin="0,0,16,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SPIGA Dashboards" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock x:Name="VersionText" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Supervision de production"
                   TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,20,0,16"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Développé par" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Mahmoud Njeh" FontWeight="SemiBold" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="1" Text="Éditeur" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="L2I - Leader de l'innovation industrielle" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="2" Text="Environnement" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RuntimeText" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="3" Text="Paramètres" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SettingsFolderText" Style="{StaticResource FieldValue}"/>
        </Grid>

        <TextBlock x:Name="CopyrightText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,0"/>
        <!-- Free Flaticon licence: attribution required. -->
        <TextBlock Text="Icônes de tendance (hausse / baisse) : Flaticon.com" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>

        <Button Content="Fermer" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="16,8" IsDefault="True" IsCancel="True"
                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                Click="CloseButton_Click"/>
    </StackPanel>
</Window>
