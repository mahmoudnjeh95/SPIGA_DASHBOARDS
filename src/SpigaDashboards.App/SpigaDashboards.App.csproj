<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\spiga.ico</ApplicationIcon>
    <!-- Version (shown in "A propos"): Directory.Build.props at the repo root. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\spiga-logo.png" />
    <Resource Include="Assets\machine-running.png" />
    <Resource Include="Assets\machine-stopped.png" />
    <!-- Trend arrows (Flaticon: increase 4721635, decrease 6067145; attribution in À propos). -->
    <Resource Include="Assets\trend-up.png" />
    <Resource Include="Assets\trend-down.png" />
  </ItemGroup>

</Project>
