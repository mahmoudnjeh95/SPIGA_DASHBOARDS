@* Welcome screen, before the sign-in form. Split in two: on the left a deep
   green brand panel with the Spiga · Diari logo, on the right what is useful
   at a glance from across the floor: the greeting, the poste in progress,
   a large clock and the date. Any key, a click or a tap continues to the
   sign-in form (the screen leaves first, then the form rises). On a shared
   plant PC it is also the screen left after a sign-out. *@
@implements IDisposable
@inject TimeProvider Clock

<div class="welcome @(_leaving ? "leaving" : "")" tabindex="0" @ref="_root"
     @onclick="ContinueAsync" @onkeydown="OnKeyAsync" aria-label="Accueil SPIGA Suivi Production">
    <section class="wl-brand">
        <i class="wl-glow" aria-hidden="true"></i>
        <div class="wl-logo-card">
            <img src="@Logo" alt="Spiga · Diari" />
            <i class="wl-sheen" aria-hidden="true"></i>
        </div>
        <p class="wl-sub">Suivi de production</p>
        <i class="wl-rule" aria-hidden="true"></i>
    </section>

    <section class="wl-info">
        <div class="wl-info-in">
            <p class="wl-greet">@Greeting</p>
            <p class="wl-shift">
                <i class="wl-dot" aria-hidden="true"></i>
                Poste @ShiftLabel <span>· @Shifts.Hours(_shift)</span>
            </p>
            <p class="wl-clock num" aria-label="@_now.ToString("HH:mm", Fr)">
                @* Keyed on the value: a new hour or minute rolls in from below. *@
                <span class="wl-digits" @key="@($"h{_now.Hour}")">@_now.ToString("HH", Fr)</span><span class="wl-colon" aria-hidden="true">:</span><span class="wl-digits" @key="@($"m{_now.Minute}")">@_now.ToString("mm", Fr)</span>
            </p>
            <p class="wl-date">@Date</p>
            <button type="button" class="bar wl-go">
                Commencer
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
            <p class="wl-hint">Touchez l'écran ou appuyez sur une touche pour vous connecter</p>
        </div>
    </section>

    @* Semolina: golden durum grains rising slowly across the whole screen. *@
    <div class="wl-grains" aria-hidden="true">
        @for (var i = 0; i < 22; i++)
        {
            <i style="@Grain(i)"></i>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnContinue { get; set; }

    private const string Logo = "_content/Spiga.UI/img/cds-logo.png";
    private static readonly System.Globalization.CultureInfo Fr = new("fr-FR");
    // The screen leaves (ease-in) before the sign-in form comes up.
    private static readonly TimeSpan LeaveTime = TimeSpan.FromMilliseconds(420);

    private ElementReference _root;
    private DateTime _now;
    private int _shift;
    private Timer? _timer;
    private bool _leaving;

    // "Bonjour" from 4 h (the early hours belong to the morning, not the
    // evening), "Bonsoir" from 18 h.
    private string Greeting => _now.Hour is >= 4 and < 18 ? "Bonjour" : "Bonsoir";
    private string ShiftLabel => _shift switch { 1 => "du matin", 2 => "de l'après-midi", _ => "de nuit" };
    private string Date
    {
        get
        {
            var text = _now.ToString("dddd d MMMM yyyy", Fr);
            return char.ToUpper(text[0], Fr) + text[1..];
        }
    }

    // Grains: spread across the width, each with its own speed, drift, size
    // and brightness, and already on their way when the screen opens.
    private static string Grain(int i) => string.Create(System.Globalization.CultureInfo.InvariantCulture,
        $"--x:{2 + i * 4.5}%;--dx:{(i - 11) * 6}px;--o:{.35 + i % 4 * .13};--s:{.8 + i % 3 * .25};--t:{12 + i * 7 % 9}s;--d:{-1.7 * i}s");

    protected override void OnInitialized()
    {
        SetNow(Clock.GetLocalNow().DateTime);
        // The clock on screen: once a second is enough to turn the minute.
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            var now = Clock.GetLocalNow().DateTime;
            if (now.Minute == _now.Minute && now.Hour == _now.Hour)
                return;
            SetNow(now);
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void SetNow(DateTime now)
    {
        _now = now;
        _shift = Shifts.At(now);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus, so that a key press continues straight away.
        if (firstRender)
            await _root.FocusAsync();
    }

    private Task OnKeyAsync(KeyboardEventArgs e) =>
        e.Key is "Tab" or "Shift" or "Control" or "Alt" or "Meta" or "CapsLock" ? Task.CompletedTask : ContinueAsync();

    private async Task ContinueAsync()
    {
        if (_leaving)
            return;
        _leaving = true;
        StateHasChanged();
        await Task.Delay(LeaveTime);
        await OnContinue.InvokeAsync();
    }

    public void Dispose() => _timer?.Dispose();
}
