@inject AuthService Auth
@inject UserSession Session

<form @onsubmit="SubmitAsync" style="display:flex;flex-direction:column;gap:12px">
    @if (_error != null)
    {
        <div class="notice error" role="alert">@_error</div>
    }
    @if (_done)
    {
        <div class="notice ok" role="status">Mot de passe modifié.</div>
    }
    <div class="f"><label for="pwd-current">Mot de passe actuel</label><input id="pwd-current" type="password" @bind="_current" @bind:event="oninput" autocomplete="current-password" /></div>
    <div class="f"><label for="pwd-new">Nouveau mot de passe</label><input id="pwd-new" type="password" @bind="_new" @bind:event="oninput" autocomplete="new-password" /></div>
    <div class="f"><label for="pwd-confirm">Confirmation</label><input id="pwd-confirm" type="password" @bind="_confirm" @bind:event="oninput" autocomplete="new-password" /></div>
    <p class="gate-foot">@Rule</p>
    <button class="bar acc" type="submit" disabled="@_busy">Enregistrer le mot de passe</button>
</form>

@code {
    private string _current = "";
    private string _new = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;
    private bool _done;

    private string Rule => $"Au moins {Session.Policy.MinPasswordLength} caractères"
        + (Session.Policy.RequireLetterAndDigit ? ", avec au moins une lettre et un chiffre." : ".");

    private async Task SubmitAsync()
    {
        _error = null;
        _done = false;
        if (_new != _confirm)
        {
            _error = "Les deux nouveaux mots de passe ne sont pas identiques.";
            return;
        }
        _busy = true;
        try
        {
            await Auth.ChangePasswordAsync(Session.Actor!, _current, _new);
            _current = _new = _confirm = "";
            _done = true;
            Session.PasswordChanged();
        }
        catch (RuleViolationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
