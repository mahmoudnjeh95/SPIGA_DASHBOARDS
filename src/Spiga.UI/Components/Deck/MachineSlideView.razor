@* One machine of the deck (kiosk: MachineDayPanel / MachinePeriodPanel):
   its state now, then the poste in progress (or the one before) with its
   hourly charts and the postes before it, or the period with its trend
   charts and the teams compared. *@
@using SpigaDashboards.App.ViewModels.Slides
@using SpigaDashboards.App.Services
@inject UiState Ui

@{
    var h = Slide.Header;
    var m = Slide.Main;
    // A planned stop / maintenance going on now takes the whole poste view.
    var declared = h.Stop is { TakesWholeView: true } && Slide.Period == null && Slide.PeriodLabel.Length == 0 ? h.Stop : null;
}
<section class="card dk-head">
    <RunStateArt State="@h.State" Label="@h.StateText" Class="dk-photo" />
    <div class="dk-title">
        <span class="pre">@h.SectorLabel</span>
        <h2>@h.Name</h2>
        <p class="dk-sub">
            @if (Slide.Period == null)
            {
                <b>Poste @m.Name</b> <span>@m.Hours · @m.Team</span>
                <span class="chip @(m.Running ? "ok" : "")">@(m.Running ? "EN COURS" : "TERMINÉ")</span>
            }
            else
            {
                <b>@Slide.PeriodLabel</b>
            }
            @if (Slide.FilterLabel.Length > 0)
            {
                <span class="chip acc">@Slide.FilterLabel</span>
            }
        </p>
        <p class="nd dk-prod">@Slide.ProductionLabel</p>
    </div>
    @if (h.Stop is { } stop && declared == null)
    {
        <div class="dk-ticker" style="--tc:@stop.TickerColor;--tt:@stop.TickerTextColor" @key="@("stop" + stop.Start.Ticks)">
            <b class="dk-badge"><i class="dk-blink" aria-hidden="true">⚠</i>@stop.Title</b>
            <div class="dk-scroller"><span>@stop.TickerText</span></div>
        </div>
    }
    else if (h.Recovery is { } recovery)
    {
        <div class="dk-ticker ok" @key="@("ok" + recovery.Text)">
            <b class="dk-badge"><i class="dk-check" aria-hidden="true">✓</i>REPRISE</b>
            <div class="dk-scroller still"><span>@recovery.Text</span></div>
            <i class="dk-sweep" aria-hidden="true"></i>
        </div>
    }
</section>

@if (declared != null)
{
    <section class="card dk-declared @(declared.Kind == OngoingStopKind.Maintenance ? "maint" : "planned")">
        <h2>@declared.Title</h2>
        <p>@declared.SinceText (@declared.DurationText) · @declared.CauseText</p>
        @if (declared.ExpectedEndText.Length > 0)
        {
            <p class="@(declared.IsOverdue ? "bad-t" : "")">@declared.ExpectedEndText</p>
        }
    </section>
    return;
}

<div class="row dk-kpis">
    <KpiTile Label="TRS" Hint="@($"cible {m.TrsTarget:0} %")" Value="@Fmt.Pct(m.Kpis.TrsPercent)" Css="@Fmt.Css(m.TrsSeverity)"
             Ring="@m.Kpis.TrsPercent" RingTarget="@m.TrsTarget" Trend="@m.TrsTrend" Flash="@_flash["trs"].Text" FlashGood="@_flash["trs"].Good" />
    <KpiTile Label="Disponibilité" Value="@Fmt.Pct(m.Kpis.AvailabilityPercent)" Css="@Fmt.Css(Bands.Availability(m.Kpis.AvailabilityPercent))" />
    <KpiTile Label="Performance" Value="@Fmt.Pct(m.Kpis.PerformancePercent)" Css="@Fmt.Css(Bands.Performance(m.Kpis.PerformancePercent))" />
    <KpiTile Label="Qualité" Value="@Fmt.Pct(m.Kpis.QualityPercent)" Css="@Fmt.Css(Bands.Quality(m.Kpis.QualityPercent))"
             Flash="@_flash["quality"].Text" FlashGood="@_flash["quality"].Good" />
    <KpiTile Label="Vitesse moyenne" Hint="sacs/min" Value="@Fmt.Num(m.Kpis.SpeedBagsPerMinute, 1)" Sub="@($"max {Fmt.Num(m.Kpis.MaxSpeedBagsPerMinute, 1)}")"
             Trend="@m.SpeedTrend" Flash="@_flash["speed"].Text" FlashGood="@_flash["speed"].Good" />
    <KpiTile Label="Poids moyen" Value="@KpiCalculator.FormatAverages(m.Kpis.Weights)" Css="@(m.WeightOnTarget ? "gold txt" : "txt")"
             Sub="@(m.Kpis.Weights.Count == 0 ? "Pas de données de poids" : "Cible " + string.Join(" · ", m.Kpis.Weights.Select(w => $"{w.TargetWeight:0} g")))"
             Trend="@(m.WeightOnTarget ? null : m.WeightTrend)" />
    <KpiTile Label="Écart de poids" Value="@Fmt.SignedPct(m.Kpis.WeightDeviationPercent)" Css="@Fmt.Css(m.WeightSeverity)" Sub="@m.Kpis.GiveawayLabel"
             Flash="@_flash["deviation"].Text" FlashGood="@_flash["deviation"].Good" />
    <KpiTile Label="Production" Value="@KpiCalculator.FormatMass(m.Kpis.ProductionKg)" Sub="@($"{Fmt.Num(m.Kpis.TotalBags)} sacs")" />
</div>

@if (Slide.Period is { } p)
{
    <div class="dk-charts">
        <section class="card">@Chart($"TRS {p.Grain}", "trs", p.Trs)</section>
        <section class="card">@Chart($"Vitesse moyenne / max {p.Grain} (sacs/min)", "speed", p.Speed)</section>
        <section class="card">@Chart($"Production nette {p.Grain}, par poids", "prod", p.Production)</section>
        <section class="card">@Chart($"Écart de poids {p.Grain} (% de la cible)", "dev", p.Deviation)</section>
    </div>
    <section class="card">
        <div class="card-head"><h2>Équipes <small>meilleur TRS d'abord</small></h2></div>
        @if (p.Teams.Count == 0)
        {
            <p class="empty">Aucune production sur la période.</p>
        }
        else
        {
            <div class="tbl-wrap">
                <table class="t">
                    <thead><tr><th>Équipe</th><th class="r">TRS</th><th class="r">Vitesse</th><th class="r">Poids moyen</th><th class="r">Écart</th><th class="r">Production</th><th class="r">Sacs</th></tr></thead>
                    <tbody>
                        @foreach (var t in p.Teams)
                        {
                            <tr>
                                <td>@t.Team</td>
                                <td class="r"><span class="chip @Fmt.Css(t.TrsSeverity)">@Fmt.Pct(t.Kpis.TrsPercent)</span></td>
                                <td class="r">@Fmt.Num(t.Kpis.SpeedBagsPerMinute, 1)</td>
                                <td class="r">@KpiCalculator.FormatAverages(t.Kpis.Weights)</td>
                                <td class="r"><span class="chip @Fmt.Css(t.WeightSeverity)">@Fmt.SignedPct(t.Kpis.WeightDeviationPercent)</span></td>
                                <td class="r">@KpiCalculator.FormatMass(t.Kpis.ProductionKg)</td>
                                <td class="r">@Fmt.Num(t.Kpis.TotalBags)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
else if (m.Charts is { } c)
{
    <div class="dk-charts three">
        <section class="card">@Chart("En marche (par heure)", "onoff", c.OnOff)</section>
        <section class="card">@Chart("Vitesse moyenne / max (sacs/min)", "speed-h", c.Speed)</section>
        <section class="card">@Chart("Poids moyen / cible", "weight-h", c.Weight)</section>
    </div>
    @if (Slide.Previous.Count > 0)
    {
        <section class="card">
            <div class="card-head"><h2>Postes précédents <small>même journée</small></h2></div>
            <div class="tbl-wrap">
                <table class="t">
                    <thead><tr><th>Poste</th><th>Équipe</th><th class="r">TRS</th><th class="r">Vitesse</th><th class="r">Poids moyen</th><th class="r">Écart</th><th class="r">Production</th></tr></thead>
                    <tbody>
                        @foreach (var prev in Slide.Previous)
                        {
                            <tr>
                                <td>@prev.Name <small>@prev.Hours</small></td>
                                <td>@prev.Team</td>
                                <td class="r"><span class="chip @Fmt.Css(prev.TrsSeverity)">@Fmt.Pct(prev.Kpis.TrsPercent)</span></td>
                                <td class="r">@Fmt.Num(prev.Kpis.SpeedBagsPerMinute, 1)</td>
                                <td class="r">@KpiCalculator.FormatAverages(prev.Kpis.Weights)</td>
                                <td class="r"><span class="chip @Fmt.Css(prev.WeightSeverity)">@Fmt.SignedPct(prev.Kpis.WeightDeviationPercent)</span></td>
                                <td class="r">@KpiCalculator.FormatMass(prev.Kpis.ProductionKg)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code {
    [Parameter, EditorRequired] public MachineSlide Slide { get; set; } = default!;

    // The bands of Paramètres > Couleurs (D / P / Q, as the kiosk colours them).
    private static ColorThresholds Bands => ColorThresholds.Current;

    private MachineSlide? _flashFor;
    private Dictionary<string, (string? Text, bool Good)> _flash = new();

    // The change flashes, worked out once per slide read (not on each redraw):
    // against the figures this same tile showed last time.
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_flashFor, Slide))
            return;
        _flashFor = Slide;
        var m = Slide.Main;
        var scope = $"{Slide.Header.MachineId}|{Slide.PeriodLabel}|{Slide.FilterLabel}|{m.Name}|";
        _flash = new()
        {
            ["trs"] = TileFlash.Of(Ui, scope + "trs", m.Kpis.TrsPercent, 0.5, 1, d => d.ToString("+0.0;-0.0", Fmt.French) + " pt"),
            ["quality"] = TileFlash.Of(Ui, scope + "quality", m.Kpis.QualityPercent, 0.2, 1, d => d.ToString("+0.0;-0.0", Fmt.French) + " pt"),
            ["speed"] = TileFlash.Of(Ui, scope + "speed", m.Kpis.SpeedBagsPerMinute, 0.5, 1, d => d.ToString("+0.0;-0.0", Fmt.French)),
            ["deviation"] = TileFlash.Of(Ui, scope + "deviation", m.Kpis.WeightDeviationPercent, 0.05, 0, d => d.ToString("+0.00;-0.00", Fmt.French) + " pt"),
        };
    }

    private RenderFragment Chart(string title, string key, DeckChart chart) => __builder =>
    {
        if (!chart.HasData)
        {
            <h2>@title</h2>
            <p class="empty">Pas de données.</p>
            return;
        }
        <SpigaChart Title="@title" Key="@("deck-" + key)" Labels="chart.Labels" Series="chart.Series" Format="chart.Format"
                    YMin="chart.YMin" YMax="chart.YMax" Height="230" />
    };
}
