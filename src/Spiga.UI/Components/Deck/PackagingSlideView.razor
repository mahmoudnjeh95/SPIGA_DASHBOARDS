@* Conditionnement CC1 / Pâte & CC2 / Cumul (kiosk: PackagingPanel): the
   production of a group of lines per machine and per team, or its TRS (the
   slide after), with the team and machine totals as bars. *@
@using SpigaDashboards.App.Services

<section class="card dk-head plain">
    <div class="dk-title">
        <span class="pre">@(Slide.Trs ? "TRS" : "Production")</span>
        <h2>@Slide.Title<small>@Slide.MachinesLabel</small></h2>
        <p class="dk-sub">
            <b>@Slide.PeriodLabel</b>
            @if (Slide.FilterLabel.Length > 0)
            {
                <span class="chip acc">@Slide.FilterLabel</span>
            }
        </p>
    </div>
</section>

<div class="row dk-kpis">
    @if (Slide.Trs)
    {
        <KpiTile Label="TRS du groupe" Hint="@($"cible {Slide.TrsTarget:0} %")" Value="@Fmt.Pct(Slide.Overall.Kpis.TrsPercent)" Css="@Fmt.Css(Slide.Overall.TrsSeverity)" />
        <KpiTile Label="Disponibilité" Value="@Fmt.Pct(Slide.Overall.Kpis.AvailabilityPercent)" />
        <KpiTile Label="Performance" Value="@Fmt.Pct(Slide.Overall.Kpis.PerformancePercent)" />
        <KpiTile Label="Qualité" Value="@Fmt.Pct(Slide.Overall.Kpis.QualityPercent)" />
    }
    else
    {
        <KpiTile Label="Production" Value="@KpiCalculator.FormatMass(Slide.Overall.ProductionKg)" Sub="@($"{Fmt.Num(Slide.Overall.TotalBags)} sacs")" />
        <KpiTile Label="TRS du groupe" Value="@Fmt.Pct(Slide.Overall.Kpis.TrsPercent)" Css="@Fmt.Css(Slide.Overall.TrsSeverity)" />
    }
</div>

<section class="card">
    <div class="tbl-wrap">
        <table class="t dk-pack">
            <thead>
                <tr>
                    <th>Machine</th>
                    @foreach (var c in Slide.Teams)
                    {
                        <th class="r">@c</th>
                    }
                    <th class="r">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Slide.Rows)
                {
                    <tr class="@(row.IsTotal ? "total" : "")">
                        <td>@row.Label</td>
                        @foreach (var cell in row.Cells)
                        {
                            <td class="r">@Cell(cell)</td>
                        }
                        <td class="r"><b>@Cell(row.Total)</b></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="dk-charts">
    <section class="card">@DeckChartView.Render(Slide.Trs ? "TRS par équipe" : "Production par équipe", Slide.Trs ? "pack-trs-team" : "pack-team", Slide.TeamChart)</section>
    <section class="card">@DeckChartView.Render(Slide.Trs ? "TRS par machine" : "Production par machine", Slide.Trs ? "pack-trs-machine" : "pack-machine", Slide.MachineChart)</section>
</div>

@code {
    [Parameter, EditorRequired] public PackagingSlide Slide { get; set; } = default!;

    private RenderFragment Cell(PackCell cell) => __builder =>
    {
        if (Slide.Trs)
        {
            @if (cell.Kpis.TrsPercent is null)
            {
                <span class="nd">—</span>
            }
            else
            {
                <span class="chip @Fmt.Css(cell.TrsSeverity)">@Fmt.Pct(cell.Kpis.TrsPercent)</span>
                <small class="dk-dpq">D @Fmt.Pct(cell.Kpis.AvailabilityPercent, 0) · P @Fmt.Pct(cell.Kpis.PerformancePercent, 0) · Q @Fmt.Pct(cell.Kpis.QualityPercent, 0)</small>
            }
        }
        else
        {
            @(cell.HasProduction ? KpiCalculator.FormatMass(cell.ProductionKg) : "—")
            @if (cell.HasProduction)
            {
                <small class="dk-dpq">@Fmt.Num(cell.TotalBags) sacs</small>
            }
        }
    };
}
