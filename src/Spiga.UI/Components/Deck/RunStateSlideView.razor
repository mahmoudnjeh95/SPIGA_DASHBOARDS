@* État des machines (kiosk: RunStateSlide): the run-state photo of every
   machine of the group, live whatever the period, with the cause of its
   stop once it has one. No title card: the photos fill the screen (the
   slide's name is in the deck's own bar). *@

<div class="dk-runstate" style="--cols:@(Slide.Tiles.Count <= 5 ? Math.Max(1, Slide.Tiles.Count) : (Slide.Tiles.Count + 1) / 2)">
    @foreach (var t in Slide.Tiles)
    {
        <section class="card dk-run">
            <RunStateArt State="@t.State" Label="@t.StateText" />
            <b>@t.Name</b>
            <small>@t.StateText</small>
            @if (t.Stop is { IsUnqualified: false } stop)
            {
                <span class="dk-cause" style="background:@(stop.Kind == SpigaDashboards.App.Models.OngoingStopKind.Maintenance ? "#FAB219" : stop.TickerColor);color:@(stop.Kind == SpigaDashboards.App.Models.OngoingStopKind.Maintenance ? "#1A1406" : "#FFFFFF")">
                    @stop.ShortCause · depuis @stop.DurationText@(stop.ShortReturnText.Length > 0 ? " · " + stop.ShortReturnText : "")
                </span>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public RunStateSlide Slide { get; set; } = default!;
}
