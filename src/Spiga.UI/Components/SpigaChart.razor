@* Every chart of the web screens, drawn by ECharts (spiga-chart.js; the
   library ships with the site: the plant PCs may be offline). The user can
   change its kind (bars, stacked, line, points, area), switch series off and
   on from the legend, and enlarge it (button or double-click) to zoom with
   the mouse wheel or the slider. The choice is kept per chart (Key) for the
   session (UiState). A new chart gets all of it by being a SpigaChart.
   Times (optional): the X axis is a time axis, one time per value, instead
   of the Labels. *@
@using System.Text.Json
@implements IAsyncDisposable
@inject UiState Ui
@inject IJSRuntime JS

<div class="chart @(_expanded ? "chart-expanded" : "")">
    @Toolbar(false)
    <div class="chart-plot" @ref="_small" role="img" aria-label="@Title" title="Double-clic : agrandir" @ondblclick="Open"
         style="height:@(Height)px"></div>
</div>

@if (_expanded)
{
    <div class="chart-modal" @onclick="Close">
        <div class="chart-modal-box" @onclick:stopPropagation="true">
            <div class="chart-modal-head">
                <h2>@Title</h2>
                <span class="chart-hint">Molette ou barre du bas : zoom et déplacement · légende : masquer / afficher · Échap : fermer</span>
                <span class="sp"></span>
                <button type="button" class="bar small" @onclick="ResetZoom">Réinitialiser le zoom</button>
                <button type="button" class="bar small chart-close" @onclick="Close">Fermer</button>
            </div>
            @Toolbar(true)
            <div class="chart-zoom">
                <div class="chart-plot" @ref="_big" role="img" aria-label="@Title" style="height:520px"></div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<string> Labels { get; set; } = Array.Empty<string>();
    [Parameter, EditorRequired] public IReadOnlyList<ChartSeries> Series { get; set; } = Array.Empty<ChartSeries>();
    [Parameter] public Func<double, string> Format { get; set; } = v => v.ToString("0.#", CultureInfo.GetCultureInfo("fr-FR"));
    [Parameter] public double? YMin { get; set; }
    [Parameter] public double? YMax { get; set; }
    [Parameter] public IReadOnlyList<DateTime>? Times { get; set; }

    // Counts (people, events): the scale stops on whole numbers.
    [Parameter] public bool Integer { get; set; }
    [Parameter] public string? Key { get; set; }
    [Parameter] public int Height { get; set; } = 220;

    private ElementReference _small, _big;
    private string? _drawnSmall, _drawnBig;
    private bool _expanded, _disposed;
    private string ChartKey => Key ?? Title;
    private int Count => Times?.Count ?? Labels.Count;

    private ChartView View => Ui.Charts.TryGetValue(ChartKey, out var v) ? v : new ChartView(ChartKind.Auto, new HashSet<string>());

    // ---------- interactions ----------

    private void SetKind(ChartKind kind) => Ui.Charts[ChartKey] = View with { Kind = kind };

    private void Toggle(string name)
    {
        var hidden = new HashSet<string>(View.Hidden);
        if (!hidden.Remove(name))
        {
            // The last series shown stays: an empty chart would look like missing data.
            if (Series.Count(s => !hidden.Contains(s.Name)) <= 1)
                return;
            hidden.Add(name);
        }
        Ui.Charts[ChartKey] = View with { Hidden = hidden };
    }

    private void Open()
    {
        if (Count > 0)
        {
            _expanded = true;
            Ui.Enlarged.Add(this);
        }
    }

    private async Task Close()
    {
        Ui.Enlarged.Remove(this);
        await Js("spigaChart.dispose", _big);
        _drawnBig = null;
        _expanded = false;
    }

    private Task ResetZoom() => Js("spigaChart.resetZoom", _big);

    // ---------- drawing ----------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var small = Spec(false);
        if (small != _drawnSmall)
        {
            _drawnSmall = small;
            await Js("spigaChart.set", _small, small);
        }
        if (_expanded)
        {
            var big = Spec(true);
            if (big != _drawnBig)
            {
                _drawnBig = big;
                await Js("spigaChart.set", _big, big);
            }
        }
    }

    private async Task Js(string fn, params object?[] args)
    {
        if (_disposed)
            return;
        try
        {
            await JS.InvokeVoidAsync(fn, args);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (InvalidOperationException) { } // prerendering: no browser yet
    }

    public async ValueTask DisposeAsync()
    {
        Ui.Enlarged.Remove(this);
        await Js("spigaChart.dispose", _small);
        if (_expanded)
            await Js("spigaChart.dispose", _big);
        _disposed = true;
    }

    private static ChartKind KindOf(ChartSeries s, ChartKind chosen) => chosen == ChartKind.Auto ? s.Kind : chosen;

    // What spiga-chart.js draws: the series shown, each value with its text,
    // and the scale (its ticks already formatted).
    private string Spec(bool big)
    {
        var view = View;
        var shown = Series.Where(s => !view.Hidden.Contains(s.Name)).ToList();
        var count = Count;
        var stackAll = view.Kind == ChartKind.Stacked;
        string KindName(ChartSeries s) => s.Reference ? "ref" : KindOf(s, view.Kind) switch
        {
            ChartKind.Bars or ChartKind.Stacked => "bar",
            ChartKind.Points => "points",
            ChartKind.Area => "area",
            _ => "line",
        };
        string? StackOf(ChartSeries s) => KindName(s) != "bar" ? null : stackAll ? "all" : s.Stack;

        // The scale: from the values on the drawn axis, piled up where stacked.
        var onAxis = shown.Where(s => s.ScaleMax == null).ToList();
        var values = new List<double>();
        foreach (var s in onAxis.Where(s => StackOf(s) == null))
            values.AddRange(s.Values.Take(count).Where(v => v != null && !double.IsNaN(v.Value)).Select(v => v!.Value));
        foreach (var g in onAxis.Where(s => StackOf(s) != null).GroupBy(StackOf))
            for (var i = 0; i < count; i++)
            {
                values.Add(g.Sum(s => i < s.Values.Count && s.Values[i] is > 0 ? s.Values[i]!.Value : 0));
                values.Add(g.Sum(s => i < s.Values.Count && s.Values[i] is < 0 ? s.Values[i]!.Value : 0));
            }
        var (min, max, interval) = Scale(values);
        var ticks = new List<string>();
        for (var t = min; t <= max + interval / 1000; t += interval)
            ticks.Add(Format(t));

        var bars = shown.Count(s => !s.Reference && KindName(s) == "bar" && StackOf(s) == null);
        var labelsShown = count <= (big ? 31 : 16);
        var longest = Times != null ? 0 : Labels.Take(count).Select(l => Math.Min(22, l.Length)).DefaultIfEmpty(0).Max();
        var slant = Times == null && count > 0 && longest * 7.0 > (big ? 1000.0 : 480.0) / count * 0.92;

        var series = shown.Select(s =>
        {
            var f = s.Format ?? Format;
            var data = new List<object?[]>();
            for (var i = 0; i < count; i++)
            {
                var v = i < s.Values.Count ? s.Values[i] : null;
                // Plant wall-clock time, sent as UTC and shown as UTC (no time-zone shift in the browser).
                object? x = Times != null ? new DateTimeOffset(DateTime.SpecifyKind(Times[i], DateTimeKind.Unspecified), TimeSpan.Zero).ToUnixTimeMilliseconds() : null;
                if (v == null && Times != null)
                    continue;
                if (v is { } gap && double.IsNaN(gap))
                {
                    data.Add(new[] { x, (object)"-", null, null }); // a break in the line
                    continue;
                }
                // Side-by-side bars: a 0 label would run into its neighbour's (the tooltip keeps it).
                var hideLabel = v == 0 && KindName(s) == "bar" && (bars > 1 || StackOf(s) != null);
                data.Add(new[] { x, v, v is { } d ? f(d) : null, hideLabel ? (object)1 : null });
            }
            return new
            {
                name = s.Name,
                color = s.Color,
                kind = KindName(s),
                stack = StackOf(s),
                own = s.ScaleMax,
                step = s.Step,
                data,
            };
        }).ToList();

        return JsonSerializer.Serialize(new
        {
            big,
            times = Times != null,
            cats = Times == null ? Labels.Take(count).ToList() : null,
            min,
            max,
            interval,
            ticks,
            labels = labelsShown,
            slant,
            series,
        });
    }

    // A scale with round steps: 5 to 7 ticks, unless YMin and YMax are both
    // set (then exactly 4 steps between them, as given).
    private (double Min, double Max, double Interval) Scale(List<double> values)
    {
        var lo = YMin ?? Math.Min(0, values.DefaultIfEmpty(0).Min());
        var hi = YMax ?? Math.Max(lo + 1, values.DefaultIfEmpty(1).Max() * 1.1);
        if (YMin != null && YMax != null)
            return (lo, hi, (hi - lo) / 4);
        var raw = (hi - lo) / 5;
        var mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var step = new[] { 1, 2, 2.5, 5, 10 }.Select(k => k * mag).First(k => k >= raw * 0.999);
        if (Integer)
            step = Math.Max(1, Math.Ceiling(step));
        if (YMin == null)
            lo = Math.Floor(lo / step + 1e-9) * step;
        if (YMax == null)
            hi = lo + Math.Max(1, Math.Ceiling((hi - lo) / step - 1e-9)) * step;
        else
            step = (hi - lo) / Math.Max(1, Math.Round((hi - lo) / step));
        return (Math.Round(lo, 6), Math.Round(hi, 6), step);
    }

    private static readonly (ChartKind Kind, string Label, string Icon)[] Kinds =
    {
        (ChartKind.Auto, "D'origine", "<path d='M4 20V10M10 20V4M16 20v-7M22 20H2'/>"),
        (ChartKind.Bars, "Barres", "<rect x='4' y='10' width='4' height='10' rx='1'/><rect x='10' y='4' width='4' height='16' rx='1'/><rect x='16' y='13' width='4' height='7' rx='1'/>"),
        (ChartKind.Stacked, "Barres empilées", "<rect x='5' y='12' width='5' height='8' rx='1'/><rect x='5' y='6' width='5' height='5' rx='1'/><rect x='14' y='14' width='5' height='6' rx='1'/><rect x='14' y='8' width='5' height='5' rx='1'/>"),
        (ChartKind.Line, "Courbe", "<path d='m3 17 6-6 4 4 8-8'/>"),
        (ChartKind.Points, "Points", "<circle cx='6' cy='16' r='2'/><circle cx='11' cy='9' r='2'/><circle cx='16' cy='13' r='2'/><circle cx='20' cy='6' r='2'/>"),
        (ChartKind.Area, "Aire", "<path d='M3 20V14l5-5 4 4 9-8v15z'/>"),
    };

    private RenderFragment Toolbar(bool expanded) => __builder =>
    {
        var view = View;
        var stackable = Series.Count(s => !s.Reference && s.ScaleMax == null) > 1;
        <div class="chart-head">
            @if (!expanded)
            {
                <h2>@Title</h2>
            }
            <div class="chart-legend">
                @foreach (var s in Series)
                {
                    var off = view.Hidden.Contains(s.Name);
                    <button type="button" class="chart-key @(off ? "off" : "")" title="Cliquer pour masquer / afficher" aria-pressed="@(!off)" @onclick="() => Toggle(s.Name)">
                        @if (s.Reference)
                        {
                            <u style="background:@s.Color"></u>
                        }
                        else
                        {
                            <i style="background:@s.Color"></i>
                        }
                        @s.Name
                    </button>
                }
            </div>
            <span class="sp"></span>
            <div class="chart-tools" role="group" aria-label="Type de graphique">
                @foreach (var (kind, label, icon) in Kinds)
                {
                    if (kind == ChartKind.Stacked && !stackable)
                        continue;
                    <button type="button" class="chart-tool @(view.Kind == kind ? "on" : "")" title="@label" aria-pressed="@(view.Kind == kind)" @onclick="() => SetKind(kind)">
                        <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)icon)</svg>
                    </button>
                }
                @if (!expanded)
                {
                    <button type="button" class="chart-tool" title="Agrandir (ou double-clic sur le graphique)" @onclick="Open">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d='M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7'/></svg>
                    </button>
                }
            </div>
        </div>
    };
}
