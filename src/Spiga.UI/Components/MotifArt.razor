@* The picture of a waste motif, for the quick entry tiles. A motif with a
   picture file in wwwroot/img/motifs/ (listed in Artwork.cs, made in Stewdio)
   shows that file; the others keep their small flat drawing in inline SVG
   (sharp at any size, no download: the plant PCs may be offline). If a listed
   file is missing, the image hides itself and the drawing comes back. A motif
   added later in the référentiel gets the generic tag until it has a picture. *@
@if (Artwork.Motif(Reason) is { } src)
{
    <span class="motif-art has-file @Class" style="width:@(Size)px;height:@(Size)px"><img src="@src" alt="" width="@Size" height="@Size" draggable="false" onerror="this.parentNode.classList.remove('has-file');this.remove()" />@((MarkupString)Svg(Reason))</span>
}
else
{
    <span class="motif-art @Class" style="width:@(Size)px;height:@(Size)px">@((MarkupString)Svg(Reason))</span>
}

@code {
    [Parameter, EditorRequired] public string Reason { get; set; } = "";
    [Parameter] public int Size { get; set; } = 64;
    [Parameter] public string? Class { get; set; }

    // Key of a motif: its label in lower case, without accents.
    public static string Key(string reason)
    {
        var d = (reason ?? "").Normalize(System.Text.NormalizationForm.FormD);
        return new string(d.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray())
            .ToLowerInvariant();
    }

    private static string Svg(string reason)
    {
        var k = Key(reason);
        var art = k switch
        {
            _ when k.Contains("reglage") => Reglage,
            _ when k.Contains("format") => Format,
            _ when k.Contains("bobine") => Bobine,
            _ when k.Contains("soudure") => Soudure,
            _ when k.Contains("film") => Film,
            _ when k.Contains("impression") || k.Contains("marquage") => Impression,
            _ when k.Contains("demarrage") => Demarrage,
            _ when k.Contains("arret") => Arret,
            _ when k.Contains("specification") => HorsSpec,
            _ when k.Contains("casse") || k.Contains("brisure") => Casse,
            _ when k.Contains("vidange") || k.Contains("nettoyage") => Nettoyage,
            _ when k.Contains("autre") => Autre,
            _ => Generic,
        };
        return $"<svg viewBox='0 0 64 64' aria-hidden='true' focusable='false'>{art}</svg>";
    }

    // Each: a soft disc, then the drawing.
    private const string Reglage =
        "<circle cx='32' cy='32' r='30' fill='#DBEAFE'/>" +
        "<g class='ma-spin' style='transform-origin:27px 30px'><circle cx='27' cy='30' r='15' fill='none' stroke='#64748B' stroke-width='6' stroke-dasharray='4.7 3.15'/>" +
        "<circle cx='27' cy='30' r='12.5' fill='#64748B'/><circle cx='27' cy='30' r='5.5' fill='#DBEAFE'/></g>" +
        "<path fill='#F59E0B' stroke='#B45309' stroke-width='1.2' d='M50.5 40.5a7 7 0 0 1-9.2 6.9l-8.6 8.6a3 3 0 0 1-4.2-4.2l8.6-8.6a7 7 0 0 1 8.7-9.1l-4.3 4.3 1.5 3.7 3.7 1.5z'/>";

