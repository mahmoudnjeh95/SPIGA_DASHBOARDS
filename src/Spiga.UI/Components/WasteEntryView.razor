@* A1 (emballage) and A2 (produit) entry screen; one page per kind wraps it.
   Context = date + poste. Without "Saisir pour un autre poste" it is fixed:
   the poste of the user's team in progress (or just ended). A team-bound
   account sees its team's postes only. *@
@inherits SpigaPage
@inject WasteService Waste
@inject PlantData Plant

<RequireAccess Module="@Modules.SaisieDechets">
    @if (Kind == WasteKind.Produit && !Waste.CanEnter(Actor, Kind) && !Session.Can(Perm.DechetsValider))
    {
        <div class="card" style="max-width:640px">
            <h2>Accès refusé</h2>
            <p>Le déchet produit se saisit par secteur : vos rôles (@Actor.RoleNames) ne donnent pas le droit « Saisir les déchets produit ».</p>
        </div>
    }
    else
    {
        <div class="head">
            <div>
                <span class="pre">Saisie</span><h1>@Title</h1>
                <p>
                    @(Kind == WasteKind.Emballage ? "Interface A1 : par machine, équipe et poste." : "Interface A2 : par secteur.")
                    Une saisie reste « à valider » jusqu'à sa validation par une autre personne, qui peut aussi vous la renvoyer
                    avec un commentaire ; validée, elle est verrouillée. Chaque changement est gardé dans son historique.
                </p>
            </div>
        </div>

        @* Context of the entry, not a filter: what is entered is attached to it. *@
        <div class="filters">
            @if (_choosePoste)
            {
                <div class="f">
                    <label for="w-date">Date de production</label>
                    <input id="w-date" type="date" value="@_date.ToString("yyyy-MM-dd")" max="@Shifts.ProductionDate(Now).ToString("yyyy-MM-dd")" @onchange="OnDateAsync" />
                </div>
                <div class="f">
                    <span>Poste</span>
                    <div class="segs" role="group" aria-label="Poste">
                        @* A team-bound account sees the postes of its team only. *@
                        @foreach (var s in Shifts.All.Where(s => Plant.IsOwnShift(Actor, _date, s)))
                        {
                            <button type="button" class="seg @(_shift == s ? "on" : "")" @onclick="() => OnShiftAsync(s)">
                                @Shifts.Label(s) <span style="font-weight:400">@Shifts.Hours(s)</span>
                            </button>
                        }
                    </div>
                </div>
            }
            else if (_poste is { } p)
            {
                <div class="f">
                    <span>Votre poste</span>
                    <span class="chip acc" style="align-self:flex-start;margin-top:5px"
                          title="Vous saisissez pour le poste de votre équipe en cours (ou qui vient de finir)">
                        @Shifts.Label(p.ShiftId) du @p.Date.ToString("dd/MM/yyyy") · @Shifts.Hours(p.ShiftId)
                    </span>
                </div>
            }
            <div class="f">
                <span>Équipe du poste</span>
                <span class="chip acc" style="align-self:flex-start;margin-top:5px">@_team</span>
            </div>
        </div>

        @if (!_choosePoste && _poste == null)
        {
            <div class="notice warn" role="status">Votre équipe (@Actor.Team) n'a pas de poste en cours ou récent : la saisie se fait pendant ou juste après son poste.</div>
        }
        @if (_choosePoste && !Shifts.All.Any(s => Plant.IsOwnShift(Actor, _date, s)))
        {
            <div class="notice warn" role="status">Votre équipe (@Actor.Team) n'a pas travaillé le @_date.ToString("dd/MM/yyyy").</div>
        }
        <Flash Error="@Error" Info="@Info" />

        @if (_returned.Count > 0)
        {
            <section class="card" style="border-color:var(--bad)">
                <div class="card-head">
                    <h2>Renvoyées à corriger <small>@_returned.Count saisie(s) : un validateur vous demande une correction</small></h2>
                </div>
                <WasteEntryTable Entries="_returned" ShowPoste="true" EditingId="_editing?.Id" OnEdit="Edit" OnChanged="LoadAsync" />
            </section>
        }

        @if (Waste.CanEnter(Actor, Kind) && (_choosePoste || _poste != null) || _editing != null)
        {
            <section class="card">
                <div class="card-head">
                    <h2>
                        @(_editing == null ? "Nouvelle saisie" : _editing.Status == WasteStatus.Validee ? $"Corriger la saisie n°{_editing.Id}" : $"Modifier la saisie n°{_editing.Id}")
                        @* The poste chosen above: said again only for an entry of another poste. *@
                        @if (_editing != null && (_editing.ProductionDate.Date != _date.Date || _editing.ShiftId != _shift))
                        {
                            <small>@Shifts.Label(EditShift) du @EditDate.ToString("dd/MM/yyyy") · @Plant.TeamOnShift(EditDate, EditShift)</small>
                        }
                    </h2>
                </div>
                @if (_editing?.Status == WasteStatus.Renvoyee)
                {
                    <div class="notice warn" style="margin-bottom:10px">Renvoyée par @_editing.ReturnedBy : « @_editing.ReturnComment ». Enregistrer la soumet à nouveau à la validation.</div>
                }
                @{ var check = Check; }
                <form class="form" @onsubmit="SaveAsync" novalidate>
                    @if (Kind == WasteKind.Emballage)
                    {
                        <div class="f">
                            <label for="w-machine">Machine</label>
                            <select id="w-machine" @bind="_machine" class="@Missing(check, "la machine")">
                                @if (_machines.Count != 1)
                                {
                                    <option value="">Choisir…</option>
                                }
                                @foreach (var m in _machines)
                                {
                                    <option value="@m.Id">@m.Name · @Sectors.Label(m.Sector)</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="f">
                            <label for="w-sector">Secteur</label>
                            <select id="w-sector" @bind="_sector" class="@Missing(check, "le secteur")">
                                <option value="">Choisir…</option>
                                @foreach (var s in Waste.SectorsFor(Actor))
                                {
                                    <option value="@s">@Sectors.Label(s)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="f">
                        <label for="w-qty">Quantité</label>
                        <input id="w-qty" inputmode="decimal" size="8" placeholder="0,0" autocomplete="off" maxlength="12"
                               class="@(check.QuantityError != null ? "invalid" : Missing(check, "la quantité"))" aria-invalid="@(check.QuantityError != null)"
                               aria-describedby="w-form-check" @bind="_quantity" @bind:event="oninput" />
                    </div>
                    <div class="f">
                        <label for="w-unit">Unité</label>
                        <select id="w-unit" @bind="_unit">
                            @foreach (var u in WasteUnits.All)
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                    </div>
                    <div class="f">
                        <label for="w-reason">Motif</label>
                        <select id="w-reason" @bind="_reason" class="@Missing(check, "le motif")">
                            <option value="">Choisir…</option>
                            @foreach (var r in _reasons)
                            {
                                <option value="@r.Label">@r.Label</option>
                            }
                        </select>
                    </div>
                    <div class="f grow">
                        <label for="w-comment">Commentaire@(WasteReasons.NeedsComment(_reason) ? " (obligatoire pour « Autre »)" : "")</label>
                        <input id="w-comment" maxlength="500" class="@Missing(check, "un commentaire (motif « Autre »)")" @bind="_comment" @bind:event="oninput" />
                    </div>
                    @if (_editing?.Status == WasteStatus.Validee)
                    {
                        <div class="f grow">
                            <label for="w-fix">Motif de la correction (obligatoire)</label>
                            <input id="w-fix" maxlength="300" class="@Missing(check, "le motif de la correction")" @bind="_correction" @bind:event="oninput" />
                        </div>
                    }
                    <button class="bar acc" type="submit" disabled="@(!check.Complete || _busy)"
                            title="@(check.Complete ? null : "À compléter : " + string.Join(", ", check.Missing))">
                        @(NeedsConfirmation(check) ? $"Confirmer {Fmt.Kg(check.QuantityKg!.Value)}"
                            : _editing == null ? "Ajouter" : _editing.Status == WasteStatus.Renvoyee ? "Enregistrer et soumettre à nouveau" : "Enregistrer")
                    </button>
                    @if (_editing != null)
                    {
                        <button class="bar" type="button" @onclick="CancelEdit">Annuler</button>
                    }
                </form>
                @* Checked while typing: what is wrong at once, what is missing once the user has started. *@
                <div id="w-form-check" class="form-check" aria-live="polite">
                    @if (check.QuantityError != null)
                    {
                        <span class="bad">Quantité : @check.QuantityError</span>
                    }
                    else if (NeedsConfirmation(check))
                    {
                        <span class="warn">
                            Quantité inhabituelle : @Fmt.Kg(check.QuantityKg!.Value) (au-delà de @Fmt.Kg(WasteFormCheck.UnusualKg(Kind))).
                            Vérifiez la virgule et l'unité, puis cliquez sur « Confirmer ».
                        </span>
                    }
                    else if (check.Missing.Count > 0 && Started)
                    {
                        <span>À compléter : @string.Join(", ", check.Missing).</span>
                    }
                    else if (check.Complete && _unit == WasteUnits.Tonne && check.QuantityKg is { } t)
                    {
                        <span>= @Fmt.Kg(t)</span>
                    }
                </div>
            </section>
        }

        <section class="card">
            <div class="card-head">
                <h2>
                    Saisies du poste
                    <small>
                        @if (_entries.Count > 0)
                        {
                            @($"{_entries.Count} saisie(s) · total {Fmt.Kg(_entries.Where(e => e.Counts).Sum(e => e.QuantityKg))}")
                        }
                        @if (_returned.Any(r => r.ProductionDate == _date && r.ShiftId == _shift))
                        {
                            @($" · + {_returned.Count(r => r.ProductionDate == _date && r.ShiftId == _shift)} renvoyée(s) à corriger, ci-dessus")
                        }
                    </small>
                </h2>
            </div>
            <WasteEntryTable Entries="_entries" EditingId="_editing?.Id" OnEdit="Edit" OnChanged="LoadAsync" Empty="Aucune saisie pour ce poste." />
            @if (Session.Policy.RequireSecondValidator && Session.Can(Perm.DechetsValider))
            {
                <p class="nd" style="font-size:12px">Vos propres saisies, et celles que vous avez modifiées, doivent être validées par une autre personne.</p>
            }
        </section>
    }
</RequireAccess>

@code {
    [Parameter, EditorRequired] public WasteKind Kind { get; set; }

    // From the "À valider" page: open this poste, and this entry in the form.
    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public int? Shift { get; set; }
    [Parameter] public long? EditId { get; set; }

    private string Title => Kind == WasteKind.Emballage ? "Déchets emballage" : "Déchets produit";

    private bool _choosePoste;
    private (DateTime Date, int ShiftId)? _poste;
    private DateTime _date;
    private int _shift;
    private string _team = "";
    private IReadOnlyList<PlantMachine> _machines = Array.Empty<PlantMachine>();
    private IReadOnlyList<WasteReason> _reasons = Array.Empty<WasteReason>();
    private IReadOnlyList<WasteEntry> _entries = Array.Empty<WasteEntry>();
    private IReadOnlyList<WasteEntry> _returned = Array.Empty<WasteEntry>();
    private WasteKind _loadedKind;
    private long? _openedEditId;

    private string _machine = "";
    private string _sector = "";
    private string _quantity = "";
    private string _unit = WasteUnits.Kg;
    private string _reason = "";
    private string _comment = "";
    private string _correction = "";
    private WasteEntry? _editing;
    private bool _busy;
    private double? _confirmedKg;

    private WasteFormCheck Check => WasteFormCheck.Of(new WasteFormInput(
        Kind, Kind == WasteKind.Emballage ? _machine : _sector, _quantity, _unit, _reason, _comment,
        _editing?.Status == WasteStatus.Validee, _correction));

    // The user has started filling the form (missing fields are then named).
    private bool Started => _quantity.Length > 0 || _comment.Length > 0 || _editing != null;

    private string Missing(WasteFormCheck check, string what) => Started && check.Missing.Contains(what) ? "missing" : "";

    private bool NeedsConfirmation(WasteFormCheck check) => check.Complete && check.Unusual && _confirmedKg != check.QuantityKg;

    // An entry keeps its own date and poste when it is changed.
    private DateTime EditDate => _editing?.ProductionDate ?? _date;
    private int EditShift => _editing?.ShiftId ?? _shift;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.Can(Modules.SaisieDechets, AppAction.Voir))
            return;
        _choosePoste = Waste.CanChoosePoste(Actor);
        _poste = Waste.CurrentPoste(Actor);
        if (_date == default || Date != null)
        {
            if (_choosePoste)
            {
                _date = Date?.Date ?? Shifts.ProductionDate(Now);
                _shift = Shift is { } s && Shifts.All.Contains(s) ? s : Shifts.At(Now);
                KeepOwnShift();
            }
            else
            {
                (_date, _shift) = _poste ?? (Shifts.ProductionDate(Now), Shifts.At(Now));
            }
        }
        if (_loadedKind != Kind || _reasons.Count == 0)
        {
            _loadedKind = Kind;
            CancelEdit();
            Error = Info = null;
            await Run(async () =>
            {
                _reasons = await Waste.ReasonsAsync(Kind);
                _machines = Kind == WasteKind.Emballage ? await Waste.MachinesFor(Actor) : Array.Empty<PlantMachine>();
            });
        }
        await LoadAsync();
        if (EditId is { } id && _openedEditId != id)
        {
            _openedEditId = id;
            if (_entries.Concat(_returned).FirstOrDefault(e => e.Id == id) is { } target && Waste.CanEdit(Actor, target))
                Edit(target);
        }
        ResetForm();
    }

    private async Task OnDateAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d))
        {
            _date = d.Date;
            KeepOwnShift();
            CancelEdit();
            await LoadAsync();
        }
    }

    private async Task OnShiftAsync(int shift)
    {
        _shift = shift;
        CancelEdit();
        await LoadAsync();
    }

    // A team-bound account starts on (and comes back to) its team's poste of the day.
    private void KeepOwnShift()
    {
        if (!Plant.IsOwnShift(Actor, _date, _shift) && Shifts.All.FirstOrDefault(s => Plant.IsOwnShift(Actor, _date, s)) is var own && own != 0)
            _shift = own;
    }

    private async Task LoadAsync()
    {
        _team = Plant.TeamOnShift(_date, _shift);
        var own = Plant.IsOwnShift(Actor, _date, _shift);
        _returned = (await Waste.ReturnedToAsync(Actor)).Where(e => e.Kind == Kind).ToList();
        // The actor's own returned entries are in the "Renvoyées à corriger" box above, not twice.
        _entries = own
            ? (await Waste.ListAsync(Actor, Kind, _date, _shift)).Where(e => !_returned.Any(r => r.Id == e.Id)).ToList()
            : Array.Empty<WasteEntry>();

        // The entry being edited changed meanwhile (validated, sent back...):
        // the form closes, the list shows its new state.
        if (_editing != null)
        {
            var fresh = _entries.Concat(_returned).FirstOrDefault(e => e.Id == _editing.Id);
            if (fresh == null || fresh.Version != _editing.Version)
                CancelEdit();
        }
    }

    // A single machine in scope is preselected.
    private void ResetForm()
    {
        if (_editing == null && Kind == WasteKind.Emballage && _machines.Count == 1)
            _machine = _machines[0].Id;
        if (_editing == null && Kind == WasteKind.Produit && string.IsNullOrEmpty(_sector) && Waste.SectorsFor(Actor) is { Count: 1 } only)
            _sector = only[0];
    }

    private async Task SaveAsync()
    {
        var check = Check;
        if (!check.Complete || _busy)
            return;
        // A quantity far above the usual is sent on the second click only.
        if (NeedsConfirmation(check))
        {
            _confirmedKg = check.QuantityKg;
            return;
        }
        var qty = check.Quantity!.Value;
        var draft = new WasteDraft(Kind, EditDate, EditShift,
            Kind == WasteKind.Emballage ? _machine : null,
            Kind == WasteKind.Produit ? _sector : null,
            qty, _unit, _reason, _comment);
        var editing = _editing;
        _busy = true;
        bool ok;
        try
        {
            ok = editing == null
                ? await Run(() => Waste.AddAsync(Actor, draft), "Saisie enregistrée : elle attend sa validation.")
                : await Run(() => Waste.UpdateAsync(Actor, editing.Id, editing.Version, draft, _correction),
                    editing.Status switch
                    {
                        WasteStatus.Validee => "Correction enregistrée et gardée dans l'historique de la saisie.",
                        WasteStatus.Renvoyee => "Saisie corrigée et soumise à nouveau à la validation.",
                        _ => "Saisie modifiée.",
                    });
        }
        finally
        {
            _busy = false;
        }
        if (ok)
            CancelEdit();
        await LoadAsync();
        ResetForm();
    }

    private void Edit(WasteEntry e)
    {
        _editing = e;
        _machine = e.MachineId ?? "";
        _sector = e.Sector;
        _quantity = e.Quantity.ToString("0.###", CultureInfo.GetCultureInfo("fr-FR"));
        _unit = e.Unit;
        _reason = e.Reason;
        _comment = e.Comment;
        _correction = "";
        Error = Info = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _quantity = _comment = _correction = "";
        _confirmedKg = null;
    }
}
