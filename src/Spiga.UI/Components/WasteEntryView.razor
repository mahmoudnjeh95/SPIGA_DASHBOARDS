@* A1 (emballage) and A2 (produit) entry screen; one page per kind wraps it. *@
@inherits SpigaPage
@inject WasteService Waste
@inject PlantData Plant

<RequireAccess Module="@Modules.SaisieDechets">
    <div class="head">
        <div>
            <span class="pre">Saisie</span><h1>@Title</h1>
            <p>
                @(Kind == WasteKind.Emballage ? "Interface A1 : par machine, équipe et poste." : "Interface A2 : par secteur.")
                Une saisie reste en brouillon jusqu'à sa validation par une autre personne ; validée, elle est verrouillée.
            </p>
        </div>
    </div>

    @* Context of the entry, not a filter: what is entered is attached to it. *@
    <div class="filters">
        <div class="f">
            <label for="w-date">Date de production</label>
            <input id="w-date" type="date" value="@_date.ToString("yyyy-MM-dd")" max="@Shifts.ProductionDate(Now).ToString("yyyy-MM-dd")" @onchange="OnDateAsync" />
        </div>
        <div class="f">
            <span>Poste</span>
            <div class="segs" role="group" aria-label="Poste">
                @foreach (var s in Shifts.All)
                {
                    @* A poste of another team stays visible, greyed out: a click says why. *@
                    var own = Plant.IsOwnShift(Actor, _date, s);
                    <button type="button" class="seg @(_shift == s ? "on" : "") @(own ? "" : "off-team")" aria-disabled="@(!own)"
                            title="@(own ? null : "Poste de " + Plant.TeamOnShift(_date, s) + " : ne concerne pas votre équipe")"
                            @onclick="() => OnShiftAsync(s)">@Shifts.Label(s) <span style="font-weight:400">@Shifts.Hours(s)</span></button>
                }
            </div>
        </div>
        <div class="f">
            <span>Équipe du poste</span>
            <span class="chip acc" style="align-self:flex-start;margin-top:5px">@_team</span>
        </div>
        @if (Actor.Team is { } myTeam)
        {
            <div class="f">
                <span>Votre équipe</span>
                <span class="chip" style="align-self:flex-start;margin-top:5px" title="Votre compte est rattaché à cette équipe : seuls ses postes vous concernent">@myTeam</span>
            </div>
        }
        <span class="sp"></span>
        <span class="chip" title="La date et le poste sont attachés à chaque saisie">Contexte de saisie</span>
    </div>

    @if (_teamNote != null)
    {
        <div class="notice warn" role="status">@_teamNote</div>
    }
    <Flash Error="@Error" Info="@Info" />

    @if (Session.Can(Modules.SaisieDechets, AppAction.Saisir))
    {
        <section class="card">
            <div class="card-head">
                <h2>@(_editing == null ? "Nouvelle saisie" : $"Modifier la saisie n°{_editing.Id}") <small>@Shifts.Label(_shift) du @_date.ToString("dd/MM/yyyy") · @_team</small></h2>
            </div>
            <form class="form" @onsubmit="SaveAsync">
                @if (Kind == WasteKind.Emballage)
                {
                    <div class="f">
                        <label for="w-machine">Machine</label>
                        <select id="w-machine" @bind="_machine">
                            <option value="">Choisir…</option>
                            @foreach (var m in _machines)
                            {
                                <option value="@m.Id">@m.Id · @Sectors.Label(m.Sector)</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="f">
                        <label for="w-sector">Secteur</label>
                        <select id="w-sector" @bind="_sector">
                            <option value="">Choisir…</option>
                            @foreach (var s in Waste.SectorsFor(Actor))
                            {
                                <option value="@s">@Sectors.Label(s)</option>
                            }
                        </select>
                    </div>
                }
                <div class="f">
                    <label for="w-qty">Quantité</label>
                    <input id="w-qty" inputmode="decimal" size="8" placeholder="0,0" @bind="_quantity" @bind:event="oninput" />
                </div>
                <div class="f">
                    <label for="w-unit">Unité</label>
                    <select id="w-unit" @bind="_unit">
                        @foreach (var u in WasteUnits.All)
                        {
                            <option value="@u">@u</option>
                        }
                    </select>
                </div>
                <div class="f">
                    <label for="w-reason">Motif</label>
                    <select id="w-reason" @bind="_reason">
                        <option value="">Choisir…</option>
                        @foreach (var r in _reasons)
                        {
                            <option value="@r.Label">@r.Label</option>
                        }
                    </select>
                </div>
                <div class="f grow">
                    <label for="w-comment">Commentaire</label>
                    <input id="w-comment" maxlength="500" @bind="_comment" @bind:event="oninput" />
                </div>
                @if (_editing?.Status == WasteStatus.Validee)
                {
                    <div class="f grow">
                        <label for="w-fix">Motif de la correction (obligatoire)</label>
                        <input id="w-fix" maxlength="200" @bind="_correction" @bind:event="oninput" />
                    </div>
                }
                <button class="bar acc" type="submit">@(_editing == null ? "Ajouter" : "Enregistrer")</button>
                @if (_editing != null)
                {
                    <button class="bar" type="button" @onclick="CancelEdit">Annuler</button>
                }
            </form>
        </section>
    }

    <section class="card">
        <div class="card-head">
            <h2>Saisies du poste <small>@_entries.Count saisie(s) · total @Fmt.Kg(_entries.Sum(e => e.QuantityKg))</small></h2>
            @if (_validatable.Count > 1)
            {
                <button type="button" class="bar acc small" @onclick="ValidateAllAsync">Valider les @_validatable.Count saisies</button>
            }
        </div>
        @if (_entries.Count == 0)
        {
            <p class="empty">Aucune saisie pour ce poste.</p>
        }
        else
        {
            <div class="scroll">
                <table class="t">
                    <thead>
                        <tr>
                            <th>N°</th><th>@(Kind == WasteKind.Emballage ? "Machine" : "Secteur")</th><th class="r">Quantité</th><th>Motif</th><th>Commentaire</th>
                            <th>Saisi par</th><th>État</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _entries)
                        {
                            <tr class="@(_editing?.Id == e.Id ? "sel" : "")">
                                <td class="n">@e.Id</td>
                                <td>@(e.MachineId ?? Sectors.Label(e.Sector))<small>@(e.MachineId == null ? "" : Sectors.Label(e.Sector))</small></td>
                                <td class="r">@Fmt.Num(e.Quantity, e.Quantity % 1 == 0 ? 0 : 2) @e.Unit</td>
                                <td class="n">@e.Reason</td>
                                <td class="n">@e.Comment</td>
                                <td class="n">@e.CreatedBy<small>@e.CreatedAt.ToString("dd/MM HH:mm")</small></td>
                                <td>
                                    @if (e.Status == WasteStatus.Validee)
                                    {
                                        <span class="chip ok" title="Validée le @Fmt.Date(e.ValidatedAt)">Validée · @e.ValidatedBy</span>
                                    }
                                    else
                                    {
                                        <span class="chip warn">Brouillon</span>
                                    }
                                </td>
                                <td>
                                    <div class="actions">
                                        @if (Waste.CanValidate(Actor, e, Session.Policy))
                                        {
                                            <button type="button" class="link" @onclick="() => ValidateAsync(e)">Valider</button>
                                        }
                                        @if (Waste.CanEdit(Actor, e))
                                        {
                                            <button type="button" class="link" @onclick="() => Edit(e)">@(e.Status == WasteStatus.Validee ? "Corriger" : "Modifier")</button>
                                        }
                                        @if (Waste.CanDelete(Actor, e))
                                        {
                                            @if (_confirmDelete == e.Id)
                                            {
                                                <button type="button" class="link danger" @onclick="() => DeleteAsync(e)">Confirmer la suppression</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="link danger" @onclick="() => _confirmDelete = e.Id">Supprimer</button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Session.Policy.RequireSecondValidator && Session.Can(Perm.DechetsValider))
        {
            <p class="nd" style="font-size:12px">Vos propres saisies doivent être validées par une autre personne.</p>
        }
    </section>
</RequireAccess>

@code {
    [Parameter, EditorRequired] public WasteKind Kind { get; set; }

    private string Title => Kind == WasteKind.Emballage ? "Déchets emballage" : "Déchets produit";

    private DateTime _date;
    private int _shift;
    private string _team = "";
    private string? _teamNote;
    private IReadOnlyList<PlantMachine> _machines = Array.Empty<PlantMachine>();
    private IReadOnlyList<WasteReason> _reasons = Array.Empty<WasteReason>();
    private IReadOnlyList<WasteEntry> _entries = Array.Empty<WasteEntry>();
    private List<WasteEntry> _validatable = new();
    private WasteKind _loadedKind;

    private string _machine = "";
    private string _sector = "";
    private string _quantity = "";
    private string _unit = WasteUnits.Kg;
    private string _reason = "";
    private string _comment = "";
    private string _correction = "";
    private WasteEntry? _editing;
    private long? _confirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.Can(Modules.SaisieDechets, AppAction.Voir))
            return;
        if (_date == default)
        {
            _date = Shifts.ProductionDate(Now);
            _shift = Shifts.At(Now);
            KeepOwnShift();
        }
        if (_loadedKind != Kind || _reasons.Count == 0)
        {
            _loadedKind = Kind;
            CancelEdit();
            Error = Info = null;
            await Run(async () =>
            {
                _reasons = await Waste.ReasonsAsync(Kind);
                _machines = Kind == WasteKind.Emballage ? await Waste.MachinesFor(Actor) : Array.Empty<PlantMachine>();
            });
        }
        await LoadAsync();
    }

    private async Task OnDateAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d))
        {
            _date = d.Date;
            _teamNote = null;
            KeepOwnShift();
            CancelEdit();
            await LoadAsync();
        }
    }

    private async Task OnShiftAsync(int shift)
    {
        if (!Plant.IsOwnShift(Actor, _date, shift))
        {
            _teamNote = Plant.ForeignShiftMessage(Actor, _date, shift);
            return;
        }
        _teamNote = null;
        _shift = shift;
        CancelEdit();
        await LoadAsync();
    }

    // A team-bound account starts on (and comes back to) its team's poste of the day.
    private void KeepOwnShift()
    {
        if (!Plant.IsOwnShift(Actor, _date, _shift) && Shifts.All.FirstOrDefault(s => Plant.IsOwnShift(Actor, _date, s)) is var own && own != 0)
            _shift = own;
    }

    private async Task LoadAsync()
    {
        _team = Plant.TeamOnShift(_date, _shift);
        _entries = await Waste.ListAsync(Actor, Kind, _date, _shift);
        _validatable = _entries.Where(e => Waste.CanValidate(Actor, e, Session.Policy)).ToList();
        _confirmDelete = null;
    }

    private async Task SaveAsync()
    {
        if (!double.TryParse(_quantity.Replace(',', '.').Replace(" ", ""), NumberStyles.Float, CultureInfo.InvariantCulture, out var qty))
        {
            Error = "Indiquez la quantité (nombre, par exemple 12,5).";
            Info = null;
            return;
        }
        var draft = new WasteDraft(Kind, _date, _shift,
            Kind == WasteKind.Emballage ? _machine : null,
            Kind == WasteKind.Produit ? _sector : null,
            qty, _unit, _reason, _comment);
        var editing = _editing;
        var ok = editing == null
            ? await Run(() => Waste.AddAsync(Actor, draft), "Saisie enregistrée en brouillon.")
            : await Run(() => Waste.UpdateAsync(Actor, editing.Id, draft, _correction),
                editing.Status == WasteStatus.Validee ? "Correction enregistrée et tracée dans le journal d'audit." : "Saisie modifiée.");
        if (ok)
        {
            _quantity = _comment = _correction = "";
            _editing = null;
            await LoadAsync();
        }
    }

    private void Edit(WasteEntry e)
    {
        _editing = e;
        _machine = e.MachineId ?? "";
        _sector = e.Sector;
        _quantity = e.Quantity.ToString("0.###", CultureInfo.GetCultureInfo("fr-FR"));
        _unit = e.Unit;
        _reason = e.Reason;
        _comment = e.Comment;
        _correction = "";
        Error = Info = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _quantity = _comment = _correction = "";
    }

    private async Task ValidateAsync(WasteEntry e)
    {
        if (await Run(() => Waste.ValidateAsync(Actor, e.Id), $"Saisie n°{e.Id} validée."))
            await LoadAsync();
    }

    private async Task ValidateAllAsync()
    {
        var count = _validatable.Count;
        if (await Run(async () =>
            {
                foreach (var e in _validatable)
                    await Waste.ValidateAsync(Actor, e.Id);
            }, $"{count} saisies validées."))
            await LoadAsync();
    }

    private async Task DeleteAsync(WasteEntry e)
    {
        if (await Run(() => Waste.DeleteAsync(Actor, e.Id), $"Saisie n°{e.Id} supprimée."))
        {
            if (_editing?.Id == e.Id)
                CancelEdit();
            await LoadAsync();
        }
    }
}
