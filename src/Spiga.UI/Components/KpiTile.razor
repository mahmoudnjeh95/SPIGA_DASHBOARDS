@* A figure tile. Its value counts up (spiga.js), its colour is its band
   (Css: ok / warn / bad / nd), and a tile in the red breathes a red outline.
   As on the kiosk (KpiRow, TileFx, TrendBadge, TrsRing), optionally:
   - RingTarget set: the value (Ring) as a ring filling up to it, with a
     tick at the target (no value: the empty track);
   - Trend: the arrow of the last minutes (the kiosk's icons) and the change,
     in the colour of what it means;
   - Flash: the change since this tile was last on screen ("▲ +1,2 pt"),
     glowing green (FlashGood) or red for a few seconds. *@
<div class="card kpi @(Missing ? "na" : "") @(Flash != null ? (FlashGood ? "flash-good" : "flash-bad") : "")" @key="FlashKey">
    <span class="l">@Label @if (!string.IsNullOrEmpty(Hint)) { <small>(@Hint)</small> }</span>
    <div class="kv">
        <span class="v @Css">@Value</span>
        @if (Trend is { } t)
        {
            <span class="kpi-trend @(t.Direction > 0 ? "up" : t.Direction < 0 ? "down" : "flat")" title="@t.Text">
                @if (t.Direction == 0)
                {
                    <i class="flat-bar"></i>
                }
                else
                {
                    <img src="_content/Spiga.UI/img/trend/@(TrendIcon(t))" alt="@(t.Direction > 0 ? "En hausse" : "En baisse")" />
                }
                <small class="@(t.Good > 0 ? "good" : t.Good < 0 ? "bad" : "")">@t.Text</small>
            </span>
        }
        @if (RingTarget is not null)
        {
            // No value: the empty track only (kiosk TrsRing).
            var pct = Math.Clamp(Ring ?? 0, 0, 100);
            var angle = Math.Clamp(RingTarget ?? -1, 0, 100) / 100 * 2 * Math.PI - Math.PI / 2;
            <svg class="kpi-ring" viewBox="0 0 44 44" aria-hidden="true">
                <circle class="track" cx="22" cy="22" r="18" />
                @if (Ring is not null)
                {
                    <circle class="fill" cx="22" cy="22" r="18" pathLength="100" style="--p:@pct.ToString("0.#", CultureInfo.InvariantCulture)" />
                }
                @if (RingTarget is not null)
                {
                    var (x1, y1, x2, y2) = (22 + 13 * Math.Cos(angle), 22 + 13 * Math.Sin(angle), 22 + 23 * Math.Cos(angle), 22 + 23 * Math.Sin(angle));
                    <line class="target" x1="@N(x1)" y1="@N(y1)" x2="@N(x2)" y2="@N(y2)" />
                }
            </svg>
        }
    </div>
    <span class="s">@Sub</span>
    @if (Flash != null)
    {
        <span class="kpi-flash">@Flash</span>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? Css { get; set; }
    [Parameter] public string? Sub { get; set; }
    [Parameter] public bool Missing { get; set; }

    [Parameter] public double? Ring { get; set; }
    [Parameter] public double? RingTarget { get; set; }
    [Parameter] public SpigaDashboards.App.ViewModels.Slides.KpiTrend? Trend { get; set; }
    [Parameter] public string? Flash { get; set; }
    [Parameter] public bool FlashGood { get; set; }

    // A new flash restarts its animation (the tile is drawn again).
    private string FlashKey => Flash == null ? "" : Flash + FlashGood;

    private static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // The kiosk's arrows: rising red when rising is bad (weight away from its
    // target), falling green when falling is good.
    private static string TrendIcon(SpigaDashboards.App.ViewModels.Slides.KpiTrend t)
        => t.Direction > 0 ? (t.Good < 0 ? "trend-up-red.png" : "trend-up.png")
            : (t.Good > 0 ? "trend-down-green.png" : "trend-down.png");
}
