@* Root component of both hosts. Nothing of the application is reachable
   before the gate: first installation, sign-in, forced password change,
   inactivity lock. Screen (desktop application only): "kiosk" (hall PC:
   the dashboard without sign-in, « Se connecter » for the rest) or "tv"
   (the TV window: the slides alone), see KioskScreen. *@
@implements IDisposable
@inject UserSession Session
@inject AuthService Auth
@inject ClientInfo Client
@inject IDesktopBridge Desktop
@inject ISessionStore Store
@inject NavigationManager Nav
@inject SpigaDashboards.App.Models.AppSettings StationSettings

<div class="spiga-root" data-theme="@Session.Theme">
    @if (_error != null)
    {
        <div class="gate"><div class="gate-card"><Brand /><h1>Démarrage impossible</h1><div class="notice error">@_error</div></div></div>
    }
    else if (!_ready)
    {
        <Loader Full="true" />
    }
    else if (_needsSetup)
    {
        <Setup OnDone="() => _needsSetup = false" />
    }
    else if (Session.IsScreen)
    {
        <KioskScreen Kiosk="@(Screen == "kiosk")" OnSignIn="SignInFromScreen" />
    }
    else if (Screen == "kiosk" && Session.Actor == null)
    {
        <Login />
        <div class="kiosk-back"><button type="button" class="bar" @onclick="BackToScreen">‹ Retour à l'écran</button></div>
    }
    else if (Session.Actor == null && !_welcomed)
    {
        <Welcome OnContinue="() => _welcomed = true" />
    }
    else if (Session.Actor == null)
    {
        <Login />
    }
    else if (Session.Actor.User.MustChangePassword)
    {
        <div class="gate">
            <div class="gate-card">
                <Brand />
                <h1>Nouveau mot de passe</h1>
                <p>Bonjour @Session.Actor.DisplayName. Votre mot de passe est temporaire : choisissez le vôtre pour continuer.</p>
                <ChangePasswordForm />
                <button type="button" class="link" @onclick="Session.SignOutAsync">Se déconnecter</button>
            </div>
        </div>
    }
    else if (Session.IsLocked)
    {
        <LockScreen />
    }
    else if (OpenModes.For(Session.Actor) is { Count: 0 })
    {
        <div class="gate">
            <div class="gate-card">
                <Brand />
                <h1>Aucun écran à ouvrir</h1>
                <p>Vos rôles ne donnent ni l'application, ni SPIGA Dashboard, ni SPIGA TV. Demandez-les à un administrateur.</p>
                <button type="button" class="link" @onclick="Session.SignOutAsync">Se déconnecter</button>
            </div>
        </div>
    }
    else if (_mode == null && !Desktop.IsAvailable && OpenModes.For(Session.Actor) is { Count: > 1 } choice)
    {
        <ModeChooser Modes="choice" OnPick="Pick" />
    }
    else if (Mode == SpigaMode.Dashboard)
    {
        var open = OpenModes.For(Session.Actor);
        <KioskScreen Kiosk="true"
                     OnApp="@(open.Contains(SpigaMode.App) ? EventCallback.Factory.Create(this, () => Pick(SpigaMode.App)) : default)"
                     OnTv="@(open.Contains(SpigaMode.Tv) ? EventCallback.Factory.Create(this, () => Pick(SpigaMode.Tv)) : default)" />
    }
    else if (Mode == SpigaMode.Tv)
    {
        var several = OpenModes.For(Session.Actor).Count > 1;
        <KioskScreen OnLeave="@(several ? EventCallback.Factory.Create(this, () => SetMode(null)) : EventCallback.Factory.Create(this, Session.SignOutAsync))"
                     LeaveLabel="@(several ? "Changer d'écran" : "Se déconnecter")" />
    }
    else
    {
        <Router AppAssembly="typeof(Routes).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="routeData" DefaultLayout="typeof(AppShell)" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(AppShell)">
                    <div class="card" style="max-width:640px"><h2>Page introuvable</h2><p>Cette adresse ne correspond à aucun écran. <a href="">Retour à l'accueil</a></p></div>
                </LayoutView>
            </NotFound>
        </Router>
    }
</div>

@code {
    // Web host: the client's address, written in the audit trail. The
    // desktop host leaves it null (the PC name is used).
    [Parameter] public string? Workstation { get; set; }

    [Parameter] public string? Screen { get; set; }

    // Kiosk: the sign-in form was asked for ("Se connecter").
    private bool _signingIn;

    // What was chosen after sign-in (ModeChooser); null = not yet. An
    // account with one mode only opens it directly (Mode).
    private SpigaMode? _mode;

    // The desktop application has a shortcut per mode: its own opens the
    // application when the account may.
    private SpigaMode Mode
    {
        get
        {
            if (_mode is { } chosen)
                return chosen;
            var open = OpenModes.For(Session.Actor);
            return Desktop.IsAvailable && open.Contains(SpigaMode.App) ? SpigaMode.App : open.FirstOrDefault();
        }
    }

    private void Pick(SpigaMode mode) => SetMode(mode);

    private void SetMode(SpigaMode? mode)
    {
        _mode = mode;
        _ = Store.SaveModeAsync(mode);
    }

    private bool _ready;
    // The welcome screen comes before the sign-in form, at start-up and
    // again after each sign-out (the next person at the PC).
    private bool _welcomed;
    private bool _hadActor;
    private bool _needsSetup;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Workstation))
            Client.Workstation = Workstation;
        Session.Changed += OnSessionChanged;
        try
        {
            _needsSetup = await Auth.NeedsSetupAsync();
            if (!_needsSetup && Session.Actor == null)
            {
                // A reload keeps the sign-in: it keeps the chosen screen too
                // (as long as the account may still open it).
                if (await Session.TryResumeAsync() && await Store.LoadModeAsync() is { } kept
                    && OpenModes.For(Session.Actor).Contains(kept))
                    _mode = kept;
            }
            _hadActor = Session.Actor != null;
            if (!_needsSetup && Screen is "kiosk" or "tv" && Session.Actor == null)
                Session.EnterScreen(ScreenAccount.Create(StationSettings));
            _ready = true;
        }
        catch (Exception ex)
        {
            _error = "La base applicative est injoignable : " + ex.Message;
        }
    }

    private void OnSessionChanged()
    {
        if (_hadActor && Session.Actor == null)
        {
            _welcomed = false;
            _mode = null;
        }
        _hadActor = Session.Actor != null;
        _ = InvokeAsync(async () =>
        {
            if (Screen is "kiosk" or "tv")
            {
                // A kiosk is never left locked: the person who signed in has
                // gone, the screen comes back.
                if (Session.IsLocked)
                {
                    await Session.SignOutAsync();
                    return;
                }
                if (Session.Actor != null)
                    _signingIn = false;
                else if (!_signingIn)
                {
                    Session.EnterScreen(ScreenAccount.Create(StationSettings));
                    return;
                }
            }
            StateHasChanged();
        });
    }

    private void SignInFromScreen()
    {
        _signingIn = true;
        Session.LeaveScreen();
    }

    private void BackToScreen()
    {
        _signingIn = false;
        Session.EnterScreen(ScreenAccount.Create(StationSettings));
    }

    // Sign-in, lock, first setup: no WPF page beside the rail (AppShell shows
    // it again on its page). Signed out: the pages are dropped, so the next
    // user does not find the previous one's unsaved edits.
    protected override void OnAfterRender(bool firstRender)
    {
        var showsApp = _ready && !_needsSetup && Session.Actor is { User.MustChangePassword: false } && !Session.IsLocked;
        if (Session.Actor == null)
            Desktop.DiscardNativePages();
        else if (!showsApp)
            Desktop.ShowNative(null, NativeAccess.None);
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
