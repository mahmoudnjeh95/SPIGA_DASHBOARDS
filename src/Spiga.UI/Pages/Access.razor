@page "/admin/acces"
@inherits SpigaPage
@inject AccessAdminService Admin
@inject PlantData Plant

<RequireAccess Module="@Modules.Utilisateurs">
    <div class="head">
        <div>
            <span class="pre">Administration</span><h1>Utilisateurs et rôles</h1>
            <p>Les rôles sont définis ici, sans limite de nombre, à partir des permissions de chaque module. Un utilisateur peut cumuler plusieurs rôles, chacun sur son périmètre (une équipe et des plateformes) et pour une période.</p>
        </div>
        @if (!CanRoles && !CanAccounts)
        {
            <span class="chip">Consultation seule</span>
        }
    </div>

    <div class="tabrow" role="tablist">
        <button type="button" role="tab" class="tab @(_tab == 0 ? "on" : "")" aria-selected="@(_tab == 0)" @onclick="() => _tab = 0">Rôles (@_roles.Count)</button>
        <button type="button" role="tab" class="tab @(_tab == 1 ? "on" : "")" aria-selected="@(_tab == 1)" @onclick="() => _tab = 1">Utilisateurs (@_users.Count)</button>
        <button type="button" role="tab" class="tab @(_tab == 3 ? "on" : "")" aria-selected="@(_tab == 3)" @onclick="() => _tab = 3">Plateformes (@_platforms.Count)</button>
        <button type="button" role="tab" class="tab @(_tab == 2 ? "on" : "")" aria-selected="@(_tab == 2)" @onclick="() => _tab = 2">Règles de sécurité</button>
    </div>

    <Flash Error="@Error" Info="@Info" />
    @if (_secret != null)
    {
        <div class="notice info" role="status">
            <div>
                Mot de passe temporaire de <b>@_secret.Value.Login</b> : <span class="secret">@_secret.Value.Password</span><br />
                <span style="font-weight:400">À remettre à l'utilisateur ; il ne sera plus affiché. Il devra le changer à la connexion.</span>
            </div>
            <button type="button" class="x" @onclick="() => _secret = null" aria-label="Fermer">✕</button>
        </div>
    }

    @if (_tab == 0)
    {
        <div class="row">
            @* ---------- role list ---------- *@
            <section class="card" style="flex:1 1 250px;max-width:320px">
                <div class="f"><label for="role-filter">Rechercher un rôle</label><input id="role-filter" @bind="_roleFilter" @bind:event="oninput" /></div>
                <div class="rolelist">
                    @foreach (var r in _roles.Where(r => string.IsNullOrWhiteSpace(_roleFilter) || r.Name.Contains(_roleFilter.Trim(), StringComparison.OrdinalIgnoreCase)))
                    {
                        <button type="button" class="rolebtn @(r.Id == _role?.Id ? "on" : "")" @onclick="() => SelectRole(r)">
                            <span>
                                @r.Name
                                @if (r.IsSystem) { <span class="chip" style="margin-left:4px">système</span> }
                                @if (!r.IsActive) { <span class="chip warn" style="margin-left:4px">inactif</span> }
                            </span>
                            <small title="Titulaires">@r.UserCount</small>
                        </button>
                    }
                </div>
                @if (CanRoles)
                {
                    <form class="form" style="border-top:1px solid var(--line);padding-top:10px" @onsubmit="CreateRoleAsync">
                        <div class="f grow"><label for="new-role">Nouveau rôle</label><input id="new-role" @bind="_newRoleName" @bind:event="oninput" placeholder="ex. Magasinier silos" /></div>
                        <button class="bar small" type="submit">Créer</button>
                    </form>
                    @if (MissingTemplates > 0)
                    {
                        <button type="button" class="link" style="align-self:flex-start" @onclick="AddTemplatesAsync">Ajouter les @MissingTemplates rôles types manquants</button>
                    }
                }
            </section>

            @* ---------- role editor ---------- *@
            @if (_role != null)
            {
                <section class="card" style="flex:4 1 620px">
                    <div class="card-head">
                        <h2>@_role.Name <small>@_role.UserCount titulaire(s) · @(_role.IsSystem ? PermissionCatalog.All.Count : _draft.Count) permission(s) sur @PermissionCatalog.All.Count</small></h2>
                        @if (CanRoles)
                        {
                            <div class="segs">
                                <button type="button" class="bar small" @onclick="DuplicateRoleAsync">Dupliquer</button>
                                @if (!_role.IsSystem)
                                {
                                    <button type="button" class="bar small danger" @onclick="DeleteRoleAsync" disabled="@(_role.UserCount > 0)"
                                            title="@(_role.UserCount > 0 ? "Retirez-le à ses titulaires ou désactivez-le" : "")">Supprimer</button>
                                }
                            </div>
                        }
                    </div>

                    @if (_role.IsSystem)
                    {
                        <div class="notice info">Rôle système : toutes les permissions, présentes et futures. Non modifiable, il garantit qu'un administrateur existe toujours.</div>
                    }
                    else
                    {
                        <div class="form">
                            <div class="f"><label for="role-name">Nom</label><input id="role-name" @bind="_roleName" @bind:event="oninput" disabled="@(!CanRoles)" /></div>
                            <div class="f grow"><label for="role-desc">Description</label><input id="role-desc" @bind="_roleDescription" @bind:event="oninput" disabled="@(!CanRoles)" /></div>
                            <label class="check" title="Un rôle inactif ne donne plus rien à ses titulaires"><input type="checkbox" @bind="_roleActive" disabled="@(!CanRoles)" />Rôle actif</label>
                        </div>
                    }

                    <h3 class="sub">Permissions</h3>
                    <div class="perm-grid">
                        @foreach (var domain in ModuleCatalog.All.GroupBy(m => m.Domain))
                        {
                            <div class="dom">@domain.Key</div>
                            @foreach (var m in domain)
                            {
                                var editable = CanRoles && !_role.IsSystem;
                                <div class="perm-row @(Perms.HasModule(m.Key) ? "has" : "")">
                                    <div class="perm-mod">
                                        <b>@m.Label</b><small>@m.Description</small>
                                        @if (editable)
                                        {
                                            <span class="perm-quick">
                                                <button type="button" class="link" @onclick="() => SetModule(m.Key, true)">Tout</button>
                                                <button type="button" class="link" @onclick="() => SetModule(m.Key, false)">Aucun</button>
                                            </span>
                                        }
                                    </div>
                                    <div class="perm-list">
                                        @foreach (var p in PermissionCatalog.ForModule(m.Key))
                                        {
                                            <label class="perm @(Perms.Has(p.Key) ? "on" : "")" title="@p.Description">
                                                <input type="checkbox" checked="@Perms.Has(p.Key)" disabled="@(!editable)"
                                                       @onchange="e => _draft.Set(p.Key, e.Value is true)" />@p.Label
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (!_role.IsSystem)
                    {
                        <h3 class="sub">Administration déléguée</h3>
                        <p class="nd" style="font-size:13px">
                            Rôles que les titulaires de « @_role.Name » peuvent attribuer, dans leur propre périmètre, s'ils ont la permission
                            « Créer et modifier des comptes »@(Perms.Has(Perm.ComptesGerer) ? "" : " (non cochée pour l'instant)").
                        </p>
                        <div class="checks">
                            @foreach (var r in _roles.Where(r => !r.IsSystem))
                            {
                                <label class="check"><input type="checkbox" checked="@_roleAssignable.Contains(r.Id)" disabled="@(!CanRoles)"
                                                            @onchange="e => ToggleAssignable(r.Id, e.Value is true)" />@r.Name</label>
                            }
                        </div>
                    }

                    <h3 class="sub">Titulaires</h3>
                    @{ var holders = _users.Where(u => u.Assignments.Any(a => a.RoleId == _role.Id)).ToList(); }
                    @if (holders.Count == 0)
                    {
                        <p class="empty">Aucun compte n'a ce rôle.</p>
                    }
                    else
                    {
                        <table class="t">
                            <thead><tr><th>Compte</th><th>Périmètre</th><th>Validité</th></tr></thead>
                            <tbody>
                                @foreach (var u in holders)
                                {
                                    @foreach (var a in u.Assignments.Where(a => a.RoleId == _role.Id))
                                    {
                                        <tr>
                                            <td>@u.Login<small>@u.DisplayName@(u.IsActive ? "" : " · désactivé")</small></td>
                                            <td class="n">@a.Scope.Describe()</td>
                                            <td class="n">@a.Validity()</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }

                    @if (CanRoles && !_role.IsSystem)
                    {
                        <div class="savebar">
                            <span class="nd">@(RoleDirty ? "Modifications non enregistrées" : "")</span>
                            <button type="button" class="bar" @onclick="() => SelectRole(_role)" disabled="@(!RoleDirty)">Annuler</button>
                            <button type="button" class="bar acc" @onclick="SaveRoleAsync" disabled="@(!RoleDirty)">Enregistrer le rôle</button>
                        </div>
                    }
                </section>
            }
        </div>
    }
    else if (_tab == 1)
    {
        <div class="row">
            @* ---------- user list ---------- *@
            <section class="card" style="flex:@(_form == null ? "3 1 560px" : "2 1 440px")">
                <div class="card-head">
                    <div class="form">
                        <div class="f"><label for="user-filter">Rechercher</label><input id="user-filter" @bind="_userFilter" @bind:event="oninput" placeholder="identifiant ou nom" /></div>
                        <div class="f">
                            <label for="user-role-filter">Rôle</label>
                            <select id="user-role-filter" @bind="_userRoleFilter">
                                <option value="0">Tous les rôles</option>
                                @foreach (var r in _roles)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (CanAccounts && _assignable.Count > 0)
                    {
                        <button type="button" class="bar acc small" @onclick="NewUser">Nouvel utilisateur</button>
                    }
                </div>
                <div class="scroll">
                    <table class="t">
                        <thead><tr><th>Compte</th><th>Rôles</th>@if (_form == null) { <th>Dernière connexion</th> }<th>État</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var u in FilteredUsers())
                            {
                                <tr class="@(_user?.Id == u.Id ? "sel" : "")">
                                    <td>@u.Login<small>@u.DisplayName</small></td>
                                    <td>
                                        @foreach (var a in u.Assignments)
                                        {
                                            <span class="chip @(a.IsCurrent(Now) ? "acc" : "")" style="margin:0 4px 3px 0" title="@a.Scope.Describe() · @a.Validity()">@a.RoleName@(a.Scope.IsUnrestricted ? "" : " · " + a.Scope.Describe())</span>
                                        }
                                    </td>
                                    @if (_form == null)
                                    {
                                        <td class="n">@Fmt.Ago(u.LastLoginAt, Now)</td>
                                    }
                                    <td>
                                        @if (!u.IsActive) { <span class="chip">Désactivé</span> }
                                        else if (u.IsLocked(Now)) { <span class="chip bad">Bloqué</span> }
                                        else if (u.MustChangePassword) { <span class="chip warn">Mot de passe à changer</span> }
                                        else { <span class="chip ok">Actif</span> }
                                    </td>
                                    <td><div class="actions"><button type="button" class="link" @onclick="() => EditUser(u)">@(_manageable.Contains(u.Id) ? "Modifier" : "Détail")</button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            @* ---------- user editor ---------- *@
            @if (_form != null)
            {
                var editable = _user == null || _manageable.Contains(_user.Id);
                <section class="card" style="flex:3 1 520px">
                    <div class="card-head">
                        <h2>@(_user == null ? "Nouvel utilisateur" : _user.Login)</h2>
                        <button type="button" class="link" @onclick="CloseUser">Fermer</button>
                    </div>
                    @if (!editable)
                    {
                        <div class="notice info">Ce compte a des rôles que vous ne gérez pas : consultation seule.</div>
                    }
                    <form @onsubmit="SaveUserAsync" style="display:flex;flex-direction:column;gap:12px">
                        <div class="form">
                            @if (_user == null)
                            {
                                <div class="f"><label for="u-login">Identifiant</label><input id="u-login" @bind="_form.Login" @bind:event="oninput" placeholder="prenom.nom" /></div>
                            }
                            <div class="f grow"><label for="u-name">Nom affiché</label><input id="u-name" @bind="_form.Name" @bind:event="oninput" disabled="@(!editable)" /></div>
                            <label class="check"><input type="checkbox" @bind="_form.Active" disabled="@(!editable)" />Compte actif</label>
                        </div>

                        <h3 class="sub">Rôles attribués</h3>
                        @if (!FormCoversTeams)
                        {
                            <p class="nd" style="font-size:12px;margin:0">
                                Compte d'équipe : choisissez son équipe, la même sur chaque rôle. Il ne verra que les postes de cette équipe ;
                                seuls les rôles avec « Couvrir plusieurs équipes » (responsables) en couvrent plusieurs.
                            </p>
                        }
                        @for (var i = 0; i < _form.Assignments.Count; i++)
                        {
                            var a = _form.Assignments[i];
                            var index = i;
                            <div class="assign">
                                <div class="form">
                                    <div class="f grow">
                                        <label for="@($"a{index}-role")">Rôle @(index + 1)</label>
                                        <select id="@($"a{index}-role")" @bind="a.RoleId" disabled="@(!editable)">
                                            @foreach (var r in RoleChoices(a.RoleId))
                                            {
                                                <option value="@r.Id">@r.Name@(r.IsActive ? "" : " (inactif)")</option>
                                            }
                                        </select>
                                    </div>
                                    @if (editable)
                                    {
                                        <button type="button" class="link danger" style="margin-bottom:9px" @onclick="() => _form.Assignments.RemoveAt(index)">Retirer</button>
                                    }
                                </div>
                                <div class="form">
                                    <div class="f"><label for="@($"a{index}-from")">Valide du</label><input id="@($"a{index}-from")" type="date" @bind="a.From" disabled="@(!editable)" /></div>
                                    <div class="f"><label for="@($"a{index}-to")">au</label><input id="@($"a{index}-to")" type="date" @bind="a.To" disabled="@(!editable)" /></div>
                                    <div class="f">
                                        <label for="@($"a{index}-team")">Équipe</label>
                                        <select id="@($"a{index}-team")" @bind="a.Team" disabled="@(!editable)">
                                            <option value="" disabled="@(!FormCoversTeams)">Toutes les équipes@(FormCoversTeams ? "" : " (responsables)")</option>
                                            @foreach (var t in Plant.Teams)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="f">
                                    <span>Plateformes <small class="nd">(aucune = toute l'usine)</small></span>
                                    @if (_platforms.Count == 0 && a.Platforms.Count == 0)
                                    {
                                        <small class="nd">Aucune plateforme définie@(Session.Can(Perm.PlateformesGerer) ? " : créez-les dans l'onglet Plateformes." : ".")</small>
                                    }
                                    <div class="checks">
                                        @foreach (var p in PlatformChoices(a))
                                        {
                                            <label class="check" title="@string.Join(", ", p.Machines.Select(m => m.MachineId))">
                                                <input type="checkbox" checked="@a.Platforms.Contains(p.Id)" disabled="@(!editable)"
                                                       @onchange="e => ToggleIn(a.Platforms, p.Id, e.Value is true)" />@p.Name@(p.IsActive ? "" : " (inactive)")
                                                <small class="nd">&nbsp;@p.Machines.Count machine(s)</small>
                                            </label>
                                        }
                                    </div>
                                </div>
                                @if (a.Sectors.Count > 0 || a.Machines.Count > 0)
                                {
                                    <div class="notice info" style="margin:0">
                                        <div>
                                            Restriction donnée avant les plateformes :
                                            <b>@string.Join(", ", a.Sectors.Select(Sectors.Label).Concat(a.Machines))</b>.
                                            Elle s'ajoute aux plateformes cochées.
                                        </div>
                                        @if (editable)
                                        {
                                            <button type="button" class="link" @onclick="() => { a.Sectors.Clear(); a.Machines.Clear(); }">Retirer</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (editable && _assignable.Count > 0)
                        {
                            <button type="button" class="link" style="align-self:flex-start" @onclick="AddAssignment">+ Ajouter un rôle</button>
                        }

                        <h3 class="sub">Droits effectifs aujourd'hui</h3>
                        <EffectiveRights Grants="PreviewGrants()" />

                        @if (_user != null)
                        {
                            <dl class="kv">
                                <dt>Créé le</dt><dd>@Fmt.Date(_user.CreatedAt)</dd>
                                <dt>Mot de passe</dt><dd>@(_user.MustChangePassword ? "temporaire, à changer" : "changé le " + Fmt.Date(_user.PasswordChangedAt))</dd>
                                <dt>Blocage</dt><dd>@(_user.IsLocked(Now) ? (_user.LockedUntil >= DataScope.Forever.AddDays(-1) ? "bloqué jusqu'au déblocage" : "bloqué jusqu'à " + Fmt.Date(_user.LockedUntil)) : "non")</dd>
                            </dl>
                        }

                        <div class="segs">
                            @if (editable && CanAccounts)
                            {
                                <button class="bar acc" type="submit">@(_user == null ? "Créer le compte" : "Enregistrer")</button>
                            }
                            @if (_user != null && editable && Session.Can(Perm.ComptesDebloquer))
                            {
                                <button type="button" class="bar" @onclick="ResetPasswordAsync">Réinitialiser le mot de passe</button>
                                @if (_user.IsLocked(Now))
                                {
                                    <button type="button" class="bar" @onclick="UnlockAsync">Débloquer</button>
                                }
                            }
                        </div>
                    </form>
                </section>
            }
        </div>
    }
    else if (_tab == 3)
    {
        <div class="row">
            @* ---------- platform list ---------- *@
            <section class="card" style="flex:1 1 250px;max-width:320px">
                <p class="nd" style="font-size:13px;margin:0">
                    Une plateforme est un groupe de machines. Les rôles sont donnés sur une équipe et des plateformes :
                    le titulaire voit, saisit, valide… (selon son rôle) sur ces machines seulement.
                </p>
                <div class="rolelist">
                    @foreach (var p in _platforms)
                    {
                        <button type="button" class="rolebtn @(p.Id == _platform?.Id ? "on" : "")" @onclick="() => SelectPlatform(p)">
                            <span>
                                @p.Name
                                @if (!p.IsActive) { <span class="chip warn" style="margin-left:4px">inactive</span> }
                            </span>
                            <small title="Machines">@p.Machines.Count</small>
                        </button>
                    }
                    @if (_platforms.Count == 0)
                    {
                        <p class="empty">Aucune plateforme.</p>
                    }
                </div>
                @if (CanPlatforms)
                {
                    <button type="button" class="bar small" style="align-self:flex-start" @onclick="NewPlatform">Nouvelle plateforme</button>
                }
            </section>

            @* ---------- platform editor ---------- *@
            @if (_pfEditing)
            {
                <section class="card" style="flex:4 1 620px">
                    <div class="card-head">
                        <h2>@(_platform == null ? "Nouvelle plateforme" : _platform.Name) <small>@_pfMachines.Count machine(s)</small></h2>
                        @if (CanPlatforms && _platform != null)
                        {
                            <button type="button" class="bar small danger" @onclick="DeletePlatformAsync" disabled="@(_platform.AssignmentCount > 0)"
                                    title="@(_platform.AssignmentCount > 0 ? "Retirez-la des comptes ou désactivez-la" : "")">Supprimer</button>
                        }
                    </div>
                    <div class="form">
                        <div class="f"><label for="pf-name">Nom</label><input id="pf-name" @bind="_pfName" @bind:event="oninput" disabled="@(!CanPlatforms)" placeholder="ex. Ligne pâte courte 1" /></div>
                        <div class="f grow"><label for="pf-desc">Description</label><input id="pf-desc" @bind="_pfDescription" @bind:event="oninput" disabled="@(!CanPlatforms)" /></div>
                        <label class="check" title="Une plateforme inactive ne donne plus accès à ses machines"><input type="checkbox" @bind="_pfActive" disabled="@(!CanPlatforms)" />Plateforme active</label>
                    </div>

                    <h3 class="sub">Machines</h3>
                    @if (_machines.Count == 0)
                    {
                        <div class="notice info">Base de production injoignable : seules les machines déjà dans la plateforme sont listées.</div>
                    }
                    @foreach (var sector in Sectors.All)
                    {
                        var inSector = PlatformMachineChoices().Where(m => m.Sector == sector).ToList();
                        if (inSector.Count == 0)
                            continue;
                        <div class="f">
                            <span>
                                @Sectors.Label(sector)
                                @if (CanPlatforms)
                                {
                                    <span class="perm-quick" style="margin-left:10px">
                                        <button type="button" class="link" @onclick="() => SetSector(inSector, true)">Tout</button>
                                        <button type="button" class="link" @onclick="() => SetSector(inSector, false)">Aucun</button>
                                    </span>
                                }
                            </span>
                            <div class="checks">
                                @foreach (var m in inSector)
                                {
                                    <label class="check" title="@m.Name">
                                        <input type="checkbox" checked="@_pfMachines.ContainsKey(m.Id)" disabled="@(!CanPlatforms)"
                                               @onchange="e => TogglePlatformMachine(m, e.Value is true)" />@m.Id
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    @if (_platform != null)
                    {
                        <h3 class="sub">Comptes</h3>
                        var holders = _users.SelectMany(u => u.Assignments.Where(a => a.Scope.Platforms.Any(p => p.Id == _platform.Id)).Select(a => (User: u, Assignment: a))).ToList();
                        @if (holders.Count == 0)
                        {
                            <p class="empty">Aucun compte n'a de rôle sur cette plateforme.</p>
                        }
                        else
                        {
                            <table class="t">
                                <thead><tr><th>Compte</th><th>Rôle</th><th>Périmètre</th><th>Validité</th></tr></thead>
                                <tbody>
                                    @foreach (var (u, a) in holders)
                                    {
                                        <tr>
                                            <td>@u.Login<small>@u.DisplayName@(u.IsActive ? "" : " · désactivé")</small></td>
                                            <td class="n">@a.RoleName</td>
                                            <td class="n">@a.Scope.Describe()</td>
                                            <td class="n">@a.Validity()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @if (CanPlatforms)
                    {
                        <div class="savebar">
                            <span class="nd">@(PlatformDirty ? (_platform?.AssignmentCount > 0 ? $"Non enregistré · s'appliquera aux {_platform.AssignmentCount} attribution(s) qui la nomment" : "Modifications non enregistrées") : "")</span>
                            @if (_platform != null)
                            {
                                <button type="button" class="bar" @onclick="() => SelectPlatform(_platform)" disabled="@(!PlatformDirty)">Annuler</button>
                            }
                            <button type="button" class="bar acc" @onclick="SavePlatformAsync" disabled="@(!PlatformDirty)">@(_platform == null ? "Créer la plateforme" : "Enregistrer la plateforme")</button>
                        </div>
                    }
                </section>
            }
        </div>
    }
    else if (_policy != null)
    {
        var canEdit = Session.Can(Perm.SecuriteGerer);
        <section class="card" style="max-width:760px">
            <h2>Règles de sécurité <small>appliquées à tous les comptes</small></h2>
            <form @onsubmit="SavePolicyAsync" style="display:flex;flex-direction:column;gap:14px">
                <div class="form">
                    <div class="f"><label for="p-len">Longueur minimale du mot de passe</label><input id="p-len" type="number" min="8" max="64" @bind="_policy.MinPasswordLength" disabled="@(!canEdit)" /></div>
                    <div class="f"><label for="p-fail">Échecs avant blocage</label><input id="p-fail" type="number" min="3" max="20" @bind="_policy.MaxFailedAttempts" disabled="@(!canEdit)" /></div>
                    <div class="f"><label for="p-lock">Durée du blocage (min, 0 = déblocage par un administrateur)</label><input id="p-lock" type="number" min="0" max="1440" @bind="_policy.LockoutMinutes" disabled="@(!canEdit)" /></div>
                    <div class="f"><label for="p-idle">Verrouillage après inactivité (min, 0 = jamais)</label><input id="p-idle" type="number" min="0" max="480" @bind="_policy.SessionTimeoutMinutes" disabled="@(!canEdit)" /></div>
                </div>
                <label class="check"><input type="checkbox" @bind="_policy.RequireLetterAndDigit" disabled="@(!canEdit)" />Le mot de passe contient au moins une lettre et un chiffre</label>
                <label class="check"><input type="checkbox" @bind="_policy.RequireSecondValidator" disabled="@(!canEdit)" />Une saisie est validée par une autre personne que son auteur</label>
                <p class="nd" style="font-size:13px">Les mots de passe sont stockés hachés (PBKDF2-SHA256), jamais en clair. Un identifiant inconnu et un mauvais mot de passe donnent la même réponse.</p>
                @if (canEdit)
                {
                    <div><button class="bar acc" type="submit">Enregistrer les règles</button></div>
                }
            </form>
        </section>
    }
</RequireAccess>

@code {
    private sealed class AssignmentForm
    {
        public int RoleId { get; set; }
        public List<string> Sectors { get; set; } = new();
        public List<string> Machines { get; set; } = new();
        public List<int> Platforms { get; set; } = new();
        public string Team { get; set; } = "";
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
    }

    private sealed class UserForm
    {
        public string Login { get; set; } = "";
        public string Name { get; set; } = "";
        public bool Active { get; set; } = true;
        public List<AssignmentForm> Assignments { get; set; } = new();
    }

    private int _tab;
    private IReadOnlyList<Role> _roles = Array.Empty<Role>();
    private IReadOnlyList<AppUser> _users = Array.Empty<AppUser>();
    private IReadOnlyList<Role> _assignable = Array.Empty<Role>();
    private HashSet<int> _manageable = new();
    private IReadOnlyList<PlantMachine> _machines = Array.Empty<PlantMachine>();
    private IReadOnlyList<Platform> _platforms = Array.Empty<Platform>();

    private Platform? _platform;
    private bool _pfEditing;
    private string _pfName = "";
    private string _pfDescription = "";
    private bool _pfActive = true;
    private Dictionary<string, string> _pfMachines = new(StringComparer.OrdinalIgnoreCase);

    private Role? _role;
    private PermissionSet _draft = new();
    private string _roleName = "";
    private string _roleDescription = "";
    private bool _roleActive = true;
    private HashSet<int> _roleAssignable = new();
    private string _roleFilter = "";
    private string _newRoleName = "";

    private AppUser? _user;
    private UserForm? _form;
    private string _userFilter = "";
    private int _userRoleFilter;

    private SecurityPolicy? _policy;
    private (string Login, string Password)? _secret;

    private bool CanRoles => Session.Can(Perm.RolesGerer);
    private bool CanAccounts => Session.Can(Perm.ComptesGerer) || CanRoles;
    private bool CanPlatforms => Session.Can(Perm.PlateformesGerer);
    private PermissionSet Perms => _role?.IsSystem == true ? PermissionSet.Full() : _draft;
    private int MissingTemplates => RoleTemplates.All.Count(t => !_roles.Any(r => r.Code == t.Code || string.Equals(r.Name, t.Name, StringComparison.OrdinalIgnoreCase)));

    private bool RoleDirty => _role is { IsSystem: false }
        && (!_role.Permissions.SameAs(_draft) || _roleName != _role.Name || _roleDescription != _role.Description
            || _roleActive != _role.IsActive || !_roleAssignable.SetEquals(_role.AssignableRoleIds));

    protected override async Task OnInitializedAsync()
    {
        if (!Session.Can(Modules.Utilisateurs, AppAction.Voir))
            return;
        try
        {
            _machines = await Plant.GetMachinesAsync();
        }
        catch (Exception)
        {
            _machines = Array.Empty<PlantMachine>();
        }
        await ReloadAsync();
    }

    private async Task ReloadAsync(int? selectRoleId = null)
    {
        await Run(async () =>
        {
            _roles = await Admin.ListRolesAsync(Actor);
            _users = await Admin.ListUsersAsync(Actor);
            _platforms = await Admin.ListPlatformsAsync(Actor);
            _assignable = await Admin.AssignableRolesAsync(Actor);
            _policy = (await Admin.GetPolicyAsync(Actor)).Clone();
            _manageable = new HashSet<int>();
            foreach (var u in _users)
                if (await Admin.CanManageAsync(Actor, u))
                    _manageable.Add(u.Id);
        });
        var keep = selectRoleId ?? _role?.Id;
        SelectRole(_roles.FirstOrDefault(r => r.Id == keep) ?? _roles.FirstOrDefault(r => !r.IsSystem) ?? _roles.FirstOrDefault());
        if (_user != null)
            _user = _users.FirstOrDefault(u => u.Id == _user.Id);
        if (_platform != null)
        {
            var kept = _platforms.FirstOrDefault(p => p.Id == _platform.Id);
            if (kept != null)
                SelectPlatform(kept);
            else
                _platform = null;
        }
    }

    // ---------- platforms ----------

    private bool PlatformDirty
        => _pfEditing && (_platform == null
            ? _pfName.Trim().Length > 0 || _pfMachines.Count > 0
            : _pfName != _platform.Name || _pfDescription != _platform.Description || _pfActive != _platform.IsActive
              || !_pfMachines.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase).SetEquals(_platform.Machines.Select(m => m.MachineId)));

    private void SelectPlatform(Platform p)
    {
        _platform = p;
        _pfEditing = true;
        _pfName = p.Name;
        _pfDescription = p.Description;
        _pfActive = p.IsActive;
        _pfMachines = p.Machines.ToDictionary(m => m.MachineId, m => m.Sector, StringComparer.OrdinalIgnoreCase);
    }

    private void NewPlatform()
    {
        _platform = null;
        _pfEditing = true;
        _pfName = _pfDescription = "";
        _pfActive = true;
        _pfMachines = new(StringComparer.OrdinalIgnoreCase);
        Error = Info = null;
    }

    // The plant's machines, plus those of the platform the production
    // database no longer lists (or cannot be reached).
    private IEnumerable<PlantMachine> PlatformMachineChoices()
        => _machines.Concat(_pfMachines.Where(kv => !_machines.Any(m => string.Equals(m.Id, kv.Key, StringComparison.OrdinalIgnoreCase)))
                .Select(kv => new PlantMachine(kv.Key, kv.Key, kv.Value)))
            .OrderBy(m => m.Id, StringComparer.OrdinalIgnoreCase);

    private void TogglePlatformMachine(PlantMachine m, bool on)
    {
        if (on)
            _pfMachines[m.Id] = m.Sector;
        else
            _pfMachines.Remove(m.Id);
    }

    private void SetSector(IEnumerable<PlantMachine> machines, bool on)
    {
        foreach (var m in machines)
            TogglePlatformMachine(m, on);
    }

    private async Task SavePlatformAsync()
    {
        var change = new PlatformChange(_pfName, _pfDescription, _pfActive,
            _pfMachines.Select(kv => new PlatformMachine(kv.Key, kv.Value)).ToList());
        if (_platform == null)
        {
            Platform? created = null;
            if (await Run(async () => created = await Admin.CreatePlatformAsync(Actor, change), $"Plateforme « {_pfName.Trim()} » créée. Donnez-la aux comptes dans l'onglet Utilisateurs."))
            {
                await ReloadAsync();
                SelectPlatform(_platforms.First(p => p.Id == created!.Id));
            }
        }
        else
        {
            var id = _platform.Id;
            if (await Run(() => Admin.UpdatePlatformAsync(Actor, id, change), $"Plateforme « {_pfName.Trim()} » enregistrée. Elle s'applique à ses comptes dès leur prochaine action."))
            {
                await ReloadAsync();
                await Session.RefreshAsync();
            }
        }
    }

    private async Task DeletePlatformAsync()
    {
        var p = _platform!;
        if (await Run(() => Admin.DeletePlatformAsync(Actor, p.Id), $"Plateforme « {p.Name} » supprimée."))
        {
            _platform = null;
            _pfEditing = false;
            await ReloadAsync();
        }
    }

    // ---------- roles ----------

    private void SelectRole(Role? role)
    {
        _role = role;
        _draft = role?.Permissions.Clone() ?? new PermissionSet();
        _roleName = role?.Name ?? "";
        _roleDescription = role?.Description ?? "";
        _roleActive = role?.IsActive ?? true;
        _roleAssignable = role?.AssignableRoleIds.ToHashSet() ?? new HashSet<int>();
    }

    private void SetModule(string module, bool on)
    {
        foreach (var p in PermissionCatalog.ForModule(module).OrderBy(p => p.IsView ? 1 : 0))
            _draft.Set(p.Key, on);
    }

    private void ToggleAssignable(int roleId, bool on)
    {
        if (on)
            _roleAssignable.Add(roleId);
        else
            _roleAssignable.Remove(roleId);
    }

    private async Task SaveRoleAsync()
    {
        var role = _role!;
        var change = new RoleChange(_roleName, _roleDescription, _roleActive, _draft, _roleAssignable.ToList());
        if (await Run(() => Admin.UpdateRoleAsync(Actor, role.Id, change), $"Rôle « {_roleName.Trim()} » enregistré. Il s'applique à ses titulaires dès leur prochaine action."))
        {
            await ReloadAsync(role.Id);
            await Session.RefreshAsync();
        }
    }

    private async Task CreateRoleAsync()
    {
        Role? created = null;
        if (await Run(async () => created = await Admin.CreateRoleAsync(Actor, _newRoleName, "", null), "Rôle créé, sans permission : cochez ce qu'il peut faire."))
        {
            _newRoleName = "";
            await ReloadAsync(created!.Id);
        }
    }

    private async Task DuplicateRoleAsync()
    {
        var source = _role!;
        Role? created = null;
        var name = UniqueName($"{source.Name} (copie)");
        if (await Run(async () => created = await Admin.CreateRoleAsync(Actor, name, source.Description, source.Id), $"Rôle « {name} » créé."))
            await ReloadAsync(created!.Id);
    }

    private async Task DeleteRoleAsync()
    {
        var role = _role!;
        if (await Run(() => Admin.DeleteRoleAsync(Actor, role.Id), $"Rôle « {role.Name} » supprimé."))
        {
            _role = null;
            await ReloadAsync();
        }
    }

    private async Task AddTemplatesAsync()
    {
        var count = 0;
        if (await Run(async () => count = await Admin.AddTemplatesAsync(Actor)))
        {
            Info = $"{count} rôles types ajoutés ; modifiez-les librement.";
            await ReloadAsync();
        }
    }

    private string UniqueName(string name)
    {
        var candidate = name;
        for (var i = 2; _roles.Any(r => string.Equals(r.Name, candidate, StringComparison.OrdinalIgnoreCase)); i++)
            candidate = $"{name} {i}";
        return candidate.Length > 60 ? candidate[..60] : candidate;
    }

    // ---------- users ----------

    private IEnumerable<AppUser> FilteredUsers()
        => _users
            .Where(u => _userRoleFilter == 0 || u.Assignments.Any(a => a.RoleId == _userRoleFilter))
            .Where(u => string.IsNullOrWhiteSpace(_userFilter)
                        || u.Login.Contains(_userFilter.Trim(), StringComparison.OrdinalIgnoreCase)
                        || u.DisplayName.Contains(_userFilter.Trim(), StringComparison.OrdinalIgnoreCase));

    // The roles offered in an assignment row: the assignable ones, plus the
    // one already there (shown even if this actor could not give it).
    // A role of the form lets the account cover several teams (responsables).
    private bool FormCoversTeams
        => _form?.Assignments.Any(a => _roles.FirstOrDefault(r => r.Id == a.RoleId)?.EffectivePermissions.Has(Perm.EquipesMultiples) == true) == true;

    private IEnumerable<Role> RoleChoices(int current)
        => _roles.Where(r => _assignable.Any(a => a.Id == r.Id) || r.Id == current);

    private void NewUser()
    {
        _user = null;
        _form = new UserForm();
        AddAssignment();
        Error = Info = null;
    }

    private void AddAssignment()
        => _form!.Assignments.Add(new AssignmentForm { RoleId = _assignable.FirstOrDefault(r => !r.IsSystem)?.Id ?? _assignable.FirstOrDefault()?.Id ?? 0 });

    private void EditUser(AppUser u)
    {
        _user = u;
        _form = new UserForm
        {
            Login = u.Login,
            Name = u.DisplayName,
            Active = u.IsActive,
            Assignments = u.Assignments.Select(a => new AssignmentForm
            {
                RoleId = a.RoleId,
                Sectors = a.Scope.Sectors.ToList(),
                Machines = a.Scope.Machines.ToList(),
                Platforms = a.Scope.Platforms.Select(p => p.Id).ToList(),
                Team = a.Scope.Team ?? "",
                From = a.ValidFrom,
                To = a.ValidTo,
            }).ToList(),
        };
        Error = Info = null;
    }

    private void CloseUser()
    {
        _form = null;
        _user = null;
    }

    // The platforms offered in an assignment row: all of them for a manager
    // of roles; for a delegated manager, those inside its own scope (the
    // service checks it again). Plus any the row already names.
    private IEnumerable<Platform> PlatformChoices(AssignmentForm a)
        => _platforms.Where(p => CanRoles || a.Platforms.Contains(p.Id) || WithinMyScope(p))
            .Concat(a.Platforms.Where(id => _platforms.All(p => p.Id != id)).Select(Platform.Missing));

    private bool WithinMyScope(Platform p)
        => Actor.Grants.Where(g => g.Role.EffectivePermissions.Has(Perm.ComptesGerer))
            .Any(g => DataScope.Of(g.Scope.Team, new[] { p }).IsWithin(g.Scope));

    private static void ToggleIn<T>(List<T> list, T value, bool on)
    {
        list.Remove(value);
        if (on)
            list.Add(value);
    }

    private List<RoleAssignment> BuildAssignments()
        => _form!.Assignments.Select(a =>
        {
            var machines = a.Machines.Where(id => a.Sectors.Count == 0 || _machines.Any(m => m.Id == id && a.Sectors.Contains(m.Sector))).ToList();
            return new RoleAssignment
            {
                RoleId = a.RoleId,
                RoleName = _roles.FirstOrDefault(r => r.Id == a.RoleId)?.Name ?? "",
                Scope = new DataScope(a.Sectors.ToList(), string.IsNullOrEmpty(a.Team) ? null : a.Team, machines,
                    a.Platforms.Select(id => _platforms.FirstOrDefault(p => p.Id == id) ?? Platform.Missing(id)).ToList()),
                ValidFrom = a.From,
                ValidTo = a.To,
            };
        }).ToList();

    private IReadOnlyList<Actor.Grant> PreviewGrants()
        => BuildAssignments()
            .Where(a => a.IsCurrent(Now))
            .Select(a => (Role: _roles.FirstOrDefault(r => r.Id == a.RoleId), Assignment: a))
            .Where(x => x.Role is { IsActive: true })
            .Select(x => new Actor.Grant(x.Role!, x.Assignment))
            .ToList();

    private async Task SaveUserAsync()
    {
        var form = _form!;
        var draft = new UserDraft(form.Login, form.Name, BuildAssignments(), form.Active);
        if (_user == null)
        {
            string? password = null;
            if (await Run(async () => password = await Admin.CreateUserAsync(Actor, draft), "Compte créé."))
            {
                _secret = (AccessAdminService.CheckLogin(form.Login), password!);
                CloseUser();
                await ReloadAsync();
            }
        }
        else
        {
            var id = _user.Id;
            if (await Run(() => Admin.UpdateUserAsync(Actor, id, draft), "Compte enregistré."))
            {
                await ReloadAsync();
                EditUser(_users.First(u => u.Id == id));
            }
        }
    }

    private async Task ResetPasswordAsync()
    {
        var user = _user!;
        string? password = null;
        if (await Run(async () => password = await Admin.ResetPasswordAsync(Actor, user.Id), "Mot de passe réinitialisé, compte débloqué."))
        {
            _secret = (user.Login, password!);
            await ReloadAsync();
        }
    }

    private async Task UnlockAsync()
    {
        var user = _user!;
        if (await Run(() => Admin.UnlockAsync(Actor, user.Id), $"Compte {user.Login} débloqué."))
            await ReloadAsync();
    }

    // ---------- policy ----------

    private async Task SavePolicyAsync()
    {
        var policy = _policy!.Clone();
        if (await Run(() => Admin.SavePolicyAsync(Actor, policy), "Règles de sécurité enregistrées. Elles s'appliquent à la prochaine connexion."))
            await ReloadAsync();
    }
}
