@page "/production/tableau-de-bord"
@inherits SpigaPage
@inject DashboardDeckService Deck
@inject IDesktopBridge Desktop
@inject ClientInfo Client
@inject PlantData Plant
@inject UiState Ui
@implements IDisposable
@using SpigaDashboards.App.ViewModels
@using SpigaDashboards.App.ViewModels.Slides

@* Tableau de bord détaillé: the slides of the kiosk dashboard, rotated, with
   its period and filters, the note of the screens and the stop pop-up.
   Tv (TvScreen, /production/ecran-tv): the same slides full screen. *@
@if (!Allowed)
{
    <NativePagePlaceholder Page="NativePage.Dashboard" Group="Production" Title="Le tableau de bord détaillé" />
}
else
{
    @if (!Tv)
    {
        <div class="head">
            <div>
                <span class="pre">Production</span><h1>Tableau de bord détaillé</h1>
                <p>@(_slides.Count == 0 ? "" : $"{_index + 1} / {_slides.Count} · {LabelOf(_slides[_index])}")</p>
            </div>
            <div class="head-tools">
                <a class="bar" href="@HistoryLink">@Icons.Svg("clock")Historique</a>
                @if (!Desktop.IsAvailable && Actor.CanEverywhere(Perm.EcranTv))
                {
                    <a class="bar acc" href="production/ecran-tv">@Icons.Svg("tv")Écran TV</a>
                }
            </div>
        </div>

        <div class="filters">
            <div class="f">
                <span>Période</span>
                <div class="segs" role="group" aria-label="Période">
                    @foreach (var (p, label) in Periods)
                    {
                        <button type="button" class="seg @(_period == p ? "on" : "")" aria-pressed="@(_period == p)" @onclick="() => SetPeriodAsync(p)">@label</button>
                    }
                </div>
                @if (_period == DashboardPeriod.Custom)
                {
                    <div class="q-inline">
                        <input type="date" aria-label="Du" value="@_from.ToString("yyyy-MM-dd")" @onchange="e => SetDatesAsync(e, true)" />
                        <input type="date" aria-label="Au" value="@_to.ToString("yyyy-MM-dd")" @onchange="e => SetDatesAsync(e, false)" />
                    </div>
                }
            </div>
            <div class="f">
                <span>Secteur</span>
                <div class="segs" role="group" aria-label="Secteur">
                    <button type="button" class="seg @(_sector == null ? "on" : "")" @onclick="() => SetSectorAsync(null)">Tous</button>
                    @foreach (var s in Sectors)
                    {
                        <button type="button" class="seg @(_sector == s ? "on" : "")" @onclick="() => SetSectorAsync(s)">@Machine.SectorLabel(s)</button>
                    }
                </div>
            </div>
            @if (SectorLines.Count > 0)
            {
                <div class="f">
                    <span>Ligne</span>
                    <div class="segs" role="group" aria-label="Ligne">
                        <button type="button" class="seg @(_line == null ? "on" : "")" @onclick="() => SetLineAsync(null)">Toutes</button>
                        @foreach (var l in SectorLines)
                        {
                            <button type="button" class="seg @(_line == l.Name ? "on" : "")" style="--lc:@WebDeck.ColorOf(Deck.Lines, l.Name)"
                                    @onclick="() => SetLineAsync(l.Name)"><i class="dk-lc small" aria-hidden="true"></i>@l.Name</button>
                        }
                    </div>
                </div>
            }
            <div class="f">
                <span>Machines</span>
                <details class="pb-lines">
                    <summary class="bar small">@MachinesLabel ▾</summary>
                    <div class="pb-lines-pop card">
                        <div class="pb-lines-all"><button type="button" class="link" @onclick="AllMachinesAsync">Toutes</button></div>
                        @foreach (var m in SectorMachines)
                        {
                            <label class="check"><input type="checkbox" checked="@(!_unticked.Contains(m.MachineId))" @onchange="e => TickMachineAsync(m.MachineId, e.Value is true)" /> @m.MachineName</label>
                        }
                    </div>
                </details>
            </div>
            <div class="f">
                <span>Poste</span>
                <div class="segs" role="group" aria-label="Poste">
                    <button type="button" class="seg @(_shift == null ? "on" : "")" @onclick="() => SetShiftAsync(null)">Tous</button>
                    @foreach (var shift in Shifts.All)
                    {
                        <button type="button" class="seg @(_shift == shift ? "on" : "")" @onclick="() => SetShiftAsync(shift)">@Shifts.Label(shift)</button>
                    }
                </div>
            </div>
            <div class="f">
                @if (Actor.Team is { } myTeam)
                {
                    <span>Votre équipe</span>
                    <span class="chip acc" style="align-self:flex-start;margin-top:5px" title="Les chiffres ne comptent que les postes de votre équipe">@myTeam</span>
                }
                else
                {
                    <label for="dk-team">Équipe</label>
                    <select id="dk-team" value="@(_team ?? "")" @onchange="SetTeamAsync">
                        <option value="">Toutes</option>
                        @foreach (var t in Deck.Teams)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                }
            </div>
            <div class="f">
                <label for="dk-weight">Poids</label>
                <select id="dk-weight" value="@(_weight?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="SetWeightAsync">
                    <option value="">Tous</option>
                    @foreach (var w in Deck.Weights)
                    {
                        <option value="@w.ToString(CultureInfo.InvariantCulture)">@w.ToString("0.##", Fmt.French) g</option>
                    }
                </select>
            </div>
            <span class="sp"></span>
            @if (!Filter.IsEmpty || _period != DashboardPeriod.Day)
            {
                <button type="button" class="link" @onclick="ResetAsync">Réinitialiser</button>
            }
        </div>

        <div class="dk-nav">
            <button type="button" class="bar small" title="Diapositive précédente" aria-label="Précédente" @onclick="() => StepAsync(-1)" disabled="@(_slides.Count == 0)">‹</button>
            <button type="button" class="bar small" title="@(_paused ? "Reprendre la rotation" : "Mettre la rotation en pause")" @onclick="TogglePause" disabled="@(_slides.Count == 0)">@(_paused ? "▶ Reprendre" : "⏸ Pause")</button>
            <button type="button" class="bar small" title="Diapositive suivante" aria-label="Suivante" @onclick="() => StepAsync(1)" disabled="@(_slides.Count == 0)">›</button>
            <div class="dk-timer" title="@(_paused ? "Rotation en pause" : $"Diapositive suivante dans {Math.Max(0, (int)Math.Ceiling(_seconds - _elapsed))} s")">
                <i style="width:@((_seconds <= 0 ? 0 : Math.Min(100, _elapsed / _seconds * 100)).ToString("0.#", CultureInfo.InvariantCulture))%"></i>
            </div>
            <div class="dk-dots">
                @for (var i = 0; i < _slides.Count; i++)
                {
                    var n = i;
                    <button type="button" class="dk-dot @(n == _index ? "on" : "")" title="@LabelOf(_slides[n])" aria-label="@LabelOf(_slides[n])" @onclick="() => GoAsync(n)"></button>
                }
            </div>
        </div>
    }
    else
    {
        @* Écran TV: the slides alone, full screen; the timer bar and two discreet buttons. *@
        <div class="tv-bar">
            <div class="dk-timer"><i style="width:@((_seconds <= 0 ? 0 : Math.Min(100, _elapsed / _seconds * 100)).ToString("0.#", CultureInfo.InvariantCulture))%"></i></div>
            <span class="tv-title">@(_slides.Count == 0 ? "" : LabelOf(_slides[_index]))</span>
            @if (_shiftLabel.Length > 0)
            {
                <span class="tv-shift @(_shiftChanges > 0 ? "announce" : "")" @key="_shiftChanges"><span class="dot"></span>@_shiftLabel</span>
            }
            <span class="tv-clock">@Deck.Now.ToString("dd/MM/yyyy  HH:mm")</span>
            <button type="button" class="bar small" onclick="spigaTv.fullscreen()">Plein écran</button>
            @if (InKiosk && OnLeave.HasDelegate)
            {
                <button type="button" class="bar small" @onclick="OnLeave">@LeaveLabel</button>
            }
            else if (!InKiosk)
            {
                <a class="bar small" href="production/tableau-de-bord">Quitter l'écran TV</a>
            }
        </div>
    }

    <Flash Error="@Error" Info="@Info" />


    @if (_slides.Count == 0 && !_loading)
    {
        <div class="card"><p class="empty">Aucune diapositive pour ces filtres.</p></div>
    }
    else if (_content == null)
    {
        @if (_loading)
        {
            <Loader Text="Chargement de la diapositive…" />
        }
    }
    else
    {
        <div class="stats-body dk-slide @(_loading ? "stale" : "")" aria-busy="@_loading" @key="_contentKey">
            @switch (_content)
            {
                case MachineSlide machine:
                    <MachineSlideView Slide="machine" />
                    break;
                case SynthesisSlide synthesis:
                    <SynthesisSlideView Slide="synthesis" OnPeriod="SetSynthesisPeriodAsync" />
                    break;
                case StatusSlide status:
                    <StatusSlideView Slide="status" />
                    break;
                case LineSlide line:
                    <LineSlideView Slide="line" />
                    break;
                case PlantSlide plant:
                    <PlantSlideView Slide="plant" />
                    break;
            }
        </div>
    }

    @* The note of the screens (kiosk: the yellow sticky note bar): the same
       text on every dashboard and TV screen, never rotated away, held at
       the bottom of the screen as on the kiosk. *@
    @if (_canEditNote && !Tv || !string.IsNullOrWhiteSpace(_note))
    {
        <div class="dk-note" role="note">
            @if (_canEditNote && !Tv)
            {
                <textarea id="dk-note" rows="1" maxlength="1000" aria-label="Note des écrans" placeholder="Note pour tous les écrans (consigne, information…)"
                          value="@_noteDraft" @oninput="NoteTyped"></textarea>
                @if (_noteStatus.Length > 0)
                {
                    <span class="dk-note-status">@_noteStatus</span>
                }
                <button type="button" class="bar small" disabled="@(!_noteEditing || _noteDraft == _note)" @onclick="SaveNoteAsync">Enregistrer</button>
            }
            else
            {
                <p>@_note</p>
            }
        </div>
    }

    @* Stop pop-up (kiosk: StopAlertPopup): the lines stopped with no cause
       yet. Comes up when a new one appears, then as a reminder every 30 min
       while any is left, and goes away after 20 s or a click. *@
    @if (_alert is { Count: > 0 } alert)
    {
        <div class="dk-alert" role="alert" @onclick="DismissAlert">
            <div class="dk-alert-head">
                <b>@(alert.Count == 1 ? "ARRÊT EN COURS — cause à définir" : $"{alert.Count} ARRÊTS EN COURS — cause à définir")</b>
                <button type="button" class="dk-alert-close" aria-label="Fermer" @onclick="DismissAlert" @onclick:stopPropagation="true">×</button>
            </div>
            @foreach (var stop in alert.Take(AlertLines))
            {
                <div class="dk-alert-row">
                    <div><b>@NameOf(stop.MachineId)</b><small>À l'arrêt @stop.SinceText</small></div>
                    <span>@stop.DurationText</span>
                </div>
            }
            @if (alert.Count > AlertLines)
            {
                <small class="dk-alert-more">@(alert.Count - AlertLines == 1 ? "+ 1 autre ligne" : $"+ {alert.Count - AlertLines} autres lignes")</small>
            }
        </div>
    }
}

@code {
    // Écran TV (TvScreen): the same deck full screen, no filters, never locked.
    [Parameter] public bool Tv { get; set; }

    // Shown inside KioskScreen (its own bar leaves the screen): no « Quitter ».
    [Parameter] public bool InKiosk { get; set; }
    [Parameter] public EventCallback OnLeave { get; set; }
    [Parameter] public string LeaveLabel { get; set; } = "Quitter";

    private bool Allowed => NativePages.IsAllowed(Session.Actor, NativePage.Dashboard)
                            // Inside KioskScreen the mode was already checked (OpenModes, ScreenAccount).
                            && (!Tv || InKiosk || Session.Actor?.CanEverywhere(Perm.EcranTv) == true);

    private static readonly (DashboardPeriod Period, string Label)[] Periods =
    {
        (DashboardPeriod.Day, "Aujourd'hui"), (DashboardPeriod.PreviousShift, "Poste préc."), (DashboardPeriod.Yesterday, "Hier"),
        (DashboardPeriod.Week, "Semaine"), (DashboardPeriod.Month, "Mois"), (DashboardPeriod.ThreeMonths, "3 mois"), (DashboardPeriod.Custom, "Dates…"),
    };

    private DashboardPeriod _period = DashboardPeriod.Day;
    private DateTime _from;
    private DateTime _to;
    private string? _sector;
    private string? _line;
    private readonly HashSet<string> _unticked = new(StringComparer.OrdinalIgnoreCase);
    private int? _shift;
    private string? _team;
    private double? _weight;
    private SynthesisPeriod _synthesisPeriod = SynthesisPeriod.Month;

    // Sticky note and stop pop-up, read every minute.
    private const int AlertLines = 5;
    private static readonly TimeSpan AlertShown = TimeSpan.FromSeconds(20);
    private static readonly TimeSpan AlertReminder = TimeSpan.FromMinutes(30);
    private string? _note;
    private string _noteDraft = "";
    private bool _noteEditing;
    private string _noteStatus = "";
    private bool _canEditNote;
    private List<SpigaDashboards.App.Models.OngoingStop>? _alert;
    private DateTime _alertSince;
    private DateTime _lastAlert = DateTime.MinValue;
    private readonly HashSet<string> _alerted = new();
    private int _sideTicks;

    // The team on shift (TV bar); a change is announced (the chip pops and glows).
    private string _shiftLabel = "";
    private int _shiftChanges;

    private void ReadShift()
    {
        string label;
        try
        {
            var (team, shift) = Plant.CurrentShift();
            label = $"{team} - Poste {Shifts.Label(shift)}";
        }
        catch (Exception)
        {
            return;
        }
        if (_shiftLabel.Length > 0 && label != _shiftLabel)
            _shiftChanges++;
        _shiftLabel = label;
    }

    private List<Machine> _machines = new();
    private List<SlideDescriptor> _slides = new();
    private int _index;
    private object? _content;
    private string _contentKey = "";
    private bool _loading;
    private bool _paused;
    private double _seconds;
    private double _elapsed;
    private int _version;
    private CancellationTokenSource? _reading;
    private CancellationTokenSource? _life;
    private DateTime _loadedAt;

    // Sectors of the lines (a machine counts in its line's sector), then
    // those of the machines in no line.
    private IEnumerable<string> Sectors => _machines.Select(m => WebDeck.SectorOf(Deck.Lines, m)).Distinct()
        .OrderBy(s => Array.IndexOf(SlideDeck.SectorOrder, s) is var i && i < 0 ? int.MaxValue : i);

    private List<SpigaDashboards.App.Models.DashboardLine> SectorLines
        => Deck.Lines.Where(l => (_sector == null || l.Sector == _sector)
                                 && (l.PlannedMachines.Count > 0 || _machines.Any(m => l.MachineIds.Contains(m.MachineId, StringComparer.OrdinalIgnoreCase))))
            .ToList();

    private IEnumerable<Machine> SectorMachines => _machines.Where(m => (_sector == null || WebDeck.SectorOf(Deck.Lines, m) == _sector)
                                                                       && (_line == null || WebDeck.LineOf(Deck.Lines, m.MachineId)?.Name == _line));

    // Sector, line and machine boxes narrow the machines: they go to the
    // deck as MachineIds (a machine's line can be in a sector its database
    // row doesn't say), with what they stand for said on the slides.
    private DashboardFilter Filter
    {
        get
        {
            var shown = SectorMachines.ToList();
            var ticked = shown.Where(m => !_unticked.Contains(m.MachineId)).ToList();
            var narrowed = ticked.Count < _machines.Count;
            var scope = ticked.Count < shown.Count ? null
                : _line != null ? SpigaDashboards.App.Models.DashboardLine.LabelOf(_line)
                : _sector != null ? Machine.SectorLabel(_sector) : null;
            return new DashboardFilter
            {
                MachineIds = narrowed ? ticked.Select(m => m.MachineId).ToList() : Array.Empty<string>(),
                MachineNames = narrowed ? ticked.Select(m => m.MachineName).ToList() : Array.Empty<string>(),
                ScopeLabel = narrowed ? scope : null,
                ShiftId = _shift,
                Team = _team,
                TargetWeight = _weight,
            };
        }
    }

    private string LabelOf(SlideDescriptor slide) => WebDeck.Label(slide, NameOf, Deck.Lines);

    private string MachinesLabel
    {
        get
        {
            var shown = SectorMachines.ToList();
            var ticked = shown.Where(m => !_unticked.Contains(m.MachineId)).Select(m => m.MachineName).ToList();
            return ticked.Count == shown.Count ? "Toutes" : ticked.Count == 0 ? "Aucune" : ticked.Count <= 2 ? string.Join(", ", ticked) : $"{ticked.Count} machines";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Allowed)
            return;
        var today = Deck.Now.Date;
        (_from, _to) = (today.AddDays(-7), today);
        await Run(async () => _machines = await Deck.MachinesAsync(Actor));
        Rebuild();
        _canEditNote = DashboardDeckService.CanEditNote(Actor);
        await RefreshSideAsync();
        _life = new CancellationTokenSource();
        _ = TickAsync(_life.Token);
        await ShowAsync();
    }

    public void Dispose()
    {
        _life?.Cancel();
        _life?.Dispose();
        _reading?.Cancel();
        _reading?.Dispose();
    }

    // The deck again for the filters (its shape follows the sector / machines).
    private void Rebuild()
    {
        var key = _slides.Count > _index ? _slides[_index].Key : null;
        // Every box unticked: nothing to show (no MachineIds would mean all).
        _slides = SectorMachines.All(m => _unticked.Contains(m.MachineId)) ? new List<SlideDescriptor>() : Deck.Deck(_machines, Filter);
        _index = Math.Max(0, _slides.FindIndex(s => s.Key == key));
    }

    // Rotation: a slide stays its duration (Paramètres > Affichage), the data
    // of the slide shown is read again every refresh interval.
    private async Task TickAsync(CancellationToken stop)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(stop))
            {
                await InvokeAsync(async () =>
                {
                    if (_alert != null && Deck.Now - _alertSince >= AlertShown)
                        DismissAlert();
                    if (Tv)
                        ReadShift();
                    if (++_sideTicks >= 60)
                    {
                        _sideTicks = 0;
                        await RefreshSideAsync();
                        // A wall screen nobody clicks: it stays signed in while shown.
                        if (Tv)
                            await Session.KeepAwakeAsync();
                    }
                    if (_slides.Count == 0 || _loading)
                    {
                        StateHasChanged();
                        return;
                    }
                    // Held while paused or while a chart is enlarged: the time
                    // stops where it is and goes on from there when it closes.
                    var held = _paused || Ui.Enlarged.Count > 0;
                    if (!held)
                        _elapsed += 1;
                    if (!held && _elapsed >= _seconds)
                        await StepAsync(1);
                    else if (Deck.Now - _loadedAt > TimeSpan.FromMinutes(Math.Max(1, Deck.Settings.DataRefreshIntervalMinutes)))
                        await ShowAsync(keepTimer: true);
                    else
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ShowAsync(bool keepTimer = false)
    {
        if (_slides.Count == 0)
        {
            _content = null;
            return;
        }
        var version = ++_version;
        _reading?.Cancel();
        _reading?.Dispose();
        var cancel = (_reading = new CancellationTokenSource()).Token;
        var slide = _slides[_index];
        if (!keepTimer)
        {
            _elapsed = 0;
            _seconds = Deck.SecondsFor(slide);
        }
        _loading = true;
        try
        {
            object? content = null;
            var (actor, filter, period, from, to) = (Actor, Filter, _period, (DateTime?)_from, (DateTime?)_to);
            var machines = _machines;
            var synthesisPeriod = _synthesisPeriod;
            List<Machine> Of(IEnumerable<string> ids) => ids.Select(id => machines.FirstOrDefault(m => m.MachineId == id)).OfType<Machine>().ToList();
            var ok = await Run(async () => content = await Task.Run(async () => slide switch
            {
                MachineSlideDescriptor ms when machines.FirstOrDefault(m => m.MachineId == ms.MachineId) is { } machine
                    => await Deck.MachineAsync(actor, machine, period, from, to, filter, cancel) with { Line = Deck.TagOf(machine.MachineId) },
                StatusSlideDescriptor sd => await Deck.StatusAsync(actor, machines, sd.MachineIds, cancel),
                LineSlideDescriptor ld when Deck.Line(ld.Line) is { } line
                    => await Deck.LineAsync(actor, line, Of(ld.MachineIds), ld.Planned, period, from, to, filter, cancel),
                LineSynthesisSlideDescriptor sd when Deck.Line(sd.Line) is { } line
                    => await Deck.SynthesisAsync(actor, line, Of(sd.MachineIds), sd.Planned, synthesisPeriod, filter, cancel),
                PlantSlideDescriptor pd => await Deck.PlantAsync(actor, pd.Lines.Select(Deck.Line).OfType<SpigaDashboards.App.Models.DashboardLine>()
                    .Select(l => (l, (IReadOnlyList<Machine>)Of(l.MachineIds.Where(id => filter.MachineIds.Count == 0 || filter.MachineIds.Contains(id))))).ToList(),
                    period, from, to, filter, cancel),
                _ => (object?)null,
            }, cancel));
            if (version != _version || !ok)
                return;
            _content = content;
            _contentKey = slide.Key;
            _loadedAt = Deck.Now;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (version == _version)
            {
                SpigaDashboards.App.Services.AppLogger.Log("Tableau de bord (web) : " + ex);
                Error = "Diapositive indisponible : " + ex.Message;
            }
        }
        finally
        {
            if (version == _version)
                _loading = false;
        }
    }

    private Task StepAsync(int count)
    {
        if (_slides.Count == 0)
            return Task.CompletedTask;
        _index = ((_index + count) % _slides.Count + _slides.Count) % _slides.Count;
        return ShowAsync();
    }

    private Task GoAsync(int index)
    {
        _index = index;
        return ShowAsync();
    }

    private void TogglePause() => _paused = !_paused;

    // ---------- note, stop pop-up ----------

    private async Task RefreshSideAsync()
    {
        if (Session.Actor == null)
            return;
        var actor = Actor;
        try
        {
            // Text being typed is never overwritten by the refresh.
            if (await Task.Run(() => Deck.NoteAsync(actor)) is { } note)
            {
                _note = note;
                if (!_noteEditing)
                    _noteDraft = note;
            }
            var open = await Task.Run(() => Deck.UnqualifiedStopsAsync(actor));
            var keys = open.Select(s => $"{s.MachineId}|{s.Start:O}").ToHashSet();
            var isNew = keys.Any(k => !_alerted.Contains(k));
            _alerted.Clear();
            _alerted.UnionWith(keys);
            if (open.Count == 0)
                DismissAlert();
            else if (isNew || Deck.Now - _lastAlert >= AlertReminder)
            {
                _alert = open;
                _alertSince = _lastAlert = Deck.Now;
            }
        }
        catch (Exception ex)
        {
            SpigaDashboards.App.Services.AppLogger.Log("Tableau de bord (web), note / arrêts en cours : " + ex.Message);
        }
    }

    private void DismissAlert() => _alert = null;

    private void NoteTyped(ChangeEventArgs e)
    {
        _noteDraft = e.Value as string ?? "";
        _noteEditing = true;
        _noteStatus = "";
    }

    private async Task SaveNoteAsync()
    {
        var text = _noteDraft;
        var author = new SpigaDashboards.App.Data.ChangeAuthor(Actor.Login, Actor.DisplayName, Client.Workstation);
        var actor = Actor;
        _noteStatus = "";
        if (await Run(() => Task.Run(() => Deck.SaveNoteAsync(actor, author, text))))
        {
            _note = text.Trim();
            _noteDraft = _note;
            _noteEditing = false;
            _noteStatus = "Enregistré.";
        }
    }

    // Synthèse: its own period (buttons on the slide), kept for the next ones.
    private Task SetSynthesisPeriodAsync(SynthesisPeriod period)
    {
        _synthesisPeriod = period;
        return ShowAsync(keepTimer: true);
    }

    // ---------- filters ----------

    private Task ApplyAsync()
    {
        Rebuild();
        return ShowAsync();
    }

    private Task SetPeriodAsync(DashboardPeriod period)
    {
        _period = period;
        return ShowAsync();
    }

    private Task SetDatesAsync(ChangeEventArgs e, bool start)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var d))
            return Task.CompletedTask;
        if (start)
            _from = d.Date;
        else
            _to = d.Date;
        return ShowAsync();
    }

    private Task SetSectorAsync(string? sector)
    {
        _sector = sector;
        _line = null;
        _unticked.Clear();
        return ApplyAsync();
    }

    private Task SetLineAsync(string? line)
    {
        _line = line;
        _unticked.Clear();
        return ApplyAsync();
    }

    private Task TickMachineAsync(string machineId, bool on)
    {
        if (on)
            _unticked.Remove(machineId);
        else
            _unticked.Add(machineId);
        return ApplyAsync();
    }

    private Task AllMachinesAsync()
    {
        _unticked.Clear();
        return ApplyAsync();
    }

    private Task SetShiftAsync(int? shift)
    {
        _shift = shift;
        return ShowAsync();
    }

    private Task SetTeamAsync(ChangeEventArgs e)
    {
        _team = e.Value as string is { Length: > 0 } t ? t : null;
        return ShowAsync();
    }

    private Task SetWeightAsync(ChangeEventArgs e)
    {
        _weight = double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var w) ? w : null;
        return ShowAsync();
    }

    private Task ResetAsync()
    {
        (_period, _sector, _line, _shift, _team, _weight) = (DashboardPeriod.Day, null, null, null, null, null);
        _unticked.Clear();
        return ApplyAsync();
    }

    // Historique opens on the dashboard's period and filters.
    private string HistoryLink
    {
        get
        {
            var (from, to) = _period == DashboardPeriod.Custom ? (_from, _to.AddDays(1))
                : PeriodRanges.Get(_period == DashboardPeriod.PreviousShift ? DashboardPeriod.Day : _period, Deck.Now);
            var f = Filter;
            var q = new List<string> { $"du={from:yyyy-MM-dd}", $"au={to.AddDays(-1):yyyy-MM-dd}" };
            // Sector and line go as their machines (a line's sector isn't always its machines').
            if (f.MachineIds.Count > 0) q.Add("machines=" + Uri.EscapeDataString(string.Join(",", f.MachineIds)));
            if (f.ShiftId != null) q.Add($"poste={f.ShiftId}");
            if (f.Team != null) q.Add("equipe=" + Uri.EscapeDataString(f.Team));
            if (f.TargetWeight != null) q.Add("poids=" + f.TargetWeight.Value.ToString(CultureInfo.InvariantCulture));
            return "production/historique?" + string.Join("&", q);
        }
    }

    private string NameOf(string machineId) => _machines.FirstOrDefault(m => m.MachineId == machineId)?.MachineName ?? machineId;
}
