@page "/maintenance/arrets"
@inherits SpigaPage
@inject IDesktopBridge Desktop

<RequireAccess Module="@Modules.Maintenance">
    <div class="head">
        <div>
            <span class="pre">Maintenance</span><h1>Arrêts et planification</h1>
            <p>Qualification des arrêts, plans de maintenance et ordres de fabrication : les écrans existants de SPIGA Dashboards, en attendant leur version intégrée.</p>
        </div>
    </div>
    <div class="row">
        <section class="card" style="flex:1 1 320px;max-width:460px">
            <h2>Arrêts</h2>
            <p>Liste des arrêts par machine et poste, cause, durée, fiche d'arrêt PDF.</p>
            @if (Desktop.IsAvailable)
            {
                <div><button type="button" class="bar acc" @onclick="() => Desktop.OpenStops(CanEditStationSettings)">Ouvrir les arrêts</button></div>
            }
        </section>
        <section class="card" style="flex:1 1 320px;max-width:460px">
            <h2>Planification</h2>
            <p>Tableau de planification, pannes, statistiques, plans de maintenance. Modification réservée au droit « Saisir » de la maintenance.</p>
            @if (Desktop.IsAvailable && Session.Can("maintenance:saisir"))
            {
                <div><button type="button" class="bar acc" @onclick="() => Desktop.OpenPlanning(CanEditStationSettings)">Ouvrir la planification</button></div>
            }
        </section>
    </div>
    @if (!Desktop.IsAvailable)
    {
        <div class="notice info">Ces écrans sont pour l'instant disponibles dans l'application installée sur les postes ; leur version web viendra avec leur intégration.</div>
    }
</RequireAccess>
