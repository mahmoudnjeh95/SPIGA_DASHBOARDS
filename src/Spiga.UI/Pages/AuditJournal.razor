@page "/admin/audit"
@inherits SpigaPage
@inject AuditTrailService Audit

@* The trail has no machine or team to filter on (accounts, rights,
   entries of every line): plant-wide accounts only. *@
<RequireAccess Module="@Modules.Audit" PlantWide="true">
    <div class="head">
        <div>
            <span class="pre">Administration</span><h1>Journal d'audit</h1>
            <p>Connexions, droits, comptes et saisies : qui a fait quoi, quand, depuis quel poste, avec l'ancienne et la nouvelle valeur.</p>
        </div>
    </div>

    <div class="filters">
        <PeriodPicker Value="_period" ValueChanged="OnPeriodAsync" Id="audit-period" />
        <div class="f">
            <label for="a-user">Utilisateur</label>
            <select id="a-user" value="@_user" @onchange="OnUserAsync">
                <option value="">Tous</option>
                @foreach (var u in _knownUsers)
                {
                    <option value="@u">@u</option>
                }
            </select>
        </div>
        <div class="f">
            <label for="a-module">Module</label>
            <select id="a-module" value="@_module" @onchange="OnModuleAsync">
                <option value="">Tous</option>
                <option value="@Modules.Utilisateurs">Comptes et droits</option>
                <option value="@Modules.SaisieDechets">Saisie des déchets</option>
                <option value="@Modules.Conditionnement">Note du tableau de bord</option>
                <option value="@Modules.Parametres">Paramètres du poste (noms des machines)</option>
            </select>
        </div>
    </div>

    <section class="card">
        <div class="card-head"><h2>Événements <small>@_entries.Count affiché(s)@(_entries.Count >= Limit ? $", limités aux {Limit} plus récents" : "")</small></h2></div>
        @if (_entries.Count == 0)
        {
            <p class="empty">Aucun événement sur la période.</p>
        }
        else
        {
            <div class="scroll">
                <table class="t">
                    <thead><tr><th>Date</th><th>Utilisateur</th><th>Action</th><th>Objet</th><th>Avant</th><th>Après</th><th>Poste</th></tr></thead>
                    <tbody>
                        @foreach (var e in _entries)
                        {
                            <tr>
                                <td class="n" style="white-space:nowrap">@e.At.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@e.UserLogin</td>
                                <td><span class="chip @ActionCss(e.Action)">@e.Action</span>@if (!string.IsNullOrEmpty(e.Details)) { <small>@e.Details</small> }</td>
                                <td class="n">@e.Target</td>
                                <td class="wrap">@e.OldValue</td>
                                <td class="wrap">@e.NewValue</td>
                                <td class="n">@e.Workstation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</RequireAccess>

@code {
    private const int Limit = 500;
    private Period _period = default!;
    private string _user = "";
    private string _module = "";
    private IReadOnlyList<AuditEntry> _entries = Array.Empty<AuditEntry>();
    private List<string> _knownUsers = new();

    protected override async Task OnInitializedAsync()
    {
        _period = new Period(PeriodKind.Last7Days, Now.Date, Now.Date);
        await LoadAsync();
    }

    private async Task OnPeriodAsync(Period p)
    {
        _period = p;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!AuditTrailService.CanRead(Session.Actor))
            return;
        var (from, to) = _period.Range(Now);
        _entries = await Audit.QueryAsync(Actor, new AuditQuery(from, to, NullIfEmpty(_user), NullIfEmpty(_module), Limit));
        _knownUsers = _knownUsers.Union(_entries.Select(e => e.UserLogin)).Distinct().OrderBy(u => u).ToList();
    }

    private async Task OnUserAsync(ChangeEventArgs e)
    {
        _user = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private async Task OnModuleAsync(ChangeEventArgs e)
    {
        _module = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private static string? NullIfEmpty(string s) => string.IsNullOrEmpty(s) ? null : s;

    private static string ActionCss(string action) => action switch
    {
        AuditActions.LoginFailed or AuditActions.LoginRefused or AuditActions.AccountLocked or AuditActions.EntryDeleted => "bad",
        AuditActions.EntryCorrected or AuditActions.RoleUpdated or AuditActions.RoleDeleted or AuditActions.PolicyUpdated or AuditActions.PasswordReset => "warn",
        AuditActions.LoginOk or AuditActions.EntryValidated => "ok",
        _ => "",
    };
}
