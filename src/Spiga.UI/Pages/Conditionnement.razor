@page "/production/conditionnement"
@inherits SpigaPage
@inject DashboardQueries Queries
@inject UiState Ui
@inject IDesktopBridge Desktop
@inject PlantData Plant

<RequireAccess Module="@Modules.Conditionnement">
    <div class="head">
        <div>
            <span class="pre">Production</span><h1>Conditionnement</h1>
            <p>@_period.Label(Now)@(_sector == null ? "" : " · " + Sectors.Label(_sector))@(_shift == null ? "" : " · poste " + Shifts.Label(_shift.Value))</p>
        </div>
        @if (Desktop.IsAvailable && Session.Can(Perm.TableauDetaille))
        {
            <a class="bar" href="production/tableau-de-bord" title="Diapositives, détail par machine, synthèse secteur, historique">
                Tableau de bord détaillé
            </a>
        }
    </div>

    @* The filters of this module apply here only. *@
    <div class="filters">
        <PeriodPicker Value="_period" ValueChanged="OnPeriodAsync" Id="cond-period" />
        <div class="f">
            <span>Secteur</span>
            <div class="segs" role="group" aria-label="Secteur">
                <button type="button" class="seg @(_sector == null ? "on" : "")" @onclick="() => OnSectorAsync(null)">Tous</button>
                @foreach (var s in Sectors.All.Where(s => Actor.Allows(View, s)))
                {
                    <button type="button" class="seg @(_sector == s ? "on" : "")" @onclick="() => OnSectorAsync(s)">@Sectors.Label(s)</button>
                }
            </div>
        </div>
        <div class="f">
            <span>Poste</span>
            <div class="segs" role="group" aria-label="Poste">
                <button type="button" class="seg @(_shift == null ? "on" : "")" @onclick="() => OnShiftAsync(null)">Tous</button>
                @foreach (var s in Shifts.All)
                {
                    @* A poste your team did not work over the period stays visible, greyed out. *@
                    var own = OwnShift(s);
                    <button type="button" class="seg @(_shift == s ? "on" : "") @(own ? "" : "off-team")" aria-disabled="@(!own)"
                            title="@(own ? null : "Ne concerne pas votre équipe sur cette période")"
                            @onclick="() => OnShiftAsync(s)">@Shifts.Label(s)</button>
                }
            </div>
        </div>
        @if (Actor.Team is { } myTeam)
        {
            <div class="f">
                <span>Votre équipe</span>
                <span class="chip acc" style="align-self:flex-start;margin-top:5px" title="Les chiffres ne comptent que les postes de votre équipe">@myTeam</span>
            </div>
        }
    </div>

    @if (_teamNote != null)
    {
        <div class="notice warn" role="status">@_teamNote</div>
    }

    <Flash Error="@Error" />

    @if (_snap == null)
    {
        <Loader />
    }
    else
    {
        @if (_snap.ProductionError != null)
        {
            <div class="notice warn">@_snap.ProductionError</div>
        }
        var total = _snap.Total;
        <div class="row">
            <KpiTile Label="TRS" Hint="@($"cible {Fmt.Num(_snap.TrsTarget)} %")" Value="@Fmt.Pct(total?.TrsPercent)"
                     Css="@Fmt.Css(TrsBand.ForTarget(_snap.TrsTarget).Severity(total?.TrsPercent))"
                     Sub="@($"D {Fmt.Pct(total?.AvailabilityPercent, 0)} · P {Fmt.Pct(total?.PerformancePercent, 0)} · Q {Fmt.Pct(total?.QualityPercent, 0)}")" />
            <KpiTile Label="Vitesse moy." Hint="sacs/min" Value="@Fmt.Num(total?.SpeedBagsPerMinute, 1)"
                     Sub="@($"max atteinte {Fmt.Num(total?.MaxSpeedBagsPerMinute, 1)}")" />
            <KpiTile Label="Taux conformité" Value="@Fmt.Pct(total?.QualityPercent)" Css="@(total?.QualityPercent >= 98 ? "ok" : total?.QualityPercent == null ? "nd" : "warn")"
                     Sub="@($"sous tol. {Fmt.Num(total?.BagsUnderTolerance)} · sur tol. {Fmt.Num(total?.BagsOverTolerance)}")" />
            <KpiTile Label="Écart de poids" Value="@Fmt.SignedPct(total?.WeightDeviationPercent)"
                     Css="@Fmt.Css(WeightBand.Default.Severity(total?.WeightDeviationPercent))"
                     Sub="@(total?.GiveawayKg is { } g ? Fmt.Giveaway(g) : "")" />
            <KpiTile Label="Production" Value="@(total == null ? Fmt.Missing : Fmt.Mass(total.ProductionKg))" Sub="@($"{Fmt.Num(total?.TotalBags)} sacs")" />
            <KpiTile Label="Déchet emballage" Value="@(_snap.PackagingEntries == 0 ? "—" : Fmt.Kg(_snap.PackagingWasteKg))" Css="@(_snap.PackagingWasteKg > 0 ? "" : "nd")"
                     Sub="@(_snap.PackagingEntries == 0 ? "aucune saisie sur la période" : _snap.PackagingWastePercent is { } p ? Fmt.Pct(p, 2) + " de la production" : "")" />
        </div>

        <div class="row">
            <section class="card" style="flex:6 1 560px">
                <div class="card-head"><h2>Machines <small>@_snap.Machines.Count dans votre périmètre</small></h2></div>
                <div class="scroll">
                    <table class="t">
                        <thead>
                            <tr>
                                <th>Machine</th>
                                @if (_snap.IsLive)
                                {
                                    <th>État</th>
                                }
                                <th>TRS</th><th>D · P · Q</th><th class="r">Production</th><th class="r">Écart poids</th><th class="r">Conformité</th><th class="r">Déchet emb.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _snap.Machines)
                            {
                                var k = m.Figures.Kpi;
                                <tr>
                                    <td><span class="machine-id">@m.Machine.Id</span><small>@Sectors.Label(m.Machine.Sector)</small></td>
                                    @if (_snap.IsLive)
                                    {
                                        <td>
                                            @if (m.State == null)
                                            {
                                                <span class="state"><span class="dot off"></span>Inconnu</span>
                                            }
                                            else if (!m.State.Connected)
                                            {
                                                <span class="state" title="Dernière donnée @Fmt.Date(m.State.LastData)"><span class="dot off"></span>Déconnectée</span>
                                            }
                                            else
                                            {
                                                <span class="state"><span class="dot @(m.State.Running ? "ok" : "bad")"></span>@(m.State.Running ? "En marche" : "À l'arrêt")</span>
                                            }
                                        </td>
                                    }
                                    <td class="@Fmt.Css(m.Figures.TrsSeverity)">@Fmt.Pct(k.TrsPercent)<small>cible @Fmt.Num(m.Figures.TrsTarget) %</small></td>
                                    <td class="n">@Fmt.Pct(k.AvailabilityPercent, 0) · @Fmt.Pct(k.PerformancePercent, 0) · @Fmt.Pct(k.QualityPercent, 0)</td>
                                    <td class="r">@(m.Figures.HasProduction ? Fmt.Mass(k.ProductionKg) : "—")<small>@Fmt.Num(k.TotalBags) sacs</small></td>
                                    <td class="r @Fmt.Css(m.Figures.WeightSeverity)">@Fmt.Grams(k.WeightDeviationGrams)<small>@Fmt.SignedPct(k.WeightDeviationPercent)</small></td>
                                    <td class="r">@Fmt.Pct(k.QualityPercent)</td>
                                    <td class="r">@(m.WasteKg > 0 ? Fmt.Kg(m.WasteKg) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card" style="flex:4 1 380px">
                <SpigaChart Title="TRS par machine" Key="cond-trs-machine" YMin="0" YMax="100"
                            Labels="@_snap.Machines.Select(m => m.Machine.Id).ToList()"
                            Format="@(v => Fmt.Num(v) + " %")"
                            Series="@(new[]
                            {
                                new ChartSeries("TRS", _snap.Machines.Select(m => m.Figures.Kpi.TrsPercent).ToList(), "var(--bar)"),
                                new ChartSeries($"Cible {Fmt.Num(_snap.TrsTarget)} %", _snap.Machines.Select(_ => (double?)_snap.TrsTarget).ToList(), "var(--target)", Reference: true),
                            })" />
                <p class="nd" style="font-size:12px">Calcul identique au tableau de bord SPIGA : TRS = disponibilité × performance × qualité, arrêts planifiés déduits.</p>
            </section>
        </div>
    }
</RequireAccess>

@code {
    [SupplyParameterFromQuery(Name = "secteur")] public string? SectorParam { get; set; }
    [SupplyParameterFromQuery(Name = "du")] public string? FromParam { get; set; }
    [SupplyParameterFromQuery(Name = "au")] public string? ToParam { get; set; }

    private static readonly string View = Perm.View(Modules.Conditionnement);

    private Period _period = default!;
    private string? _sector;
    private int? _shift;
    private string? _teamNote;
    private PlantSnapshot? _snap;

    private bool OwnShift(int shift)
    {
        var (from, to) = _period.Range(Now);
        return Plant.WorksShift(Actor, from, to, shift);
    }

    protected override async Task OnParametersSetAsync()
    {
        _period = Ui.PackagingPeriod ?? Period.Today(Now);
        _sector = Ui.PackagingSector;
        _shift = Ui.PackagingShift;
        if (SectorParam != null && Sectors.All.Contains(SectorParam))
            _sector = SectorParam;
        if (DateTime.TryParse(FromParam, CultureInfo.InvariantCulture, out var from))
        {
            var to = DateTime.TryParse(ToParam, CultureInfo.InvariantCulture, out var t) ? t : from;
            _period = new Period(PeriodKind.Custom, from, to);
        }
        if (_sector != null && !Actor.Allows(View, _sector))
            _sector = null;
        if (_shift is { } kept && !OwnShift(kept))
            _shift = Ui.PackagingShift = null;
        await LoadAsync();
    }

    private async Task OnPeriodAsync(Period p)
    {
        _period = Ui.PackagingPeriod = p;
        _teamNote = null;
        if (_shift is { } kept && !OwnShift(kept))
            _shift = Ui.PackagingShift = null;
        await LoadAsync();
    }

    private async Task OnSectorAsync(string? sector)
    {
        _sector = Ui.PackagingSector = sector;
        await LoadAsync();
    }

    private async Task OnShiftAsync(int? shift)
    {
        if (shift is { } s && !OwnShift(s))
        {
            var (from, to) = _period.Range(Now);
            _teamNote = to - from <= TimeSpan.FromDays(1)
                ? Plant.ForeignShiftMessage(Actor, from, s)
                : $"Ce poste ne concerne pas votre équipe : {Actor.Team} n'a pas tenu le poste {Shifts.Label(s)} sur cette période.";
            return;
        }
        _teamNote = null;
        _shift = Ui.PackagingShift = shift;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Session.Can(Modules.Conditionnement, AppAction.Voir))
            return;
        _snap = null;
        var (from, to) = _period.Range(Now);
        await Run(async () => _snap = await Queries.LoadAsync(Actor, View, from, to, _sector, _shift));
    }
}
