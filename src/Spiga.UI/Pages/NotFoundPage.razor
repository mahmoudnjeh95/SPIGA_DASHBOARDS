@page "/{*Path:nonfile}"

@* Any address that matches no screen. Being a real route, the web host serves
   the application for it (an unmatched address would otherwise get an empty
   404 from the server, a blank page) and the user lands in the frame. *@
<div class="card" style="max-width:640px">
    <h2>Page introuvable</h2>
    <p>Cette adresse ne correspond à aucun écran. <a href="">Retour à l'accueil</a></p>
</div>

@code {
    [Parameter] public string? Path { get; set; }
}
