@* The frame of every screen: navigation rail (only what the role may see),
   context bar (where you are, which team is on shift, your account). *@
@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Nav
@inject PlantData Plant
@inject IDesktopBridge Desktop
@inject UiState Ui

<ActivityZone Class="@(RailOnly ? "app rail-only" : "app")">
    <aside class="rail">
        <Brand />
        <nav class="navwrap" aria-label="Modules">
            @foreach (var group in VisibleGroups())
            {
                @if (group.Key != null)
                {
                    <div class="grp">@group.Key</div>
                }
                @foreach (var item in group)
                {
                    <NavLink class="nav" ActiveClass="active" href="@item.Route" Match="@(item.Route == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <span class="nav-ic">@Icons.Svg(item.Key)</span>
                        <span>@item.Label</span>
                        @if (!item.Ready)
                        {
                            <span class="soon" title="Écran prévu dans une prochaine version">à venir</span>
                        }
                    </NavLink>
                }
            }
            @if (UpcomingCount() > 0)
            {
                <button type="button" class="nav nav-more" @onclick="() => Ui.ShowUpcoming = !Ui.ShowUpcoming"
                        title="Écrans prévus dans une prochaine version">
                    <span class="nav-ic">@Icons.Svg(Ui.ShowUpcoming ? "less" : "more")</span>
                    <span>@(Ui.ShowUpcoming ? "Masquer les écrans à venir" : $"Écrans à venir ({UpcomingCount()})")</span>
                </button>
            }
        </nav>
        <div class="me">
            <b>@Session.Actor?.DisplayName</b>
            <small>@Session.Actor?.RoleNames</small>
            <small>Périmètre : @Session.Actor?.ScopeSummary</small>
            @if (RailOnly)
            {
                @* The page beside the menu replaces the top bar: the shift shows here. *@
                <small class="me-shift"><span class="dot"></span>@_shift</small>
                <span class="me-links">
                    <a class="link" href="compte">Mon compte</a>
                    <button type="button" class="link" @onclick="Session.SignOutAsync">Se déconnecter</button>
                </span>
            }
        </div>
    </aside>
    <div class="main">
        <header class="ctx">
            <span class="crumb">@((MarkupString)Crumb())</span>
            <span class="pill" title="Équipe en poste selon le roulement"><span class="dot"></span>@_shift</span>
            <span class="sp"></span>
            @if (Desktop.IsAvailable && Session.Actor?.CanEverywhere(Perm.EcranTv) == true)
            {
                <button type="button" class="bar acc" @onclick="() => Desktop.OpenTvScreen()">@Icons.Svg("tv")Écran TV</button>
            }
            <button type="button" class="bar" @onclick="Session.ToggleThemeAsync">@Icons.Svg(Session.Theme == "dark" ? "sun" : "moon")@(Session.Theme == "dark" ? "Mode clair" : "Mode sombre")</button>
            <a class="bar" href="compte">@Icons.Svg("user")Mon compte</a>
            <button type="button" class="bar" @onclick="Session.SignOutAsync">@Icons.Svg("logout")Se déconnecter</button>
        </header>
        <main class="view">
            @Body
        </main>
    </div>
</ActivityZone>

@code {
    private string _shift = "";

    // The last Razor screen, where "Fermer" on a WPF page comes back to.
    private string _lastWebRoute = "";

    // Rights are read again this often even when the user stays on one
    // screen (a dashboard left open on a PC): a role, platform or account
    // changed by an administrator applies within this time.
    private static readonly TimeSpan RightsRecheck = TimeSpan.FromSeconds(60);
    private Timer? _rightsTimer;
    private bool _recheckingRights;

    protected override void OnInitialized()
    {
        _rightsTimer = new Timer(_ => _ = InvokeAsync(RecheckRightsAsync), null, RightsRecheck, RightsRecheck);
        Nav.LocationChanged += OnLocationChanged;
        Session.Changed += OnSessionChanged;
        Desktop.UserActivity += Session.Touch;
        Desktop.NativeClosed += OnNativeClosed;
        Desktop.NavigateRequested += OnNavigateRequested;
        if (CurrentNative == null)
            _lastWebRoute = CurrentPath;
        UpdateShift();
    }

    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');

    // A WPF page (dashboard, arrêts, planification, paramètres): in the
    // Windows application the window shows the rail here and the page beside it.
    private NativePage? CurrentNative
        => Desktop.IsAvailable && NativePages.FromRoute(CurrentPath) is { } page && NativePages.IsAllowed(Session.Actor, page)
            ? page
            : null;

    private bool RailOnly => CurrentNative != null;

    protected override void OnAfterRender(bool firstRender)
    {
        Desktop.ApplyTheme(Session.Theme == "dark");
        var page = CurrentNative;
        Desktop.ShowNative(page, page is { } p && Session.Actor is { } actor ? NativePages.Access(actor, p) : NativeAccess.None);
    }

    private void OnNativeClosed(NativePage page)
        => _ = InvokeAsync(() =>
        {
            if (CurrentNative == page)
                Nav.NavigateTo(_lastWebRoute);
        });

    private void OnNavigateRequested(NativePage page)
        => _ = InvokeAsync(() =>
        {
            if (NativePages.IsAllowed(Session.Actor, page))
                Nav.NavigateTo(NativePages.Route(page));
        });

    private IEnumerable<NavItem> Allowed()
        => ModuleCatalog.Navigation.Where(n => Session.Can(n.RequiredPermission) && (!n.DesktopOnly || Desktop.IsAvailable)
                                               && (NativePages.FromRoute(n.Route) is not { } page || NativePages.IsAllowed(Session.Actor, page))
                                               && (n.Module != Modules.Audit || Session.Actor?.CanUnrestricted(Perm.View(Modules.Audit)) == true));

    // The screen being shown stays in the menu even when it is "à venir".
    private IEnumerable<IGrouping<string?, NavItem>> VisibleGroups()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        return Allowed().Where(n => n.Ready || Ui.ShowUpcoming || n.Route == path).GroupBy(n => n.Group);
    }

    private int UpcomingCount() => Allowed().Count(n => !n.Ready);

    private string Crumb()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        if (path == "compte")
            return "Usine › <b>Mon compte</b>";
        var item = ModuleCatalog.Navigation.FirstOrDefault(n => n.Route == path);
        if (item == null)
            return "Usine";
        var label = System.Net.WebUtility.HtmlEncode(item.Label);
        return item.Group == null ? $"Usine › <b>{label}</b>" : $"Usine › {System.Net.WebUtility.HtmlEncode(item.Group)} › <b>{label}</b>";
    }

    private void UpdateShift()
    {
        try
        {
            var (team, shift) = Plant.CurrentShift();
            _shift = $"{team} - Poste {Shifts.Label(shift)}";
            if (Session.Actor?.Team is { } mine && !Session.Actor.IsOwnTeam(team))
                _shift += $" · votre équipe ({mine}) hors poste";
        }
        catch (Exception)
        {
            _shift = "Roulement indisponible";
        }
    }

    // Each navigation re-reads the account: a right removed by an
    // administrator disappears without signing out.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (NativePages.FromRoute(CurrentPath) == null)
            _lastWebRoute = CurrentPath;
        UpdateShift();
        await Session.RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task RecheckRightsAsync()
    {
        if (_recheckingRights)
            return;
        _recheckingRights = true;
        try
        {
            // Changed rights re-render the shell, which hands them to the
            // Windows pages (ShowNative); a disabled account is signed out.
            await Session.RefreshAsync();
        }
        catch (Exception ex)
        {
            SpigaDashboards.App.Services.AppLogger.Log("Relecture périodique des droits impossible : " + ex.Message);
        }
        finally
        {
            _recheckingRights = false;
        }
    }

    public void Dispose()
    {
        _rightsTimer?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
        Session.Changed -= OnSessionChanged;
        Desktop.UserActivity -= Session.Touch;
        Desktop.NativeClosed -= OnNativeClosed;
        Desktop.NavigateRequested -= OnNavigateRequested;
    }
}
