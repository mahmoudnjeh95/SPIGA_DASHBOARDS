@* A hall screen of the desktop application, without sign-in (Routes,
   Screen = "kiosk" or "tv"; ScreenAccount):
   - tv: the dashboard slides alone, full screen (the TV window);
   - kiosk: the same, with Historique and Arrêts of the whole plant, the
     TV window, and « Se connecter » for anything that writes (note,
     Paramètres...): the full application under one's own account, back to
     the screen at sign-out or after the inactivity time. *@
@using Spiga.UI.Pages
@inject IJSRuntime JS
@inject IDesktopBridge Desktop
@inject UserSession Session

<main class="tv-view view @(Kiosk ? "kiosk" : "tv-fit")">
    @if (Kiosk)
    {
        <nav class="kiosk-bar" aria-label="Écran du poste">
            <Brand />
            <span class="sp"></span>
            <button type="button" class="bar small @(_view == View.Dashboard ? "acc" : "")" @onclick="() => _view = View.Dashboard">@Icons.Svg("tableau")Tableau de bord</button>
            <button type="button" class="bar small @(_view == View.History ? "acc" : "")" @onclick="() => _view = View.History">@Icons.Svg("clock")Historique</button>
            @if (NativePages.IsAllowed(Session.Actor, NativePage.Stops))
            {
                <button type="button" class="bar small @(_view == View.Stops ? "acc" : "")" @onclick="() => _view = View.Stops">@Icons.Svg("arrets")Arrêts</button>
            }
            @if (Desktop.IsAvailable)
            {
                <button type="button" class="bar small" @onclick="() => Desktop.OpenTvScreen()">@Icons.Svg("tv")Écran TV</button>
            }
            else if (!Session.IsScreen && OnTv.HasDelegate)
            {
                <button type="button" class="bar small" @onclick="OnTv">@Icons.Svg("tv")Écran TV</button>
            }
            @if (Session.IsScreen)
            {
                <button type="button" class="bar small" @onclick="OnSignIn">@Icons.Svg("user")Se connecter</button>
            }
            else
            {
                @if (OnApp.HasDelegate)
                {
                    <button type="button" class="bar small" @onclick="OnApp">@Icons.Svg("vue-ensemble")Application complète</button>
                }
                <button type="button" class="bar small" @onclick="Session.SignOutAsync">@Icons.Svg("logout")Se déconnecter</button>
            }
        </nav>
    }
    @switch (_view)
    {
        case View.History:
            <ProductionHistory />
            break;
        case View.Stops:
            <Stops />
            break;
        default:
            <ClassicDashboard Tv="true" InKiosk="true" OnLeave="OnLeave" LeaveLabel="@LeaveLabel" />
            break;
    }
</main>

@code {
    private enum View { Dashboard, History, Stops }

    [Parameter] public bool Kiosk { get; set; }
    [Parameter] public EventCallback OnSignIn { get; set; }

    // Web, signed in (SPIGA Dashboard chosen after sign-in): to the whole
    // application, or to the TV screen.
    [Parameter] public EventCallback OnApp { get; set; }
    [Parameter] public EventCallback OnTv { get; set; }

    // SPIGA TV signed in: the button of its bar (back to the choice, or sign-out).
    [Parameter] public EventCallback OnLeave { get; set; }
    [Parameter] public string LeaveLabel { get; set; } = "Quitter";

    private View _view = View.Dashboard;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            await JS.InvokeVoidAsync("spigaTv.enable");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
