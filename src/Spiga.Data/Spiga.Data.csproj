<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application database of SPIGA Suivi Production (accounts, roles,
       audit trail, entries, settings). Separate from the production
       database "stats", which stays read only (cahier des charges §16).
       SQLite on a dev PC, SQL Server on site. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spiga.Core\Spiga.Core.csproj" />
  </ItemGroup>

</Project>
