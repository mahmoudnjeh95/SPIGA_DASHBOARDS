<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Spiga.UI/spiga.css" />
    <link rel="icon" type="image/png" href="_content/Spiga.UI/img/cds-icon.png" />
    <title>SPIGA Suivi Production</title>
</head>
<body>
    <div id="boot" class="spiga-root boot" aria-hidden="true">
        <div class="boot-in">
            <img class="boot-logo" src="_content/Spiga.UI/img/cds-logo.png" alt="" />
            <svg class="boot-strand" viewBox="0 0 220 24"><path class="pp-track" d="M12,12 C32,4 52,20 72,12 S112,4 132,12 S172,20 208,12" /><path class="pp-strand" d="M12,12 C32,4 52,20 72,12 S112,4 132,12 S172,20 208,12" /></svg>
            <span>Démarrage de SPIGA Suivi Production…</span>
        </div>
    </div>
    <Routes @rendermode="Interactive" Workstation="@HttpContext?.Connection.RemoteIpAddress?.ToString()" Screen="@DevScreen" />
    <script src="_content/Spiga.UI/lib/echarts/echarts.min.js"></script>
    <script src="_content/Spiga.UI/spiga.js"></script>
    <script src="_content/Spiga.UI/spiga-chart.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // No prerendering: the session (sign-in) lives in the interactive circuit.
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [Inject] private IWebHostEnvironment Env { get; set; } = default!;

    // Development only: ?ecran=kiosk or ?ecran=tv shows the screen modes of
    // the desktop application (no sign-in) to test them in a browser. Never
    // on the plant server: a browser always signs in there.
    private string? DevScreen => Env.IsDevelopment() && HttpContext?.Request.Query["ecran"].ToString() is "kiosk" or "tv"
        ? HttpContext!.Request.Query["ecran"].ToString()
        : null;
}
