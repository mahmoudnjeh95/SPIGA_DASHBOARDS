<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>SpigaDashboards-Setup</OutputName>
    <!-- The published payload is win-x64 self-contained, so every harvested
         component must default to 64-bit too (otherwise ICE80 flags them as
         32-bit components sitting inside the 64-bit Program Files folder). -->
    <Platform>x64</Platform>
    <DefineConstants>PublishDir=$(MSBuildProjectDirectory)\..\publish\app;DevDbFile=$(MSBuildProjectDirectory)\..\database\spiga_dashboards.db</DefineConstants>
  </PropertyGroup>

</Project>
