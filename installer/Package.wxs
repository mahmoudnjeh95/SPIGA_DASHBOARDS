<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="SPIGA Suivi Production"
           Manufacturer="L2I - Leader de l'Innovation Industrielle"
           Version="$(var.ProductVersion)"
           UpgradeCode="D28AD530-83ED-4FCE-BE8D-E8AAE001E645"
           InstallerVersion="500"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="SPIGA Suivi Production - suivi de production et tableaux de bord" />

    <MajorUpgrade DowngradeErrorMessage="Une version plus recente de SPIGA Suivi Production est deja installee." />

    <!-- Every PC gets the three shortcuts: SPIGA Suivi Production (argument app:
         sign-in), SPIGA Dashboard (argument kiosk: the dashboard without
         sign-in) and SPIGA TV (argument tv: the slides alone, full screen). KIOSK=1 (dashboard) or
         KIOSK=2 (TV) makes the PC a screen: started without an argument
         (startup task, restart after errors) it opens that one (StartMode.cs
         reads the registry value below). Remembered: an upgrade without KIOSK
         keeps it. To make it an ordinary PC again, uninstall, then install
         without KIOSK. -->
    <Property Id="KIOSK" Secure="yes">
      <RegistrySearch Id="KioskModeSearch" Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="KioskMode" Type="raw" />
    </Property>
    <SetProperty Id="KIOSK" Action="SetKioskDashboard" Value="1" After="AppSearch" Condition='KIOSK = "#1"' Sequence="both" />
    <SetProperty Id="KIOSK" Action="SetKioskTv" Value="2" After="AppSearch" Condition='KIOSK = "#2"' Sequence="both" />

    <!-- Always overwrite the installed files, whatever their version. Without
         it, an upgrade built with an older .NET patch than the installed one
         (e.g. 8.0.31 over 8.0.32, built on another PC) keeps the "newer"
         runtime files, then removing the old version deletes them: the app is
         left without hostfxr.dll and asks for the .NET Desktop Runtime. Safe
         here: every file is private to the per-user install folder. -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Logo shown in "Apps & features" / Add-Remove Programs. Shortcuts take
         theirs from the exe, which embeds the same .ico via ApplicationIcon. -->
    <Icon Id="SpigaIcon" SourceFile="..\src\SpigaDashboards.App\Assets\cds.ico" />
    <Property Id="ARPPRODUCTICON" Value="SpigaIcon" />

    <!-- Per-user install under %LocalAppData%\Programs: no administrator
         password (UAC prompt) is needed to install, update or open the app
         on the production PCs. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SPIGA Dashboards" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="SPIGA Suivi Production" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- The install folder and the exe keep their names: startup / watchdog
         tasks set up on the PCs point to them. -->
    <Feature Id="Main" Title="SPIGA Suivi Production" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="DevDatabase" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartMenuKioskShortcut" />
      <ComponentRef Id="StartMenuTvShortcut" />
      <ComponentRef Id="StartMenuUpdateDatabaseShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="DesktopKioskShortcut" />
      <ComponentRef Id="DesktopTvShortcut" />
      <ComponentRef Id="KioskModeFlag" />
    </Feature>

  </Package>

  <!-- The full self-contained publish output (app + .NET runtime + all native
       dependencies): output of "dotnet publish -c Release -r win-x64 (self
       contained)", harvested recursively so nothing has to be listed by hand. -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <!-- Dev seed database, placed directly beside the exe: DatabasePathResolver
       checks AppContext.BaseDirectory\spiga_dashboards.db first, so the app
       has real sample data immediately after install with no extra setup. -->
  <Fragment>
    <ComponentGroup Id="DevDatabase" Directory="INSTALLFOLDER">
      <Component Id="DevDbComponent" Guid="6A6F7F1E-9B7A-4C3D-8E7A-2B5B9C6D1A3F">
        <File Id="DevDbFile" Source="$(var.DevDbFile)" Name="spiga_dashboards.db" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Start menu: the three ways to open the application. -->
  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppProgramMenuFolder" Guid="1F2E3D4C-5B6A-4978-8877-665544332211">
      <Shortcut Id="StartMenuShortcutFile"
                Name="SPIGA Suivi Production"
                Description="Suivi de production, saisies et tableaux de bord (connexion)"
                Target="[INSTALLFOLDER]SpigaDashboards.App.exe"
                Arguments="--app"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveStartMenuFolder" Directory="AppProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuKioskShortcut" Directory="AppProgramMenuFolder" Guid="5B0C3E71-2D4A-4F86-9C1B-7E3F8A2D6C40">
      <Shortcut Id="StartMenuKioskShortcutFile"
                Name="SPIGA Dashboard"
                Description="Tableau de bord sans connexion, avec Historique et Arrêts (écran de hall)"
                Target="[INSTALLFOLDER]SpigaDashboards.App.exe"
                Arguments="--kiosk"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="StartMenuKioskShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuTvShortcut" Directory="AppProgramMenuFolder" Guid="9D7E2B41-3A6C-4F15-8B2E-5C4D7A9E1F06">
      <Shortcut Id="StartMenuTvShortcutFile"
                Name="SPIGA TV"
                Description="Écran TV : les diapositives seules, plein écran, sans connexion"
                Target="[INSTALLFOLDER]SpigaDashboards.App.exe"
                Arguments="--tv"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="StartMenuTvShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- For IT: applies a new version's table changes to the application
       database with an administrator login (the PCs' login only reads and
       writes, see spiga_suivi.sql). -->
  <Fragment>
    <Component Id="StartMenuUpdateDatabaseShortcut" Directory="AppProgramMenuFolder" Guid="6133B060-7E25-4981-A740-B7B46FE2802A">
      <Shortcut Id="StartMenuUpdateDatabaseShortcutFile"
                Name="Mettre à jour la base SPIGA (informatique)"
                Description="Changements de tables d'une nouvelle version, avec un compte administrateur SQL"
                Target="[INSTALLFOLDER]SpigaDashboards.App.exe"
                Arguments="--update-database"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="StartMenuUpdateDatabaseShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- Desktop: the same three shortcuts. -->
  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="2A3B4C5D-6E7F-4890-9911-223344556677">
      <Shortcut Id="DesktopShortcutFile"
                Name="SPIGA Suivi Production"
                Description="Suivi de production, saisies et tableaux de bord (connexion)"
                Target="[INSTALLFOLDER]SpigaDashboards.App.exe"
                Arguments="--app"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopKioskShortcut" Directory="DesktopFolder" Guid="8E4D1A2B-6C3F-4B7E-A590-1D2C3B4A5F68">
      <Shortcut Id="DesktopKioskShortcutFile"
                Name="SPIGA Dashboard"
                Description="Tableau de bord sans connexion, avec Historique et Arrêts (écran de hall)"
                Target="[INSTALLFOLDER]SpigaDashboards.App.exe"
                Arguments="--kiosk"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="DesktopKioskShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopTvShortcut" Directory="DesktopFolder" Guid="4F8A1C63-7B2E-4D90-A3C5-6E1B9D2F7A84">
      <Shortcut Id="DesktopTvShortcutFile"
                Name="SPIGA TV"
                Description="Écran TV : les diapositives seules, plein écran, sans connexion"
                Target="[INSTALLFOLDER]SpigaDashboards.App.exe"
                Arguments="--tv"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="DesktopTvShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- Read by the app at start-up (StartMode.cs): this PC is a screen (1 dashboard, 2 TV). -->
  <Fragment>
    <Component Id="KioskModeFlag" Directory="INSTALLFOLDER" Guid="3C7A9E15-4B2D-4E8F-B061-9A5D2C7E1F34" Condition="KIOSK = 1 OR KIOSK = 2">
      <RegistryValue Root="HKCU" Key="Software\L2I\SpigaDashboards" Name="KioskMode" Type="integer" Value="[KIOSK]" KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
