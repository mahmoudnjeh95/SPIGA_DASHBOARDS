<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prepares the licence dongles. Not shipped with the dashboard: it needs the
       private key, which stays on the PC that makes the dongles.
       One portable exe: see README.md for the publish command. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\src\SpigaDashboards.App\Assets\cds.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Same licence code as the dashboard, so a dongle accepted here works there. -->
  <ItemGroup>
    <Compile Include="..\..\src\SpigaDashboards.App\Licensing\*.cs" Link="Licensing\%(Filename)%(Extension)" />
    <Resource Include="..\..\src\SpigaDashboards.App\Assets\cds-logo.png" Link="cds-logo.png" />
    <Resource Include="..\..\src\SpigaDashboards.App\Assets\cds-icon.png" Link="cds-icon.png" />
  </ItemGroup>

</Project>
