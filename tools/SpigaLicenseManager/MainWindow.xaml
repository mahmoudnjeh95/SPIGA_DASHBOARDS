<Window x:Class="SpigaLicenseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPIGA Licence Manager" Icon="/cds-icon.png"
        Width="820" Height="640" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontSize="14" Background="#F0F2F5">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6472"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="/cds-logo.png" Height="42"/>
            <TextBlock Text="Préparation des clés USB de licence" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#1B1F26"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Clé privée">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="KeysDirText" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="KeyStatusText" Margin="0,4,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Changer de dossier…" VerticalAlignment="Center" Click="ChangeKeysDir_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Clé USB">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Clé" Style="{StaticResource Label}"/>
                <ComboBox x:Name="DriveCombo" Grid.Column="1" DisplayMemberPath="Display" Padding="6,5"
                          SelectionChanged="DriveCombo_SelectionChanged"/>

                <TextBlock Grid.Row="1" Text="État" Style="{StaticResource Label}" Margin="0,10,12,0"/>
                <TextBlock x:Name="DriveStateText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Text="Client" Style="{StaticResource Label}" Margin="0,10,12,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox x:Name="ClientBox" Width="300" Padding="4,4" Text="SPIGA"/>
                    <TextBlock Text="ID" Style="{StaticResource Label}" Margin="20,0,12,0"/>
                    <TextBox x:Name="IdBox" Width="130" Padding="4,4"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,2">
                    <Button x:Name="IssueButton" Content="Préparer la clé" FontWeight="SemiBold" Click="Issue_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <!-- The default template greys the background; white text would vanish on it. -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#8A93A0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="VerifyButton" Content="Vérifier" Margin="10,0,0,0" Click="Verify_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border x:Name="ResultBorder" Grid.Row="3" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ResultText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <GroupBox Grid.Row="4" Header="Clés émises" Margin="0">
            <ListView x:Name="EntriesList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="100" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Client" Width="150" DisplayMemberBinding="{Binding Client}"/>
                        <GridViewColumn Header="Émise le" Width="100" DisplayMemberBinding="{Binding Issued}"/>
                        <GridViewColumn Header="N° de série" Width="190" DisplayMemberBinding="{Binding Serial}"/>
                        <GridViewColumn Header="Modèle" Width="190" DisplayMemberBinding="{Binding Model}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</Window>
